   "units": [
    {
     "id": "u1",
     "title": "Big O Analysis",
     "tip": "Big O measures how an algorithm's performance scales with input size. O(1) is constant, O(n) grows linearly, O(n^2) quadratically. Lower is faster. Understanding Big O helps you choose efficient algorithms.",
     "lessons": [
      {
       "id": "u1l1",
       "title": "Time and Space Complexity",
       "exercises": [
        {
         "type": "mathChoice",
         "question": "What does Big O notation measure?",
         "answer": "How an algorithm's performance scales as input grows",
         "explain": "Big O ignores constants and focuses on the dominant term. It predicts how performance changes with larger inputs.",
         "choices": [
          "The exact time in seconds",
          "Memory used in bytes",
          "The number of lines of code",
          "How an algorithm's performance scales as input grows"
         ],
         "id": "dsa_u1l1_0"
        },
        {
         "type": "mathChoice",
         "question": "What does O(1) complexity mean?",
         "answer": "Constant time, independent of input size",
         "explain": "O(1) means the time is the same no matter how large the input is. Array access by index is O(1).",
         "choices": [
          "Logarithmic time",
          "One operation only",
          "Constant time, independent of input size",
          "Linear time"
         ],
         "id": "dsa_u1l1_1"
        },
        {
         "type": "mathChoice",
         "question": "What does O(n) complexity mean?",
         "answer": "Time grows proportionally with input size",
         "explain": "O(n) is linear. Doubling the input size doubles the time. Linear search is O(n).",
         "choices": [
          "Time is zero",
          "Time grows exponentially",
          "Time is constant",
          "Time grows proportionally with input size"
         ],
         "id": "dsa_u1l1_2"
        },
        {
         "type": "mathChoice",
         "question": "What does O(log n) complexity mean?",
         "answer": "Time grows logarithmically with input size",
         "explain": "O(log n) is very efficient. Doubling input size increases time only slightly. Binary search is O(log n).",
         "choices": [
          "Time is linear",
          "Time grows quadratically",
          "Time is constant",
          "Time grows logarithmically with input size"
         ],
         "id": "dsa_u1l1_3"
        },
        {
         "type": "mathChoice",
         "question": "What does O(n^2) complexity mean?",
         "answer": "Time grows quadratically with input size",
         "explain": "O(n^2) means nested loops. Doubling input size multiplies time by 4. Bubble sort is O(n^2) in worst case.",
         "choices": [
          "Time grows logarithmically",
          "Time is constant",
          "Time is linear",
          "Time grows quadratically with input size"
         ],
         "id": "dsa_u1l1_4"
        }
       ]
      },
      {
       "id": "u1l2",
       "title": "Comparing Complexities",
       "exercises": [
        {
         "type": "mathChoice",
         "question": "Which complexity is best?",
         "answer": "O(1), then O(log n), then O(n)",
         "explain": "Faster is better. O(1) is constant and fastest. O(log n) is very fast. O(n) is linear. O(n^2) is slow.",
         "choices": [
          "They are all equal",
          "O(n^2)",
          "O(n)",
          "O(1), then O(log n), then O(n)"
         ],
         "id": "dsa_u1l2_0"
        },
        {
         "type": "mathChoice",
         "question": "What is O(n log n) complexity?",
         "answer": "Time grows as n times log n, between linear and quadratic",
         "explain": "O(n log n) is efficient and common in sorting. Merge sort and quicksort (average case) are O(n log n).",
         "choices": [
          "Time grows as n times log n, between linear and quadratic",
          "Time is constant",
          "Time is exponential",
          "Time is linear"
         ],
         "id": "dsa_u1l2_1"
        },
        {
         "type": "mathChoice",
         "question": "For an input of size 1000, which is faster: O(n^2) or O(n log n)?",
         "answer": "O(n log n) is much faster",
         "explain": "O(n^2) = 1,000,000 operations. O(n log n) ≈ 10,000 operations. Logarithmic factors matter hugely.",
         "choices": [
          "O(n^2)",
          "O(n log n) is much faster",
          "They are the same",
          "Depends on the constant factors"
         ],
         "id": "dsa_u1l2_2"
        },
        {
         "type": "mathChoice",
         "question": "What is the difference between average and worst case?",
         "answer": "Average case is typical performance; worst case is the slowest possible",
         "explain": "Quicksort is O(n log n) average, O(n^2) worst case. Stating both cases is more accurate than just one.",
         "choices": [
          "There is no difference",
          "Only worst case matters",
          "Average case is typical performance; worst case is the slowest possible",
          "Average case is always slower"
         ],
         "id": "dsa_u1l2_3"
        },
        {
         "type": "mathChoice",
         "question": "What is space complexity?",
         "answer": "How much extra memory an algorithm uses relative to input size",
         "explain": "Space complexity measures auxiliary memory, not the input itself. Merge sort is O(n) space; bubble sort is O(1).",
         "choices": [
          "How much extra memory an algorithm uses relative to input size",
          "The number of variables",
          "The size of the input",
          "The runtime in seconds"
         ],
         "id": "dsa_u1l2_4"
        }
       ]
      }
     ]
    }
