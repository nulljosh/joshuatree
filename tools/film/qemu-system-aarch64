#!/usr/bin/env python3
"""Films any ARM check that draws a desktop, with no change to the check (13.21.0). Put this folder first on PATH and set
JT_FILM_DIR; every QEMU boot the check starts with a ramfb screen is recorded to $JT_FILM_DIR/boot-N.mp4 (QMP screendump
on a second, private QMP socket, about 10 fps, wall clock timed), and the check runs exactly as it would otherwise.
Boots without ramfb, or with JT_FILM_DIR unset, go straight to the real QEMU.

This process becomes QEMU (exec), so a check that kills "QEMU" kills the real one. The recorder runs beside it in its own
process and finishes the film when QEMU's socket closes.

  PATH=tools/film:$PATH JT_FILM_DIR=/tmp/film python3 tools/checks/arm64-update-check.py
"""
import glob, json, os, shutil, socket, subprocess, sys, time


def record(sock, base):
    for _ in range(400):   # QEMU opens the socket a moment after exec
        try: s = socket.socket(socket.AF_UNIX); s.connect(sock); break
        except OSError: time.sleep(0.05)
    else: return
    f = s.makefile("rw")
    def cmd(c, **a):
        f.write(json.dumps({"execute": c, "arguments": a}) + "\n"); f.flush()
        while True:
            line = f.readline()
            if not line: raise EOFError
            r = json.loads(line)
            if "return" in r or "error" in r: return r
    enc = size = None; k = 0
    try:
        f.readline(); cmd("qmp_capabilities")
        while True:
            t0 = time.monotonic(); ppm = "%s.%d.ppm" % (base, k % 3); k += 1
            if "error" in cmd("screendump", filename=ppm): time.sleep(0.2); continue
            _, w_h, _, data = open(ppm, "rb").read().split(b"\n", 3)
            w, h = map(int, w_h.split())
            if enc is not None and (w, h) != size and w >= 320:   # the kernel set its own mode: start over at the new size
                enc.stdin.close(); enc.wait(); enc = None
            if enc is None:
                if w < 320: time.sleep(0.2); continue   # ramfb not set up yet
                size = (w, h)
                enc = subprocess.Popen(["ffmpeg", "-y", "-loglevel", "error", "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", "%dx%d" % size,
                                        "-use_wallclock_as_timestamps", "1", "-i", "-", "-vf", "fps=15", "-c:v", "libx264", "-preset", "fast",
                                        "-crf", "26", "-pix_fmt", "yuv420p", "-movflags", "+faststart", "-an", base + ".mp4"], stdin=subprocess.PIPE)
            if len(data) == w * h * 3: enc.stdin.write(data)
            time.sleep(max(0, 0.1 - (time.monotonic() - t0)))
    except (EOFError, OSError, ValueError):
        pass   # QEMU is gone
    finally:
        if enc: enc.stdin.close(); enc.wait()
        for p in glob.glob(base + ".*.ppm"): os.remove(p)
        try: os.remove(sock)
        except OSError: pass


if len(sys.argv) == 4 and sys.argv[1] == "--record": record(sys.argv[2], sys.argv[3]); sys.exit(0)

here = os.path.dirname(os.path.abspath(__file__))
path = os.pathsep.join(p for p in os.environ.get("PATH", "").split(os.pathsep) if os.path.abspath(p or ".") != here)
real = shutil.which("qemu-system-aarch64", path=path) or sys.exit("film: no real qemu-system-aarch64 on PATH")
out_dir = os.environ.get("JT_FILM_DIR")
if not out_dir or "ramfb" not in " ".join(sys.argv[1:]): os.execv(real, [real] + sys.argv[1:])

os.makedirs(out_dir, exist_ok=True)
base = os.path.join(out_dir, "boot-%d" % len(glob.glob(os.path.join(out_dir, "boot-*.mp4"))))
while os.path.exists(base + ".mp4") or glob.glob(base + ".*.ppm"): base += "b"
sock = "/tmp/jtfilm-%d.qmp" % os.getpid()   # short: macOS caps a Unix socket path at 104 bytes
subprocess.Popen([sys.executable, os.path.abspath(__file__), "--record", sock, base], start_new_session=True,
                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
os.execv(real, [real] + sys.argv[1:] + ["-qmp", "unix:%s,server,nowait" % sock])
