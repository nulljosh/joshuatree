#!/bin/bash
# Real launcher, not a decoration: this is what gives the running kernel
# its own name and icon in the real macOS Dock instead of showing up as
# generic "qemu-system-i386". `open JoshuaTree.app` (or double-clicking it
# in Finder) launches this script, which execs the actual, real QEMU
# invocation kept in sync with `make run`'s own -rtc flag (see the
# Makefile, the source of truth for how this kernel actually boots).
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
# v35 (0.35.0): rebuilds before every launch, so a login/Dock launch
# always reflects the latest edit instead of whatever kernel.elf happened
# to be sitting there. -net added so the networking commands (netscan,
# ifconfig, web, serveapp) actually have a card to find, same flags
# Makefile's own `run` target uses.
cd "$REPO_DIR" && /usr/bin/make -s kernel.elf
"$REPO_DIR/sync_dotfiles.sh"

# v49: always-on-top, direct request. No QEMU -display flag for this and
# no AppleScript/System Events window-level property either (see
# roadmap.md's "Window-level requests" entry for why), so this can no
# longer be a plain `exec` straight into qemu: it needs to keep running
# just long enough to launch window-float.swift's compiled helper
# alongside it, pointed at qemu's own PID. window-float itself is what
# sets the level, this is just backgrounding both and waiting.
"$REPO_DIR/menubar/build-window-float.sh"

qemu-system-i386 -kernel "$REPO_DIR/kernel.elf" -display cocoa,zoom-to-fit=on,full-screen=on -rtc base=localtime -net nic,model=rtl8139 -net user -drive file="$REPO_DIR/dotfiles.img",format=raw,if=ide,index=0 &
QEMU_PID=$!
[ -x "$REPO_DIR/menubar/window-float" ] && "$REPO_DIR/menubar/window-float" "$QEMU_PID" &
wait "$QEMU_PID"
