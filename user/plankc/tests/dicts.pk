# plankc's dicts (6.67.0): string keys in the order they arrived, get, set, in, len, for-in, printing.
struct Fn {
  name: str
  args: int
}

fn main() {
  let d = ["b": 2, "a": 1]
  d["c"] = 3
  d["b"] = 20
  d["a"] += 5
  print(d, len(d), "a" in d, "z" in d, d["b"])
  let e: [str: str] = [:]
  print(e, len(e))
  e["k"] = "v"
  print(e)
  for k in d {
    print(k, d[k])
  }
  let fns: [str: Fn] = [:]
  fns["main"] = Fn("main", 0)
  fns["add"] = Fn("add", 2)
  print(fns["add"].args, fns)
  let groups = ["odd": [1, 3], "even": [2]]
  groups["even"].append(4)
  print(groups, [e, e])
  let sq: [int: str] = [:]   # 6.79.0: int keys, and in on a list
  sq[2] = "two"
  sq[7] = "seven"
  sq[2] = "deux"
  print(sq, sq[7], 7 in sq, 8 in sq, sq.get(9, "none"), sq.get(7, "none"))
  sq.remove(2)
  print(sq.keys(), len(sq), [10: [1], 20: [2, 3]])
  print("b" in ["a", "b"], 3 in [1, 2], 2.5 in [2.5], [1] in [[1], [2]])
}
