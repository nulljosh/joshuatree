# plankc's floats (6.76.0): literals, arithmetic, ordered compares, conversions, the libm built-ins and %.15g printing.
struct Pt {
  x: float
  y: float
}

fn hyp(p: Pt) -> float {
  return sqrt(p.x * p.x + p.y * p.y)
}

fn newton(x: float) -> float {   # sqrt.pk's: its 1.41421356237309492 is where scaling and adding a half rounds wrong
  var guess = x / 2.0
  for i in 0..20 { guess = (guess + x / guess) / 2.0 }
  return guess
}

fn main() {
  print(1.5, 0.1 + 0.2, 1.0 / 3.0, 2.0 / 3.0, 100.0, 1e21, 1e15, 1e14 + 0.5, 123456789012345.0)
  let big = 1e22 * 1e22 * 1e22
  let tiny = 1e-22 * 1e-22 * 1e-22
  print(0.0001, 0.00001, 1.5e-7, 6.02e23, big, tiny, big * big * big * big * big, tiny * tiny * tiny * tiny * 2.5)
  print(-2.5, -0.0, 0.0 * -1.0, 3.0 - 3.0, 7.0 / 2.0, 1.0 / 0.0, -1.0 / 0.0, big * big * big * big * big * big * big * big * big * big * big * big * big * big * big)
  let nan = 0.0 / 0.0
  print(nan == nan, nan != nan, nan < 1.0, nan >= 1.0, 1.0 != 2.0, 2.0 <= 2.0, -0.0 == 0.0)
  print(float(7), int(7.9), int(-7.9), sqrt(2.0), floor(-2.5), ceil(-2.5), round(2.5), round(-2.5), abs(-3.25), abs(-4))
  print(min(1.5, 2.5), max(1.5, 2.5), min(0.0, -0.0), max(-0.0, 0.0), min(3, 2), max(3, 9))
  var total = 0.0
  for i in 0..10 { total += 0.1 }
  print(total, total == 1.0, "\(total)", str(2.0 / 7.0))
  let xs = [1.0, 2.5, -0.125]
  print(xs, xs[1] * 2.0, hyp(Pt(3.0, 4.0)), Pt(1.5, -2.0))
  print(newton(2.0), newton(3.0), newton(10.0))
  var v = 1.0
  var line = ""
  for i in 0..40 {
    v = v * 1.37 + 0.001
    line = line + " \(v)"
  }
  print(line)
  var w = 1.0
  line = ""
  for i in 0..14 {
    w = w / 3.3
    line = line + " \(w) \(w * 7.0)"
  }
  print(line)
}
