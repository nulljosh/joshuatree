# plankc's tuples (6.74.0): literals, parts by number, taking apart with let, as parameters, results and list items.
fn divmod(a: int, b: int) -> (int, int) {
  return (a / b, a % b)
}

fn swap(p: (str, int)) -> (int, str) {
  return (p.1, p.0)
}

fn main() {
  let (q, r) = divmod(17, 5)
  print(q, r, divmod(9, 4), divmod(9, 4).1)
  let pair = ("ada", 36)
  print(pair, pair.0, pair.1, swap(pair), swap(pair).0)
  let pairs = [("a", 1), ("b", 2)]
  for p in pairs {
    print(p.0, p.1)
  }
  let nested = ((1, 2), "x")
  print(nested, nested.0.1, [nested])
}
