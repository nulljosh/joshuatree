# plankc's lists (6.64.0): literals, index, negative index, assign, +=, append, pop, len, for-in, nested, print.
fn total(xs: [int]) -> int {
  var t = 0
  for x in xs {
    t += x
  }
  return t
}

fn squares(n: int) -> [int] {
  let out: [int] = []
  for i in 1..n + 1 {
    out.append(i * i)
  }
  return out
}

fn main() {
  let primes = [2, 3, 5, 7, 11]
  print(primes, len(primes), total(primes))
  print("first \(primes[0]), last \(primes[-1])")
  let sq = squares(6)
  sq[0] = 100
  sq[1] += 1
  print(sq, sq.pop(), sq)
  let words = ["swift", "ruby", "say \"hi\""]
  words.append("plank")
  for i, w in words {
    print(i, w, len(w))
  }
  print(words)
  let grid = [[1, 2], [3, 4]]
  grid[1].append(5)
  print(grid, grid[1][2], [true, false], len(grid))
  let empty: [str] = []
  print(empty, len(empty))
}
