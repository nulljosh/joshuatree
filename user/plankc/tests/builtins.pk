# plankc's built-ins from 6.77.0: deep ==, dict keys, values and remove, list helpers, float(s), fixed, pow, case, replace.
struct P {
  name: str
  tags: [str]
}

fn main() {
  print([1, 2] == [1, 2], [[1], [2]] != [[1], [3]], ["a": 1, "b": 2] == ["b": 2, "a": 1], ("x", [1.5]) == ("x", [1.5]))
  print(P("a", ["t"]) == P("a", ["t"]), P("a", []) == P("b", []), [0.0] == [-0.0])
  var d = ["one": 1, "two": 2, "three": 3]
  d.remove("two")
  print(d, d.keys(), d.values(), len(d))
  let xs = [3.5, -1.0, 2.25]
  print(xs.min(), xs.max(), xs.sum(), ["pear", "fig"].max(), [0.0, -0.0].min(), [-0.0, 0.0].max())
  let e: [float] = []
  print(e.min(), e.sum(), e.first())
  print(float("2.5"), float(" -0.001 "), float("1e3"), float("7"), float("0.1") + float("0.2"), float("123456.789e-3"))
  print(fixed(2.675, 2), fixed(0.125, 2), fixed(-1.5, 0), fixed(2.5, 0), fixed(3.14159, 4), fixed(1e10 / 3.0, 3), fixed(0.0, 3))
  print(pow(2.0, 10.0), pow(1.5, 3.0), pow(2.0, -2.0), pow(10.0, 0.0))
  print("Mixed Case 9!".upper(), "Mixed Case 9!".lower(), "a-b-a".replace("a", "xy"), "  lots   of  space ".split())
  var ys = [1, 2, 3]
  ys.insert(0, 0)
  ys.insert(-1, 9)
  print(ys, ys.remove_at(-1), ys, ys.reversed(), ys.index_of(2), ys.index_of(7))
  for i, c in "abc" {
    print(i, c)
  }
  var stack = [1, 2, 3]
  while let top = stack.last() {
    print(top)
    stack.pop()
  }
}
