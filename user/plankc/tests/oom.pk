# The collector gives up on a program that keeps nearly the whole heap live and only churns (6.76.3): eight collections
# in a row that each follow less than a sixteenth of the heap handed out end it with rt.pk's out-of-memory line within
# seconds, where before it collected forever. It reads rt.pk's cells, so only plankc builds it; its answer key is oom.out.
fn main() {
  var s = "x"
  for i in 0..10 { s = s + s }                      # 1 KB
  let keep: [str] = []
  let room = peek(global(18)) - peek(global(5))   # the heap rt.pk took at the start
  while len(keep) * 1056 < room / 32 * 31 {
    keep.append(s + str(len(keep)))
  }
  var n = 0
  while true {
    n += len(s + str(n))                            # garbage only: what lives never changes
  }
}
