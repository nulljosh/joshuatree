# plankc, the Plank compiler written in Plank (the true bootstrap, docs/ROADMAP.md, 8.0).
#   plankc lex FILE.pk     one token a line: line, kind, value
#   plankc parse FILE.pk   the program's tree, one top-level item a line
#   plankc [--gc=N] asm FILE.pk RT.pk [OUT.S]   aarch64 assembly for the Pi (gen.pk), with the runtime rt.pk built in, into OUT.S;
#                    --gc=N makes the program collect every N bytes
#   plankc img FILE.pk RT.pk OUT.APP   the app image itself, encoded by plankc (enc.pk), on the Pi only
import "gen.pk"
import "enc.pk"

fn main() {
  var a = args()
  var gc_every = 0   # --gc=N: the program collects every N bytes, to test the collector
  if len(a) > 0 and a[0].starts_with("--gc=") {
    gc_every = int(a[0][5..])
    a = a[1..]
  }
  if len(a) < 2 or not (a[0] == "lex" or a[0] == "parse" or a[0] == "asm" or a[0] == "img") {
    print("usage: plankc lex|parse FILE.pk, plankc asm FILE.pk RT.pk [OUT.S], or plankc img FILE.pk RT.pk OUT.APP")
    exit(2)
  }
  let src = read_file(a[1]) ?? ""
  try {
    if a[0] == "lex" {
      for t in lex(src) {
        var val = t.val
        if t.kind == "str" { val = show_string(t.val) }
        print("\(t.line) \(t.kind) \(val)")
      }
    } else if a[0] == "parse" {
      for item in parse(src).kids { print(dump(item)) }
    } else {
      if len(a) < 3 { throw "plankc asm needs rt.pk too: plankc asm FILE.pk RT.pk" }
      let seen: [str: int] = [:]
      let prog = load_program(a[1], seen)
      if uses_set(prog) {   # Plank's Set<T>, in Plank (gen.pk's set_source)
        for item in parse(set_source()).kids { prog.kids.append(item) }
      }
      let runtime = parse(read_file(a[2]) ?? "")
      var out = ""
      if a[0] == "img" {   # on the Pi only: the image is bytes, which plank.py's build of plankc cannot write
        if len(a) < 4 { throw "plankc img needs where to write: plankc img FILE.pk RT.pk OUT.APP" }
        out = image(asm_lines(prog, runtime, gc_every))
      } else {
        out = asm(prog, runtime, gc_every)
      }
      if len(a) > 3 {
        if not write_file(a[3], out) { throw "cannot write \(a[3])" }
        print("plankc: wrote \(a[3]), \(plankc_byte_len(out)) bytes")
      } else {
        print(out)
      }
    }
  } catch e {
    print("error: \(e)")
    exit(1)
  }
}

# A module's items with each top-level name made alias.name, as plank.py's qualify does: a struct's or enum's name
# wherever a type is written, a function's where it is called or named.
fn qualify(items: [N], alias: str) -> [N] {
  let fns: [str: int] = [:]
  let types: [str] = []
  for it in items {
    if it.kind == "Fn" { fns[it.kids[0].text] = 1 }
    if it.kind == "Struct" or it.kind == "Enum" { types.append(it.kids[0].text) }
  }
  let out: [N] = []
  for it in items {
    let q = qualified(it, alias, fns, types)
    if not q.kids[0].text.starts_with(alias + ".") { q.kids[0] = sv(alias + "." + q.kids[0].text) }
    out.append(q)
  }
  return out
}

fn qualified(n: N, alias: str, fns: [str: int], types: [str]) -> N {
  if n.kind == "Str" { return n }
  var text = n.text
  if n.kind == "S" and len(types) > 0 { text = with_alias(text, alias, types) }
  let kids: [N] = []
  for k in n.kids { kids.append(qualified(k, alias, fns, types)) }
  if (n.kind == "Call" or n.kind == "Name") and len(kids) > 0 and kids[0].text in fns { kids[0] = sv(alias + "." + kids[0].text) }
  return N(n.kind, n.line, text, kids)
}

# Each word of s that is one of types, and not already after a dot, as alias.word.
fn with_alias(s: str, alias: str, types: [str]) -> str {
  var out = ""
  var i = 0
  while i < len(s) {
    var j = i
    while j < len(s) and word_char(s[j]) { j += 1 }
    if j == i {
      out = out + s[i]
      i += 1
    } else {
      let w = s[i..j]
      if w in types and (i == 0 or s[i - 1] != ".") { out = out + alias + "." + w } else { out = out + w }
      i = j
    }
  }
  return out
}

# A program and everything it imports, each file once, an import's path read from the importing file's folder.
fn load_program(path: str, seen: [str: int]) -> N {
  seen[path] = 1
  let src = read_file(path) ?? ""
  if src == "" { throw "cannot read \(path)" }
  var dir = ""
  let parts = path.split("/")
  if len(parts) > 1 { dir = parts[..len(parts) - 1].join("/") + "/" }
  let out: [N] = []
  for item in parse(src).kids {
    if item.kind == "Import" {
      let next = dir + item.kids[0].text
      if item.kids[1].kind != "_" {   # import "x.pk" as m: its names become m.name (6.84.0)
        if next in seen { throw "\(item.line): \(item.kids[0].text) is already imported; use the name it has" }
        for x in qualify(load_program(next, seen).kids, item.kids[1].text) { out.append(x) }
      } else if not (next in seen) {
        for x in load_program(next, seen).kids { out.append(x) }
      }
    } else {
      out.append(item)
    }
  }
  return N("L", 0, "", out)
}
