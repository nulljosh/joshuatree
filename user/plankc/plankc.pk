# plankc, the Plank compiler written in Plank (the true bootstrap, docs/ROADMAP.md, 8.0).
#   plankc lex FILE.pk     one token a line: line, kind, value
#   plankc parse FILE.pk   the program's tree, one top-level item a line
#   plankc [--gc=N] asm FILE.pk RT.pk [OUT.S]   aarch64 assembly for the Pi (gen.pk), with the runtime rt.pk built in, into OUT.S;
#                    --gc=N makes the program collect every N bytes
#   plankc build NAME.PK   on the Pi (6.95.0): img with the card's runtime, PLANKC/RT.PK, into APPS/NAME.APP
#   plankc img FILE.pk RT.pk OUT.APP   the app image itself, encoded by plankc (enc.pk), on the Pi only; when it cannot,
#                    the reason goes to OUT with .ERR for .APP too, which the kernel reads back to Samantha (6.94.0)
import "gen.pk"
import "enc.pk"

fn main() {
  var a = args()
  var gc_every = 0   # --gc=N: the program collects every N bytes, to test the collector
  if len(a) > 0 and a[0].starts_with("--gc=") {
    gc_every = int(a[0][5..])
    a = a[1..]
  }
  var built = ""
  if len(a) == 2 and a[0] == "build" {   # 6.95.0: the app is named for its file, and the runtime is the card's
    built = app_name(a[1])
    if built == "" {
      print("plankc: an app's name is 1 to 8 of A-Z, 0-9, - and _, so \(a[1]) needs a shorter name")
      exit(2)
    }
    a = ["img", a[1], "PLANKC/RT.PK", "APPS/" + built + ".APP"]
  }
  if len(a) < 2 or not (a[0] == "lex" or a[0] == "parse" or a[0] == "asm" or a[0] == "img") {
    print("usage: plankc build NAME.PK, plankc lex|parse FILE.pk, plankc asm FILE.pk RT.pk [OUT.S], or plankc img FILE.pk RT.pk OUT.APP")
    exit(2)
  }
  let src = read_file(a[1]) ?? ""
  try {
    if a[0] == "lex" {
      for t in lex(src) {
        var val = t.val
        if t.kind == "str" { val = show_string(t.val) }
        print("\(t.line) \(t.kind) \(val)")
      }
    } else if a[0] == "parse" {
      for item in parse(src).kids { print(dump(item)) }
    } else {
      if len(a) < 3 { throw "plankc asm needs rt.pk too: plankc asm FILE.pk RT.pk" }
      let seen: [str: int] = [:]
      let prog = load_program(a[1], seen)
      if uses_set(prog) {   # Plank's Set<T>, in Plank (gen.pk's set_source)
        for item in parse(set_source()).kids { prog.kids.append(item) }
      }
      if uses_json(prog) {   # Plank's Json, in Plank (gen.pk's json_source, 6.90.0)
        for item in parse(json_source()).kids { prog.kids.append(item) }
      }
      if built != "" and read_file(a[2]) == nil { throw "no runtime at \(a[2]): tools/flash-pi.sh puts it on the card" }
      let runtime = parse(read_file(a[2]) ?? "")
      var out = ""
      if a[0] == "img" {   # on the Pi only: the image is bytes, which plank.py's build of plankc cannot write
        if len(a) < 4 { throw "plankc img needs where to write: plankc img FILE.pk RT.pk OUT.APP" }
        out = image(asm_lines(prog, runtime, gc_every))
      } else {
        out = asm(prog, runtime, gc_every)
      }
      if len(a) > 3 {
        if not write_file(a[3], out) { throw "cannot write \(a[3])" }
        print("plankc: wrote \(a[3]), \(plankc_byte_len(out)) bytes")
        if built != "" { print("plankc: run it with userrun \(built.lower()), or sudo userrun \(built.lower()) when the Pi has accounts") }
      } else {
        print(out)
      }
    }
  } catch e {
    print("error: \(e)")
    if a[0] == "img" and len(a) > 3 and a[3].ends_with(".APP") {
      write_file(a[3][..len(a[3]) - 4] + ".ERR", "\(e)\n")
    }
    exit(1)
  }
}

# A module's items with each top-level name made alias.name, as plank.py's qualify does: a struct's or enum's name
# wherever a type is written, a function's where it is called or named.
fn qualify(items: [N], alias: str) -> [N] {
  let fns: [str: int] = [:]
  let types: [str] = []
  for it in items {
    if it.kind == "Fn" { fns[it.kids[0].text] = 1 }
    if it.kind == "Struct" or it.kind == "Enum" { types.append(it.kids[0].text) }
  }
  let out: [N] = []
  for it in items {
    let q = qualified(it, alias, fns, types)
    if not q.kids[0].text.starts_with(alias + ".") { q.kids[0] = sv(alias + "." + q.kids[0].text) }
    out.append(q)
  }
  return out
}

fn qualified(n: N, alias: str, fns: [str: int], types: [str]) -> N {
  if n.kind == "Str" { return n }
  var text = n.text
  if n.kind == "S" and len(types) > 0 { text = with_alias(text, alias, types) }
  let kids: [N] = []
  for k in n.kids { kids.append(qualified(k, alias, fns, types)) }
  if (n.kind == "Call" or n.kind == "Name") and len(kids) > 0 and kids[0].text in fns { kids[0] = sv(alias + "." + kids[0].text) }
  return N(n.kind, n.line, text, kids)
}

# Each word of s that is one of types, and not already after a dot, as alias.word.
fn with_alias(s: str, alias: str, types: [str]) -> str {
  var out = ""
  var i = 0
  while i < len(s) {
    var j = i
    while j < len(s) and word_char(s[j]) { j += 1 }
    if j == i {
      out = out + s[i]
      i += 1
    } else {
      let w = s[i..j]
      if w in types and (i == 0 or s[i - 1] != ".") { out = out + alias + "." + w } else { out = out + w }
      i = j
    }
  }
  return out
}

# A program and everything it imports, each file once, an import's path read from the importing file's folder.
fn load_program(path: str, seen: [str: int]) -> N {
  seen[path] = 1
  let src = read_file(path) ?? ""
  if src == "" { throw "cannot read \(path)" }
  var dir = ""
  let parts = path.split("/")
  if len(parts) > 1 { dir = parts[..len(parts) - 1].join("/") + "/" }
  let out: [N] = []
  for item in expand_tools(parse(src).kids) {
    if item.kind == "Import" {
      let next = dir + item.kids[0].text
      if item.kids[1].kind != "_" {   # import "x.pk" as m: its names become m.name (6.84.0)
        if next in seen { throw "\(item.line): \(item.kids[0].text) is already imported; use the name it has" }
        for x in qualify(load_program(next, seen).kids, item.kids[1].text) { out.append(x) }
      } else if not (next in seen) {
        for x in load_program(next, seen).kids { out.append(x) }
      }
    } else {
      out.append(item)
    }
  }
  return N("L", 0, "", out)
}

# The app a source file makes, for plankc build: its file name less the folder and .PK, in capitals, or "" when that is
# not 1 to 8 of A-Z, 0-9, - and _ (an app's name on the card, 8.3).
fn app_name(path: str) -> str {
  var base = path
  var i = len(path) - 1
  while i >= 0 and path[i] != "/" { i -= 1 }
  base = path[i + 1..]
  if base.upper().ends_with(".PK") { base = base[..len(base) - 3] }
  base = base.upper()
  if len(base) < 1 or len(base) > 8 { return "" }
  for c in base.chars() {
    if not ((c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "-" or c == "_") { return "" }
  }
  return base
}

# tool fn (6.96.0), as plank.py's expand_tools: besides f, a function f_tool() that wraps it as an ai.Tool, its schema read
# off the signature, so the model's schema never drifts from the code. Done per file, before its names are qualified.
fn expand_tools(items: [N]) -> [N] {
  var ai = "-"
  for it in items {
    if it.kind == "Import" and (it.kids[0].text == "ai.pk" or it.kids[0].text.ends_with("/ai.pk")) {
      ai = ""
      if it.kids[1].kind != "_" { ai = it.kids[1].text }
    }
  }
  let out: [N] = []
  for f in items {
    out.append(f)
    if f.kind != "Fn" or f.kids[7].text != "true" { continue }
    if ai == "-" { throw "\(f.line): tool fn needs import \"lib/ai.pk\" (it builds an ai.Tool)" }
    if len(f.kids[4].kids) > 0 or len(f.kids[5].kids) > 0 { throw "\(f.line): a tool fn takes no defaults or type parameters" }
    let ret = f.kids[2].text
    if not (ret == "str" or ret == "int" or ret == "float" or ret == "bool") { throw "\(f.line): a tool fn returns str, int, float or bool, not \(ret)" }
    let name = f.kids[0].text
    let schema: [str] = []
    let args: [str] = []
    for prm in f.kids[1].kids {
      let n = prm.kids[0].text
      let t = prm.kids[1].text
      let get = ["str": ".str()", "int": ".int()", "float": ".num()", "bool": ".truth()"]
      if not (t in get) { throw "\(f.line): tool fn parameter \(n) is \(t); the model can pass str, int, float or bool" }
      schema.append(tool_quote(n) + ": " + tool_quote(t))
      args.append("args.get(" + tool_quote(n) + ")" + get[t])
    }
    var call = name + "(" + args.join(", ") + ")"
    if ret != "str" { call = "str(" + call + ")" }
    var p = ""
    if ai != "" { p = ai + "." }
    var doc = f.kids[8].text
    if doc == "" { doc = name }
    var sch = schema.join(", ")
    if sch == "" { sch = ":" }
    let src = "fn " + name + "_tool() -> " + p + "Tool { return " + p + "tool(" + tool_quote(name) + ", " + tool_quote(doc) + ", [" + sch + "], fn(args: Json) -> str { return " + call + " }) }"
    let aliases: [str: int] = [:]
    if ai != "" { aliases[ai] = 1 }
    for x in program(P(lex(src), 0, aliases)).kids { out.append(x) }
  }
  return out
}

fn tool_quote(s: str) -> str {
  return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
}
