# plankc's tokenizer: Plank's tokens, written in Plank. Step 1 of the true bootstrap (docs/ROADMAP.md, 8.0).
# lex(src) gives one Tok a token: its line, its kind and its value (a string's raw body, between the quotes).
# `plankc lex FILE` prints them the way plank.py's lex() sees them (tools/checks/plankc-check.py holds the two side by side).

# Plain comparisons, not a dict literal: a literal here would build a fresh dict for every name the file holds.
fn is_keyword(w: str) -> bool {
  return (w == "fn" or w == "extern" or w == "import" or w == "try" or w == "catch" or w == "throw" or w == "struct" or
    w == "enum" or w == "match" or w == "nil" or w == "let" or w == "var" or w == "if" or w == "else" or w == "while" or
    w == "for" or w == "in" or w == "return" or w == "break" or w == "continue" or w == "true" or w == "false" or
    w == "and" or w == "or" or w == "not")
}

fn is_two(op: str) -> bool {
  return (op == "+=" or op == "-=" or op == "*=" or op == "/=" or op == "%=" or op == "->" or op == "=>" or op == ".." or
    op == "==" or op == "!=" or op == "<=" or op == ">=" or op == "??" or op == "?.")
}

fn is_digit(c: str) -> bool { return c in "0123456789" }
fn is_letter(c: str) -> bool { return c in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_" }

struct Tok {
  line: int
  kind: str
  val: str
  doc: str = ""   # a name's comment lines just above it, joined; only a tool fn reads it
}

fn digits(cs: [str], i: int) -> int {
  var j = i
  while j < len(cs) and is_digit(cs[j]) { j += 1 }
  return j
}

# Where a float that starts at i ends: \d+\.\d+([eE][+-]?\d+)? or \d+[eE][+-]?\d+. i itself when it is not one.
fn float_end(cs: [str], i: int) -> int {
  var j = digits(cs, i)
  var frac = false
  if j + 1 < len(cs) and cs[j] == "." and is_digit(cs[j + 1]) {
    j = digits(cs, j + 1)
    frac = true
  }
  if j < len(cs) and (cs[j] == "e" or cs[j] == "E") {
    var k = j + 1
    if k < len(cs) and (cs[k] == "+" or cs[k] == "-") { k += 1 }
    if k < len(cs) and is_digit(cs[k]) { return digits(cs, k) }
  }
  if frac { return j }
  return i
}

# Just past the ) closing an interpolation opened before i, skipping strings inside it.
fn close_paren(cs: [str], i: int) -> int {
  var depth = 1
  var j = i
  while depth > 0 {
    if j >= len(cs) { throw "\\( in a string needs a closing )" }
    if cs[j] == "\"" {
      j = string_end(cs, j)
    } else {
      if cs[j] == "(" { depth += 1 }
      if cs[j] == ")" { depth -= 1 }
      j += 1
    }
  }
  return j
}

# Just past the closing quote of the string that opens at i.
fn string_end(cs: [str], i: int) -> int {
  var j = i + 1
  while j < len(cs) and cs[j] != "\"" {
    if cs[j] == "\\" and j + 1 < len(cs) and cs[j + 1] == "(" {
      j = close_paren(cs, j + 2)
    } else if cs[j] == "\\" {
      j += 2
    } else {
      j += 1
    }
  }
  if j >= len(cs) { throw "this string never ends, add a closing \"" }
  return j + 1
}

# A string token's value (its raw body), written back with its escapes, or <interp> when it holds \( ).
fn show_string(body: str) -> str {
  let cs = body.chars()
  var out = ""
  var i = 0
  while i < len(cs) {
    var c = cs[i]
    if c == "\\" {
      i += 1
      c = cs[i]
      if c == "(" { return "<interp>" }
      if c == "n" { c = "\\n" } else if c == "t" { c = "\\t" } else if c == "0" { c = "\\0" } else if c == "\\" { c = "\\\\" } else if c != "\"" {
        throw "unknown escape \\" + c
      }
    } else if c == "\n" {
      c = "\\n"
    } else if c == "\t" {
      c = "\\t"
    }
    out = out + c
    i += 1
  }
  return out
}

# A comment's words: the #s and the spaces around them gone.
fn comment_text(c: str) -> str {
  var i = 0
  let cs = c.chars()
  while i < len(cs) and cs[i] == "#" { i += 1 }
  return src_slice(cs, i, len(cs)).trim()
}

fn count_lines(cs: [str], a: int, b: int) -> int {
  var n = 0
  for i in a..b {
    if cs[i] == "\n" { n += 1 }
  }
  return n
}

fn lex(src: str) -> [Tok] {
  let cs = src.chars()
  let toks: [Tok] = []
  var pos = 0
  var line = 1
  var depth = 0
  var docs: [str] = []   # the comment lines just above, while this line has had no token yet
  var bare = true
  while pos < len(cs) {
    let c = cs[pos]
    if not (c == " " or c == "\t" or c == "#" or c == "\n") {
      bare = false
      if not (c in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_") { docs = [] }
    }
    if c == "\"" {
      let end = string_end(cs, pos)
      toks.append(Tok(line, "str", src_slice(cs, pos + 1, end - 1)))
      line += count_lines(cs, pos, end)
      pos = end
    } else if c == " " or c == "\t" {   # ponytail: no \r, Plank cannot spell one until chr() lands
      pos += 1
    } else if c == "#" {
      let start = pos
      while pos < len(cs) and cs[pos] != "\n" { pos += 1 }
      if bare { docs.append(comment_text(src_slice(cs, start, pos))) }
    } else if c == "\n" {
      if depth == 0 { toks.append(Tok(line, "nl", "")) }
      bare = true
      line += 1
      pos += 1
    } else if is_digit(c) {
      let f = float_end(cs, pos)
      if f > pos {
        let text = src_slice(cs, pos, f)
        let exp = "e" in text or "E" in text
        if len(toks) > 0 and toks[-1].kind == "." and not exp {
          let dot = text.find(".") ?? 0   # t.0.1 is two tuple parts, not a float
          toks.append(Tok(line, "int", str(int(text[..dot]))))
          toks.append(Tok(line, ".", "."))
          toks.append(Tok(line, "int", str(int(text[dot + 1..]))))
        } else {
          toks.append(Tok(line, "float", text))
        }
        pos = f
      } else {
        let e = digits(cs, pos)
        toks.append(Tok(line, "int", str(int(src_slice(cs, pos, e)))))
        pos = e
      }
    } else if is_letter(c) {
      var e = pos + 1
      while e < len(cs) and (is_letter(cs[e]) or is_digit(cs[e])) { e += 1 }
      let word = src_slice(cs, pos, e)
      var kind = "name"
      if is_keyword(word) { kind = word }
      let held: [str] = []
      for d in docs {
        if d != "" { held.append(d) }
      }
      docs = []
      toks.append(Tok(line, kind, word, held.join(" ")))
      pos = e
    } else {
      var op = ""
      if pos + 1 < len(cs) {
        if is_two(c + cs[pos + 1]) { op = c + cs[pos + 1] }
      }
      if op == "" {
        if not (c in "-+*/%<>=(){}[]:,.?!") { throw "unexpected character " + c }
        op = c
      }
      if op == "(" or op == "[" { depth += 1 }
      if op == ")" or op == "]" { depth -= 1 }
      toks.append(Tok(line, op, op))
      pos += len(op)
    }
  }
  toks.append(Tok(line, "nl", ""))
  toks.append(Tok(line, "eof", ""))
  return toks
}

fn src_slice(cs: [str], a: int, b: int) -> str {
  return cs[a..b].join("")
}
