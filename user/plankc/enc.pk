# plankc's encoder (6.71.0): the assembly gen.pk writes, turned into a Joshua Tree app image by plankc itself, with no
# clang and no linker. Step 6 of the true bootstrap (docs/ROADMAP.md). Two passes over the lines: the first places every
# label, the second writes each instruction's four bytes. The image is user_c.ld's: a _start at byte 0 that calls main
# and exits with what it returns, the code, the string literals, padding to a page, plankc's data cells, then the 16 byte
# JTU1 trailer. Every address in plankc's code is relative to where it runs, so the image needs no relocations.
# It knows exactly the forms gen.pk writes and stops on anything else.

# Bytes. Plank has neither chr nor ord, so under plank.py these three are stand-ins that never run: plankc's own build of
# this file swaps every call for its runtime's (gen.pk, the "plankc_" names): a zeroed string of n bytes, a byte written
# into one, a byte read out of one. The encoder runs only on plankc's runtime, on the Pi, where a string is bytes.
fn plankc_buf(n: int) -> str {
  return ""
}
fn plankc_buf_set(s: str, i: int, c: int) {
}
fn plankc_byte_at(s: str, i: int) -> int {
  return 0
}

struct Asm {
  pass: int         # 1 sizes the sections, 2 places the labels where they land, 3 writes the bytes
  sec: int          # 0 text, 1 rodata, 2 data: the section being written
  pc: [int]         # each section's next offset
  base: [int]       # each section's start in the image
  buf: str          # the image, its final size from the start (pass 3)
  l: [int]          # .L<n>'s address
  ls: [int]         # .Ls<n>'s
  le: [int]         # .Le<n>'s
  named: [str: int] # pk_*, main: the few named labels
}

fn pow2(k: int) -> int {
  var r = 1
  for i in 0..k {
    r = r * 2
  }
  return r
}

# v in k bits, two's complement, so a negative offset wraps the way the instruction wants it.
fn bits(v: int, k: int) -> int {
  let m = pow2(k)
  return (v % m + m) % m
}

fn here(a: Asm) -> int { return a.base[a.sec] + a.pc[a.sec] }

fn set_at(xs: [int], i: int, v: int) {
  while len(xs) <= i { xs.append(0) }
  xs[i] = v
}

fn place_label(a: Asm, name: str) {
  let v = here(a)
  if name.starts_with(".Ls") { set_at(a.ls, int(name[3..]), v) } else if name.starts_with(".Le") { set_at(a.le, int(name[3..]), v) } else if name.starts_with(".L") {
    set_at(a.l, int(name[2..]), v)
  } else {
    a.named[name] = v
  }
}

fn label(a: Asm, name: str) -> int {
  if a.pass < 3 { return here(a) }   # the size of every form is fixed, so a label's value never moves another
  if name.starts_with(".Ls") { return a.ls[int(name[3..])] }
  if name.starts_with(".Le") { return a.le[int(name[3..])] }
  if name.starts_with(".L") { return a.l[int(name[2..])] }
  if not (name in a.named) { throw "plankc's encoder: no label " + name }
  return a.named[name]
}

fn byte(a: Asm, c: int) {
  if a.pass == 3 { plankc_buf_set(a.buf, here(a), c) }
  a.pc[a.sec] = a.pc[a.sec] + 1
}

fn word(a: Asm, w: int) {
  var v = w
  for i in 0..4 {
    byte(a, v % 256)
    v = v / 256
  }
}

fn reg(r: str) -> int {
  if r == "sp" or r == "xzr" { return 31 }
  if r.starts_with("x") or r.starts_with("w") { return int(r[1..]) }
  throw "plankc's encoder: not a register: " + r
}

fn imm(s: str) -> int {
  if s.starts_with("#") { return int(s[1..]) }
  return int(s)
}

fn cond(c: str) -> int {
  let names = ["eq", "ne", "cs", "cc", "mi", "pl", "vs", "vc", "hi", "ls", "ge", "lt", "gt", "le"]
  for i in 0..len(names) {
    if names[i] == c { return i }
  }
  throw "plankc's encoder: no condition " + c
}

# Operands split on commas outside brackets: "x0, [x1, #8]" is ["x0", "[x1, #8]"].
fn operands(s: str) -> [str] {
  let out: [str] = []
  var cur = ""
  var depth = 0
  for c in s.chars() {
    if c == "[" { depth += 1 }
    if c == "]" { depth -= 1 }
    if c == "," and depth == 0 {
      out.append(cur.trim())
      cur = ""
    } else {
      cur = cur + c
    }
  }
  if cur.trim() != "" { out.append(cur.trim()) }
  return out
}

# [xn], [xn, #k], [xn, xm, lsl #3], with or without a trailing !: the base register, the offset, the index or -1.
fn mem(m: str) -> [int] {
  var t = m
  if t.ends_with("!") { t = t[..len(t) - 1] }
  let parts = operands(t[1..len(t) - 1])
  if len(parts) == 1 { return [reg(parts[0]), 0, -1] }
  if parts[1].starts_with("#") { return [reg(parts[0]), imm(parts[1]), -1] }
  return [reg(parts[0]), 0, reg(parts[1])]
}

# A 64-bit constant into register d: movz and three movk, always four words, so the first pass knows the size.
fn load_const(a: Asm, d: int, v: int) {
  var u = v
  for i in 0..4 {
    let piece = bits(u, 16)
    u = (u - piece) / 65536
    if i == 0 { word(a, 3531603968 + piece * 32 + d) } else { word(a, 4068474880 + i * 2097152 + piece * 32 + d) }
  }
}

# add or sub with an immediate: 12 bits, or 12 bits shifted by 12.
fn add_imm(a: Asm, op: int, d: int, n: int, v: int) {
  if v >= 0 and v < 4096 {
    word(a, op + v * 1024 + n * 32 + d)
  } else if v % 4096 == 0 and v / 4096 < 4096 {
    word(a, op + 4194304 + v / 4096 * 1024 + n * 32 + d)
  } else {
    throw "plankc's encoder: an add or sub of \(v)"
  }
}

fn branch(a: Asm, op: int, l: str, width: int, shift: int, low: int) {
  word(a, op + bits((label(a, l) - here(a)) / 4, width) * pow2(shift) + low)
}

# The single-register loads and stores: ldr, str, ldur, stur, ldrb, strb, with a post-index, a pre-index (!), an
# unsigned offset or an index register.
fn load_store(a: Asm, op: str, args: [str]) {
  let t = reg(args[0])
  let m = mem(args[1])
  let n = m[0] * 32 + t
  let load = op.starts_with("ld")
  if op == "ldrb" or op == "strb" {
    if m[1] != 0 { throw "plankc's encoder: a byte offset" }
    if load { return word(a, 960495616 + n) }
    return word(a, 956301312 + n)
  }
  if op == "ldur" or op == "stur" {
    if load { return word(a, 4164943872 + bits(m[1], 9) * 4096 + n) }
    return word(a, 4160749568 + bits(m[1], 9) * 4096 + n)
  }
  if len(args) == 3 {   # post-index: [xn], #k
    if load { return word(a, 4164944896 + bits(imm(args[2]), 9) * 4096 + n) }
    return word(a, 4160750592 + bits(imm(args[2]), 9) * 4096 + n)
  }
  if args[1].ends_with("!") {   # pre-index
    if load { return word(a, 4164946944 + bits(m[1], 9) * 4096 + n) }
    return word(a, 4160752640 + bits(m[1], 9) * 4096 + n)
  }
  if m[2] >= 0 {   # [xn, xm, lsl #3]
    if load { return word(a, 4167071744 + m[2] * 65536 + n) }
    return word(a, 4162877440 + m[2] * 65536 + n)
  }
  if m[1] % 8 != 0 or m[1] < 0 or m[1] > 32760 { throw "plankc's encoder: an offset of \(m[1])" }
  if load { return word(a, 4181721088 + m[1] / 8 * 1024 + n) }
  return word(a, 4177526784 + m[1] / 8 * 1024 + n)
}

fn instr(a: Asm, op: str, args: [str]) {
  if op == "ret" { return word(a, 3596551104) }
  if op == "svc" { return word(a, 3556769793) }
  if op == "br" { return word(a, 3592355840 + reg(args[0]) * 32) }
  if op == "b" { return branch(a, 335544320, args[0], 26, 0, 0) }
  if op == "bl" { return branch(a, 2483027968, args[0], 26, 0, 0) }
  if op.starts_with("b.") { return branch(a, 1409286144, args[0], 19, 5, cond(op[2..])) }
  if op == "cbz" { return branch(a, 3019898880, args[1], 19, 5, reg(args[0])) }
  if op == "cbnz" { return branch(a, 3036676096, args[1], 19, 5, reg(args[0])) }
  if op == "tbnz" and args[1] == "#63" { return branch(a, 3070230528 + 31 * 524288, args[2], 14, 5, reg(args[0])) }
  if op == "adr" {
    let v = bits(label(a, args[1]) - here(a), 21)
    return word(a, 268435456 + v % 4 * 536870912 + v / 4 * 32 + reg(args[0]))
  }
  if op == "adrp" {
    let t = label(a, args[1])
    let p = here(a)
    let v = bits((t - t % 4096 - (p - p % 4096)) / 4096, 21)
    return word(a, 2415919104 + v % 4 * 536870912 + v / 4 * 32 + reg(args[0]))
  }
  if op == "mov" {
    if args[1].starts_with("#") {
      let v = imm(args[1])
      if v >= 0 and v < 65536 { return word(a, 3531603968 + v * 32 + reg(args[0])) }
      return load_const(a, reg(args[0]), v)
    }
    if args[0] == "sp" or args[1] == "sp" { return word(a, 2432696320 + reg(args[1]) * 32 + reg(args[0])) }   # add d, n, #0
    return word(a, 2852127712 + reg(args[1]) * 65536 + reg(args[0]))                                           # orr d, xzr, m
  }
  if op == "ldr" and args[1].starts_with("=") { return load_const(a, reg(args[0]), int(args[1][1..])) }
  if op == "ldr" or op == "str" or op == "ldur" or op == "stur" or op == "ldrb" or op == "strb" { return load_store(a, op, args) }
  if op == "ldp" { return word(a, 2831155200 + bits(imm(args[3]) / 8, 7) * 32768 + reg(args[1]) * 1024 + mem(args[2])[0] * 32 + reg(args[0])) }
  if op == "stp" { return word(a, 2843738112 + bits(mem(args[2])[1] / 8, 7) * 32768 + reg(args[1]) * 1024 + mem(args[2])[0] * 32 + reg(args[0])) }
  if op == "add" or op == "sub" {
    if args[2].starts_with(":lo12:") { return word(a, 2432696320 + label(a, args[2][6..]) % 4096 * 1024 + reg(args[1]) * 32 + reg(args[0])) }
    if args[2].starts_with("#") {
      if op == "add" { return add_imm(a, 2432696320, reg(args[0]), reg(args[1]), imm(args[2])) }
      return add_imm(a, 3506438144, reg(args[0]), reg(args[1]), imm(args[2]))
    }
    if op == "add" { return word(a, 2332033024 + reg(args[2]) * 65536 + reg(args[1]) * 32 + reg(args[0])) }
    return word(a, 3405774848 + reg(args[2]) * 65536 + reg(args[1]) * 32 + reg(args[0]))
  }
  if op == "mul" { return word(a, 2600500224 + reg(args[2]) * 65536 + reg(args[1]) * 32 + reg(args[0])) }
  if op == "sdiv" { return word(a, 2596277248 + reg(args[2]) * 65536 + reg(args[1]) * 32 + reg(args[0])) }
  if op == "msub" { return word(a, 2600501248 + reg(args[2]) * 65536 + reg(args[3]) * 1024 + reg(args[1]) * 32 + reg(args[0])) }
  if op == "neg" { return word(a, 3405775840 + reg(args[1]) * 65536 + reg(args[0])) }
  if op == "cmp" {
    if args[1].starts_with("#") { return add_imm(a, 4043309056, 31, reg(args[0]), imm(args[1])) }
    return word(a, 3942645791 + reg(args[1]) * 65536 + reg(args[0]) * 32)
  }
  if op == "cset" {
    let c = cond(args[1])
    var inv = c + 1
    if c % 2 == 1 { inv = c - 1 }
    return word(a, 2594113504 + inv * 4096 + reg(args[0]))
  }
  if op == "eor" and args[2] == "#1" { return word(a, 3527409664 + reg(args[1]) * 32 + reg(args[0])) }
  throw "plankc's encoder does not know: \(op) \(args.join(", "))"
}

# A quoted string the way gen.pk's quote writes it: \\, \", \n, \t and \0 escaped, every other byte as it is.
fn ascii(a: Asm, q: str) {
  var i = 1
  let end = len(q) - 1
  while i < end {
    var c = plankc_byte_at(q, i)
    if c == 92 {
      i += 1
      c = plankc_byte_at(q, i)
      if c == 110 { c = 10 } else if c == 116 { c = 9 } else if c == 48 { c = 0 }
    }
    byte(a, c)
    i += 1
  }
}

fn line(a: Asm, raw: str) {
  let s = raw.trim()
  if s == "" { return }
  if s.ends_with(":") {
    if a.pass < 3 { place_label(a, s[..len(s) - 1]) }
    return
  }
  let sp = s.find(" ") ?? len(s)
  let op = s[..sp]
  let rest = s[sp..].trim()
  if op == ".text" {
    a.sec = 0
  } else if op == ".section" {
    a.sec = 1
  } else if op == ".data" {
    a.sec = 2
  } else if op == ".globl" or op == ".ltorg" {
    return
  } else if op == ".p2align" {
    let m = pow2(int(rest))
    while here(a) % m != 0 { byte(a, 0) }
  } else if op == ".zero" {
    for i in 0..int(rest) { byte(a, 0) }
  } else if op == ".byte" {
    byte(a, int(rest))
  } else if op == ".ascii" {
    ascii(a, rest)
  } else if op == ".quad" {
    let parts = rest.split(" - ")
    var v = label(a, parts[0]) - label(a, parts[1])
    for i in 0..8 {
      byte(a, bits(v, 8))
      v = (v - bits(v, 8)) / 256
    }
  } else {
    instr(a, op, operands(rest))
  }
}

fn u32(a: Asm, v: int) {
  var x = v
  for i in 0..4 {
    byte(a, x % 256)
    x = x / 256
  }
}

# The app image for gen.pk's lines: a string of bytes on plankc's runtime.
fn image(lines: [str]) -> str {
  let a = Asm(1, 0, [0, 0, 0], [0, 0, 0], "", [], [], [], [:])
  var trailer = 0
  for pass in 1..4 {
    a.pass = pass
    a.sec = 0
    a.pc = [0, 0, 0]
    # _start, at byte 0: main's return value is the exit status
    instr(a, "bl", ["main"])
    instr(a, "mov", ["x8", "#1"])
    instr(a, "svc", ["#0"])
    for l in lines { line(a, l) }
    if pass == 1 {   # text at 0, the literals after it, the data on the next page, the trailer after that
      a.base[1] = (a.pc[0] + 15) / 16 * 16
      a.base[2] = (a.base[1] + a.pc[1] + 4095) / 4096 * 4096
      trailer = (a.base[2] + a.pc[2] + 7) / 8 * 8
      a.buf = plankc_buf(trailer + 16)
    }
  }
  # the trailer: "JTU1", the code's length, and an empty relocation list (start and end both here)
  a.sec = 2
  a.pc[2] = trailer - a.base[2]
  for c in [74, 84, 85, 49] { byte(a, c) }
  u32(a, a.base[2])
  u32(a, trailer)
  u32(a, trailer)
  return a.buf
}
