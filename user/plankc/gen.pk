# plankc's code generator: aarch64 assembly for the Pi, written in Plank. Step 3 of the true bootstrap (docs/ROADMAP.md).
# The subset so far: functions over int, bool and str, let and var, =, +=, if and else, while, for over a range, break,
# continue, return, calls, arithmetic, comparisons, and and or, not, print, and strings (6.63.0: +, ==, len, str(n) and
# \( ) interpolation, through rt.pk, the runtime written in Plank). Anything else stops with "not supported yet". A simple stack machine: every value ends in x0, a binary op pushes its
# left side, locals live below x29, and sp moves 16 bytes at a time so it stays aligned. The output links like a Plank app
# (tools/plankapp.sh --plankc): pklibc's _start calls main, main calls the program's main. The assembler is still clang's;
# plankc's own encoder comes in step 6. A string is the address of its bytes, its length in the 8 bytes before them.
# The collector in rt.pk finds the program's objects from the stack alone, so one rule holds everywhere below: no heap
# address lives only in a register across a call. Values go to a local or a push before anything else runs, and every
# function stores its arguments in its frame first. A register allocator must keep that rule or tell the collector.
import "parse.pk"

struct Local {
  name: str
  off: int
  ty: str
  boxed: bool = false   # captured by a closure: the slot holds a heap cell, and the value lives in it (6.75.0)
}

struct G {
  out: [str]
  label: int
  locals: [Local]
  loops: [str]     # break and continue labels, two a loop
  loop_tries: [int]  # how many trys were open where each loop began
  tries: [int]     # the open trys' records, as frame offsets
  fns: [str: str]  # function name: its return type
  structs: [str: N]  # struct name: its Struct node
  enums: [str: N]    # enum name: its Enum node (6.73.0)
  rt: [str: int]   # the built-ins rt.pk is written with: syscall, peek, poke, global, addr, as_str, stack_pointer
  strs: [str]      # string literals, as .asciz bodies
  next_off: int
  ret: str         # the epilogue label of the function being written
  gc_every: int    # 0, or collect every this many bytes (plankc --gc=N asm, for testing the collector)
  fn_nodes: [str: N]  # function name (Struct.method for a method): its Fn node, for parameters and defaults
  ret_type: str    # the return type of the function being written ("" in a lambda: the first return says)
  boxed_names: [str: int]  # names closures in this function capture: their locals live in cells
  lambda_code: [str]       # the lambdas' and trampolines' code, written as they come, placed after the functions
  lambda_n: int
  expect: str              # the fn type a lambda about to be written should have, from where it goes, or ""
  tramps: [str: int]       # functions already given a trampoline, so they can be values
  bytes: bool              # writing one of rt.pk's functions, where len of a str is its bytes (6.78.0)
  generics: [str: N]       # a function with type parameters: its Fn node, written once per set of types (6.81.0)
  instances: [str: str]    # first<int> and the like: the name its copy is written under
  pending: [N]             # copies made while writing a function, written after it
  gstructs: [str: N]       # a struct with type parameters: its Struct node; Stack<int> is a struct of its own (6.82.0)
}

fn emit(g: G, s: str) { g.out.append(s) }   # unindented: an indent would copy every line, and the assembler needs none
fn place(g: G, l: str) { g.out.append(l + ":") }
fn fresh(g: G) -> str {
  g.label += 1
  return ".L" + str(g.label)
}
fn nope(n: N, what: str) { throw "\(n.line): \(what) not supported yet" }

fn push(g: G) { emit(g, "str x0, [sp, #-16]!") }
fn pop(g: G, r: str) { emit(g, "ldr \(r), [sp], #16") }

fn find(g: G, name: str) -> Local {
  var i = len(g.locals) - 1
  while i >= 0 {
    if g.locals[i].name == name { return g.locals[i] }
    i -= 1
  }
  throw "no variable \(name)"
}

fn new_local(g: G, name: str, ty: str) -> Local {
  let l = raw_local(g, name, ty)
  if l.boxed {   # its cell, made now, so every later store is an assignment through it; x0 kept
    push(g)
    emit(g, "mov x0, #0")
    emit(g, "bl pk_rt_box")
    slot(g, "str", "x0", l.off)
    pop(g, "x0")
  }
  return l
}

# A local's slot, boxed when a closure captures its name, with no cell made yet (a parameter's comes after the prologue).
fn raw_local(g: G, name: str, ty: str) -> Local {
  g.next_off += 8
  if g.next_off > 4088 { throw "more than 511 locals in one function" }
  let l = Local(name, g.next_off, ty, not name.starts_with(" ") and name in g.boxed_names)
  g.locals.append(l)
  return l
}

fn load(g: G, l: Local) {
  slot(g, "ldr", "x0", l.off)
  if l.boxed { emit(g, "ldr x0, [x0]") }
}
fn store(g: G, l: Local) {
  if l.boxed {
    emit(g, "mov x1, x0")
    slot(g, "ldr", "x0", l.off)
    emit(g, "str x1, [x0]")
    emit(g, "mov x0, x1")
  } else {
    slot(g, "str", "x0", l.off)
  }
}

# ldr or str of register r at x29 - off: ldur and stur reach 256 bytes down, past that through x9.
fn slot(g: G, op: str, r: str, off: int) {
  if off <= 256 {
    var short = "stur"
    if op == "ldr" { short = "ldur" }
    emit(g, "\(short) \(r), [x29, #-\(off)]")
  } else {
    emit(g, "sub x9, x29, #\(off)")
    emit(g, "\(op) \(r), [x9]")
  }
}

fn int_type(n: N, ty: str) -> str {
  if ty == "int" or ty == "bool" or ty == "str" or ty == "float" { return ty }
  if ty.starts_with("fn(") { return ty }   # a closure: {code, env}
  if ty.starts_with("(") and ty.ends_with(")") {   # a tuple: each part a type of its own
    for part in tuple_parts(ty) { int_type(n, part) }
    return ty
  }
  if ty.ends_with("?") and not ty.ends_with("??") {   # may be missing: nil is 0, and an int or bool sits in a box
    int_type(n, ty[..len(ty) - 1])
    return ty
  }
  if ty.starts_with("Result<") and ty.ends_with(">") {   # 6.80.0: ok(value: T) or err(message: str), an enum per T (result_enum)
    int_type(n, ty[7..len(ty) - 1])
    return ty
  }
  let kv = dict_parts(ty)
  if len(kv) == 2 {   # a dict: string or int keys (6.79.0), any value
    if kv[0] != "str" and kv[0] != "int" { nope(n, "a dict with \(kv[0]) keys") }
    int_type(n, kv[1])
    return ty
  }
  if ty.starts_with("[") and ty.ends_with("]") and not ("?" in ty) {   # a list of any of these
    int_type(n, ty[1..len(ty) - 1])
    return ty
  }
  if upper(ty[0]) and not ("<" in ty) and not ("?" in ty) and not ("." in ty) { return ty }   # a struct, checked where it is used
  if upper(ty[0]) and ty.ends_with(">") and not ("?" in ty[..ty.find("<") ?? 0]) {   # Name<T, U>: a generic struct's copy (6.82.0)
    for a in type_arg_list(ty) { int_type(n, a) }
    return ty
  }
  nope(n, "the type \(ty)")
  return ""
}

fn is_list(ty: str) -> bool { return ty.starts_with("[") and len(dict_parts(ty)) == 0 and ty != "[:]" }
fn is_dict(ty: str) -> bool { return ty == "[:]" or len(dict_parts(ty)) == 2 }
# The runtime's setter for a dict with keys of type kt: an int key marks the dict as one compared by value (6.79.0).
fn dict_setter(kt: str) -> str {
  if kt == "int" { return "pk_rt_dict_set_int" }
  return "pk_rt_dict_set"
}

# [K: V] as [K, V]; [] for anything else. The ": " has to sit at depth one, so [[str: int]] is a list.
fn dict_parts(ty: str) -> [str] {
  if not ty.starts_with("[") { return [] }
  let cs = ty.chars()
  var depth = 0
  for i in 0..len(cs) - 1 {
    if cs[i] == "[" or cs[i] == "(" { depth += 1 }
    if cs[i] == "]" or cs[i] == ")" { depth -= 1 }
    if cs[i] == ":" and depth == 1 and cs[i + 1] == " " { return [ty[1..i], ty[i + 2..len(ty) - 1]] }
  }
  return []
}
fn is_opt(ty: str) -> bool { return ty.ends_with("?") }

# (int, (str, bool)) as ["int", "(str, bool)"]: split on the ", " at depth one.
fn tuple_parts(ty: str) -> [str] {
  let out: [str] = []
  let cs = ty.chars()
  var depth = 0
  var at = 1
  for i in 1..len(cs) - 1 {
    if cs[i] == "(" or cs[i] == "[" { depth += 1 }
    if cs[i] == ")" or cs[i] == "]" { depth -= 1 }
    if cs[i] == "," and depth == 0 {
      out.append(ty[at..i])
      at = i + 2
    }
  }
  out.append(ty[at..len(ty) - 1])
  return out
}
fn boxed(ty: str) -> bool { return ty == "int?" or ty == "bool?" or ty == "float?" }

# Can a value of type got go where want is written?
fn fits(got: str, want: str) -> bool {
  return got == want or (got == "[]" and is_list(want)) or (got == "[:]" and is_dict(want)) or (got == "nil" and is_opt(want)) or (is_opt(want) and got + "?" == want)
}

# x0 holds a value of type got going where want is: an int or bool into an int? or bool? gets its box.
fn coerce(g: G, got: str, want: str) {
  if boxed(want) and not is_opt(got) and got != "nil" { emit(g, "bl pk_rt_box") }
}

# The type a list holds.
fn item_type(n: N, ty: str) -> str {
  if not is_list(ty) or ty == "[]" { nope(n, "indexing a " + ty) }
  return ty[1..len(ty) - 1]
}

# ---------------------------------------------------------------- expressions
fn cmp_cond(op: str) -> str {
  if op == "<" { return "lt" }
  if op == ">" { return "gt" }
  if op == "<=" { return "le" }
  if op == ">=" { return "ge" }
  if op == "==" { return "eq" }
  return "ne"
}

# Writes code that leaves the value of e in x0, and gives its type.
fn gen_expr(g: G, e: N) -> str {
  if e.kind == "Str" {
    lit(g, "x0", e.kids[0].text)
    return "str"
  }
  if e.kind == "Interp" { return interp(g, e) }
  if e.kind == "IfExpr" {   # 6.81.0: if c { a } else { b } as a value; nil on one side makes it optional
    let t = join_types(e, type_of(g, e.kids[1]), type_of(g, e.kids[2]))
    let other = fresh(g)
    let done = fresh(g)
    gen_expr(g, e.kids[0])
    emit(g, "cbz x0, " + other)
    coerce(g, gen_expr(g, e.kids[1]), t)
    emit(g, "b " + done)
    place(g, other)
    coerce(g, gen_expr(g, e.kids[2]), t)
    place(g, done)
    return t
  }
  if e.kind == "IfLetExpr" {   # 6.82.0: if let x = o { a } else { b } as a value
    let other = fresh(g)
    let done = fresh(g)
    let ot = gen_expr(g, e.kids[1])
    if not is_opt(ot) { nope(e, "if let on a \(ot), which is never nil") }
    emit(g, "cbz x0, " + other)
    if boxed(ot) { emit(g, "ldr x0, [x0]") }
    let mark = len(g.locals)
    store(g, new_local(g, e.kids[0].text, ot[..len(ot) - 1]))
    let t = join_types(e, type_of(g, e.kids[2]), type_of(g, e.kids[3]))
    coerce(g, gen_expr(g, e.kids[2]), t)
    while len(g.locals) > mark { g.locals.pop() }
    emit(g, "b " + done)
    place(g, other)
    coerce(g, gen_expr(g, e.kids[3]), t)
    place(g, done)
    return t
  }
  if e.kind == "ResultTry" {   # 6.80.0: r? is r's value, or, when r is an err, returns r from here
    let t = gen_expr(g, e.kids[0])
    if not t.starts_with("Result<") { nope(e, "? on a " + t) }
    if not g.ret_type.starts_with("Result<") { nope(e, "? in a function that does not give a Result") }
    let okl = fresh(g)
    emit(g, "ldr x1, [x0]")
    emit(g, "cbz x1, " + okl)
    leave_tries(g, 0)
    emit(g, "b " + g.ret)
    place(g, okl)
    emit(g, "ldr x0, [x0, #8]")
    return t[7..len(t) - 1]
  }
  if e.kind == "Tuple" {   # the address of its parts, 8 bytes each (6.74.0)
    let items = e.kids[0].kids
    emit(g, "mov x0, #" + str(len(items) * 8 + 8))
    emit(g, "bl pk_rt_alloc")
    push(g)
    let parts: [str] = []
    for i in 0..len(items) {
      parts.append(gen_expr(g, items[i]))
      emit(g, "ldr x1, [sp]")
      emit(g, "str x0, [x1, #" + str(i * 8) + "]")
    }
    pop(g, "x0")
    return "(" + parts.join(", ") + ")"
  }
  if e.kind == "Nil" {
    emit(g, "mov x0, #0")
    return "nil"
  }
  if e.kind == "Slice" {
    let t = gen_expr(g, e.kids[0])
    if t != "str" and not is_list(t) { nope(e, "slicing a " + t) }
    push(g)
    if e.kids[1].kind == "_" { emit(g, "mov x0, #0") } else { gen_expr(g, e.kids[1]) }
    push(g)
    if e.kids[2].kind == "_" { emit(g, "ldr x0, =4611686018427387904") } else { gen_expr(g, e.kids[2]) }
    emit(g, "mov x2, x0")
    pop(g, "x1")
    pop(g, "x0")
    if t == "str" { emit(g, "bl pk_rt_str_slice") } else { emit(g, "bl pk_rt_list_slice") }
    return t
  }
  if e.kind == "List" {
    let items = e.kids[0].kids
    emit(g, "bl pk_rt_list_new")
    if len(items) == 0 { return "[]" }
    var ty = ""
    for x in items {
      push(g)
      let t = gen_expr(g, x)
      if ty == "" { ty = t }
      if t != ty { nope(x, "a list of mixed \(ty) and \(t)") }
      emit(g, "mov x1, x0")
      emit(g, "ldr x0, [sp]")
      emit(g, "bl pk_rt_list_push")
      pop(g, "x0")
    }
    return "[" + ty + "]"
  }
  if e.kind == "Dict" {
    let keys = e.kids[0].kids
    let vals = e.kids[1].kids
    emit(g, "bl pk_rt_dict_new")
    if len(keys) == 0 { return "[:]" }
    push(g)
    var vt = ""
    var kt = ""
    for i in 0..len(keys) {
      let k = gen_expr(g, keys[i])
      if kt == "" { kt = k }
      if (k != "str" and k != "int") or k != kt { nope(keys[i], "a dict key that is a \(k) among \(kt)s") }
      push(g)
      let t = gen_expr(g, vals[i])
      if vt == "" { vt = t }
      if t != vt { nope(vals[i], "a dict of mixed \(vt) and \(t)") }
      emit(g, "mov x2, x0")
      pop(g, "x1")
      emit(g, "ldr x0, [sp]")
      emit(g, "bl " + dict_setter(kt))
    }
    pop(g, "x0")
    return "[" + kt + ": " + vt + "]"
  }
  if e.kind == "Index" {
    let t = gen_expr(g, e.kids[0])
    if is_dict(t) {
      push(g)
      gen_expr(g, e.kids[1])
      emit(g, "mov x1, x0")
      pop(g, "x0")
      emit(g, "bl pk_rt_dict_get")
      return dict_parts(t)[1]
    }
    if t == "str" {
      push(g)
      gen_expr(g, e.kids[1])
      emit(g, "mov x1, x0")
      pop(g, "x0")
      emit(g, "bl pk_rt_char_at")
      return "str"
    }
    let item = item_type(e, t)
    push(g)
    if gen_expr(g, e.kids[1]) != "int" { nope(e, "an index that is not an int") }
    emit(g, "mov x1, x0")
    pop(g, "x0")
    emit(g, "bl pk_rt_list_at")
    emit(g, "ldr x0, [x0]")
    return item
  }
  if e.kind == "Method" { return method(g, e) }
  if e.kind == "Field" and enum_name(g, e.kids[0]) != "" {   # Light.red
    return construct_case(g, e, enum_name(g, e.kids[0]), e.kids[1].text, [], [])
  }
  if e.kind == "CallValue" and e.kids[0].kind == "Lambda" and len(e.kids[0].kids[0].kids) == 0 and len(e.kids[0].kids[2].kids) == 1 and e.kids[0].kids[2].kids[0].kind == "Match" {
    return gen_match(g, e.kids[0].kids[2].kids[0], true)   # match as a value: the parser's closure, written inline
  }
  if e.kind == "Field" {
    let t = gen_expr(g, e.kids[0])
    if t.starts_with("(") and e.kids[1].text.starts_with("_") {   # p.0
      let i = int(e.kids[1].text[1..])
      let parts = tuple_parts(t)
      if i >= len(parts) { nope(e, "part \(i) of a \(t)") }
      emit(g, "ldr x0, [x0, #" + str(i * 8) + "]")
      return parts[i]
    }
    let f = field(g, e, t, e.kids[1].text)
    emit(g, "ldr x0, [x0, #\(f.off)]")
    return f.ty
  }
  if e.kind == "Num" {
    if e.kids[1].text == "float" { return float_lit(g, e, e.kids[0].text) }
    emit(g, "ldr x0, =" + e.kids[0].text)
    return "int"
  }
  if e.kind == "Bool" {
    if e.kids[0].text == "true" { emit(g, "mov x0, #1") } else { emit(g, "mov x0, #0") }
    return "bool"
  }
  if e.kind == "Name" {
    if not has_local(g, e.kids[0].text) and e.kids[0].text in g.fns { return fn_value(g, e, e.kids[0].text) }
    let l = find(g, e.kids[0].text)
    load(g, l)
    return l.ty
  }
  if e.kind == "Lambda" { return gen_lambda(g, e) }
  if e.kind == "CallValue" and not (e.kids[0].kind == "Lambda" and len(e.kids[0].kids[0].kids) == 0 and len(e.kids[0].kids[2].kids) == 1 and e.kids[0].kids[2].kids[0].kind == "Match") {
    return call_value(g, e, e.kids[0], e.kids[1].kids)
  }
  if e.kind == "Unary" {
    let t = gen_expr(g, e.kids[1])
    if e.kids[0].text == "-" and t == "float" {
      fop(g, "fneg d0, d0", false)
      return t
    }
    if e.kids[0].text == "-" {
      emit(g, "neg x0, x0")
      return "int"
    }
    emit(g, "cmp x0, #0")
    emit(g, "cset x0, eq")
    return "bool"
  }
  if e.kind == "Binary" {
    let op = e.kids[0].text
    if op == "and" or op == "or" {
      let done = fresh(g)
      gen_expr(g, e.kids[1])
      if op == "and" { emit(g, "cbz x0, " + done) } else { emit(g, "cbnz x0, " + done) }
      gen_expr(g, e.kids[2])
      place(g, done)
      emit(g, "cmp x0, #0")
      emit(g, "cset x0, ne")
      return "bool"
    }
    if op == "??" {
      let have = fresh(g)
      let done = fresh(g)
      let t = gen_expr(g, e.kids[1])
      if not is_opt(t) { nope(e, "?? on a \(t), which is never nil") }
      let base = t[..len(t) - 1]
      emit(g, "cbnz x0, " + have)
      let d = gen_expr(g, e.kids[2])
      if d != base { nope(e, "?? with a \(d) for a \(t)") }
      emit(g, "b " + done)
      place(g, have)
      if boxed(t) { emit(g, "ldr x0, [x0]") }
      place(g, done)
      return base
    }
    var lt = gen_expr(g, e.kids[1])
    push(g)
    var rt = gen_expr(g, e.kids[2])
    emit(g, "mov x1, x0")
    pop(g, "x0")
    if op == "in" and is_dict(rt) {
      emit(g, "mov x2, x0")
      emit(g, "mov x0, x1")
      emit(g, "mov x1, x2")
      emit(g, "bl pk_rt_dict_has")
      return "bool"
    }
    if op == "in" and is_list(rt) and rt != "[]" {   # 6.79.0: an item equal to it, as == compares
      if not fits(lt, item_type(e, rt)) { nope(e, "a \(lt) in a \(rt)") }
      emit(g, "mov x2, x0")
      emit(g, "mov x0, x1")
      emit(g, "mov x1, x2")
      lit(g, "x2", item_type(e, rt))
      emit(g, "bl pk_rt_list_has")
      return "bool"
    }
    if op == "in" {
      if lt != "str" or rt != "str" { nope(e, "in on a \(rt)") }
      emit(g, "mov x2, x0")
      emit(g, "mov x0, x1")
      emit(g, "mov x1, x2")
      emit(g, "bl pk_rt_find")
      emit(g, "cmp x0, #0")
      emit(g, "cset x0, ge")
      return "bool"
    }
    if (op == "==" or op == "!=") and (lt == "nil" or rt == "nil") {   # x == nil: the pointer, or the box
      emit(g, "cmp x0, x1")
      emit(g, "cset x0, " + cmp_cond(op))
      return "bool"
    }
    if (op == "==" or op == "!=") and (rt == "[]" or rt == "[:]") and fits(rt, lt) { rt = lt }   # xs == []
    if (op == "==" or op == "!=") and (lt == "[]" or lt == "[:]") and fits(lt, rt) { lt = rt }
    if lt != rt { nope(e, "\(op) between \(lt) and \(rt)") }
    if (op == "==" or op == "!=") and lt in g.enums {   # the same case with the same fields
      lit(g, "x2", lt)
      emit(g, "bl pk_rt_enum_eq")
      if op == "!=" { emit(g, "eor x0, x0, #1") }
      return "bool"
    }
    if lt == "float" { return float_op(g, e, op) }
    if (op == "==" or op == "!=") and (is_list(lt) or is_dict(lt) or lt.starts_with("(") or lt in g.structs or is_opt(lt)) {
      lit(g, "x2", lt)   # part by part, from the type written out (6.77.0)
      emit(g, "bl pk_rt_equal")
      if op == "!=" { emit(g, "eor x0, x0, #1") }
      return "bool"
    }
    if lt != "str" and lt != "int" and lt != "bool" { nope(e, "\(op) on \(lt)") }
    if lt == "str" {
      if op == "+" {
        emit(g, "bl pk_rt_concat")
        return "str"
      }
      if op == "<" or op == ">" or op == "<=" or op == ">=" {   # by bytes, as Plank compares
        emit(g, "bl pk_rt_str_cmp")
        emit(g, "cmp x0, #0")
        emit(g, "cset x0, " + cmp_cond(op))
        return "bool"
      }
      if op != "==" and op != "!=" { nope(e, "\(op) on strings") }
      emit(g, "bl pk_rt_str_eq")
      if op == "!=" { emit(g, "eor x0, x0, #1") }
      return "bool"
    }
    if op == "+" { emit(g, "add x0, x0, x1") } else if op == "-" { emit(g, "sub x0, x0, x1") } else if op == "*" {
      emit(g, "mul x0, x0, x1")
    } else if op == "/" {
      emit(g, "sdiv x0, x0, x1")
    } else if op == "%" {
      emit(g, "sdiv x2, x0, x1")
      emit(g, "msub x0, x2, x1, x0")
    } else {
      emit(g, "cmp x0, x1")
      emit(g, "cset x0, " + cmp_cond(op))
      return "bool"
    }
    return "int"
  }
  if e.kind == "Call" {
    let name = e.kids[0].text
    let a = e.kids[1].kids
    if has_local(g, name) { return call_value(g, e, node("Name", e.line, [sv(name)]), a) }   # next(): a closure in a local
    if name in g.gstructs and not has_local(g, name) { return construct(g, e, g.structs[struct_from_args(g, e, name, a)]) }
    if "<" in name and struct_inst(g, name) { return construct(g, e, g.structs[name]) }
    if name in g.structs { return construct(g, e, g.structs[name]) }
    if name == "attempt" and len(a) == 1 and not (name in g.fns) { return attempt_call(g, e, a[0]) }
    if name in g.generics { return gen_expr(g, node("Call", e.line, [sv(instance(g, e, name, a)), e.kids[1], e.kids[2]])) }
    if name == "plankc_buf" and len(a) == 1 {   # enc.pk's stand-ins, swapped for the runtime's bytes (enc.pk says why)
      gen_expr(g, a[0])
      emit(g, "bl pk_rt_zstr")
      return "str"
    }
    if name == "plankc_buf_set" and len(a) == 3 {
      gen_expr(g, a[0])
      push(g)
      gen_expr(g, a[1])
      push(g)
      gen_expr(g, a[2])
      emit(g, "mov x2, x0")
      pop(g, "x1")
      pop(g, "x0")
      emit(g, "add x0, x0, x1")
      emit(g, "strb w2, [x0]")
      return "void"
    }
    if name == "plankc_byte_len" and len(a) == 1 {
      gen_expr(g, a[0])
      emit(g, "ldur x0, [x0, #-8]")
      return "int"
    }
    if name == "plankc_byte_at" and len(a) == 2 {
      gen_expr(g, a[0])
      push(g)
      gen_expr(g, a[1])
      emit(g, "mov x1, x0")
      pop(g, "x0")
      emit(g, "add x0, x0, x1")
      emit(g, "ldrb w0, [x0]")
      return "int"
    }
    if not (name in g.fns) {
      for lab in e.kids[2].kids {
        if lab.kind != "_" { nope(e, "a labeled argument to " + name) }
      }
    }
    if name == "print" { return print_(g, e, a) }
    if not (name in g.fns) { return builtin(g, e, name, a) }
    return call_fn(g, e, name, a, e.kids[2].kids, false)
  }
  if e.kind == "Unwrap" {   # x!: the value, or a stop with the line when it is nil
    let t = gen_expr(g, e.kids[0])
    if not is_opt(t) { nope(e, "! on a \(t), which is never nil") }
    let ok = fresh(g)
    emit(g, "cbnz x0, " + ok)
    lit(g, "x0", "\(e.line): unwrapped nil")
    emit(g, "bl pk_rt_fail")
    place(g, ok)
    if boxed(t) { emit(g, "ldr x0, [x0]") }
    return t[..len(t) - 1]
  }
  nope(e, "the expression " + e.kind)
  return ""
}

# print(a, b, ...): each value as a string, a space between, then a newline.
fn print_(g: G, e: N, a: [N]) -> str {
  if len(a) == 0 { lit(g, "x0", "") }
  for i in 0..len(a) {
    if i > 0 {
      push(g)
      lit(g, "x1", " ")
      pop(g, "x0")
      emit(g, "bl pk_rt_concat")
      push(g)
    }
    to_str(g, a[i], gen_expr(g, a[i]))
    if i > 0 {
      emit(g, "mov x1, x0")
      pop(g, "x0")
      emit(g, "bl pk_rt_concat")
    }
  }
  emit(g, "bl pk_rt_print_str")
  return "void"
}

# The value in x0, of type t, as a string, the way print shows it.
fn to_str(g: G, e: N, t: str) {
  if t == "int" {
    emit(g, "bl pk_rt_int_str")
  } else if t == "float" {
    emit(g, "bl pk_rt_float_str")
  } else if t == "bool" {
    let f = fresh(g)
    let done = fresh(g)
    emit(g, "cbz x0, " + f)
    lit(g, "x0", "true")
    emit(g, "b " + done)
    place(g, f)
    lit(g, "x0", "false")
    place(g, done)
  } else if is_list(t) or is_dict(t) or upper(t[0]) or is_opt(t) or t.starts_with("(") {
    lit(g, "x1", t)
    emit(g, "mov x2, #0")
    emit(g, "bl pk_rt_show")
  } else if t != "str" {
    nope(e, "showing a " + t)
  }
}

fn str_method(g: G, e: N, name: str, a: [N]) -> str {
  if name == "chars" or name == "trim" {
    if len(a) != 0 { nope(e, name + " with arguments") }
    if name == "chars" {
      emit(g, "bl pk_rt_chars")
      return "[str]"
    }
    emit(g, "bl pk_rt_trim")
    return "str"
  }
  if (name == "upper" or name == "lower") and len(a) == 0 {   # ASCII letters (6.77.0)
    if name == "upper" { emit(g, "mov x1, #1") } else { emit(g, "mov x1, #0") }
    emit(g, "bl pk_rt_case")
    return "str"
  }
  if name == "replace" and len(a) == 2 {
    push(g)
    if gen_expr(g, a[0]) != "str" { nope(e, "replace of anything but strings") }
    push(g)
    if gen_expr(g, a[1]) != "str" { nope(e, "replace of anything but strings") }
    emit(g, "mov x2, x0")
    pop(g, "x1")
    pop(g, "x0")
    emit(g, "bl pk_rt_replace")
    return "str"
  }
  if name == "split" and len(a) == 0 {   # on runs of whitespace (6.77.0)
    emit(g, "bl pk_rt_split_space")
    return "[str]"
  }
  if len(a) != 1 { nope(e, "the string method " + name) }
  push(g)
  if gen_expr(g, a[0]) != "str" { nope(e, name + " of anything but a string") }
  emit(g, "mov x1, x0")
  pop(g, "x0")
  if name == "starts_with" {
    emit(g, "bl pk_rt_starts")
    return "bool"
  }
  if name == "ends_with" {
    emit(g, "bl pk_rt_ends")
    return "bool"
  }
  if name == "split" {
    emit(g, "bl pk_rt_split")
    return "[str]"
  }
  if name == "find" {   # where it is, or nil
    let none_ = fresh(g)
    let done = fresh(g)
    emit(g, "bl pk_rt_cfind")
    emit(g, "tbnz x0, #63, " + none_)
    emit(g, "bl pk_rt_box")
    emit(g, "b " + done)
    place(g, none_)
    emit(g, "mov x0, #0")
    place(g, done)
    return "int?"
  }
  nope(e, "the string method " + name)
  return ""
}

# xs.append(v) and xs.pop(), so far.
fn method(g: G, e: N) -> str {
  let recv = e.kids[0]
  if recv.kind == "Name" and (recv.kids[0].text == "Result" or recv.kids[0].text.starts_with("Result<")) and not has_local(g, recv.kids[0].text) {
    return construct_result(g, e)
  }
  if enum_name(g, e.kids[0]) != "" { return construct_case(g, e, enum_name(g, e.kids[0]), e.kids[1].text, e.kids[2].kids, e.kids[3].kids) }
  let t = gen_expr(g, e.kids[0])
  let name = e.kids[1].text
  let a = e.kids[2].kids
  if t == "str" { return str_method(g, e, name, a) }
  if t.starts_with("Result<") { return result_method(g, e, t, name, a) }
  struct_inst(g, t)
  if (t + "." + name) in g.fn_nodes {   # a struct's method: the value goes in first, as self
    push(g)
    return call_fn(g, e, t + "." + name, a, e.kids[3].kids, true)
  }
  if is_dict(t) and name == "get" and (len(a) == 1 or len(a) == 2) {
    let vt = dict_parts(t)[1]
    push(g)
    gen_expr(g, a[0])
    emit(g, "mov x1, x0")
    pop(g, "x0")
    if len(a) == 2 {   # get(k, default): the value, or the default
      push(g)
      push(g)
      emit(g, "bl pk_rt_dict_find")
      let missing = fresh(g)
      let done = fresh(g)
      emit(g, "tbnz x0, #63, " + missing)
      pop(g, "x1")
      pop(g, "x1")
      emit(g, "ldr x1, [x1, #8]")
      emit(g, "ldr x1, [x1, #16]")
      emit(g, "ldr x0, [x1, x0, lsl #3]")
      emit(g, "b " + done)
      place(g, missing)
      pop(g, "x1")
      pop(g, "x1")
      if gen_expr(g, a[1]) != vt { nope(e, "a default of another type") }
      place(g, done)
      return vt
    }
    push(g)
    emit(g, "bl pk_rt_dict_find")
    let missing = fresh(g)
    let done = fresh(g)
    emit(g, "tbnz x0, #63, " + missing)
    pop(g, "x1")
    emit(g, "ldr x1, [x1, #8]")
    emit(g, "ldr x1, [x1, #16]")
    emit(g, "ldr x0, [x1, x0, lsl #3]")
    if boxed(vt + "?") { emit(g, "bl pk_rt_box") }
    emit(g, "b " + done)
    place(g, missing)
    pop(g, "x1")
    emit(g, "mov x0, #0")
    place(g, done)
    return vt + "?"
  }
  if is_dict(t) and (name == "keys" or name == "values") and len(a) == 0 {   # a copy, in the order keys arrived
    if name == "keys" { emit(g, "ldr x0, [x0]") } else { emit(g, "ldr x0, [x0, #8]") }
    emit(g, "mov x1, #0")
    emit(g, "ldr x2, =4611686018427387904")
    emit(g, "bl pk_rt_list_slice")
    if name == "keys" { return "[" + dict_parts(t)[0] + "]" }
    return "[" + dict_parts(t)[1] + "]"
  }
  if name == "insert" and len(a) == 2 and is_list(t) and t != "[]" {   # before item i; a negative i counts from the end
    push(g)
    if gen_expr(g, a[0]) != "int" { nope(e, "insert() at anything but an int") }
    push(g)
    if not fits(gen_expr(g, a[1]), item_type(e, t)) { nope(e, "insert() of another type") }
    emit(g, "mov x2, x0")
    pop(g, "x1")
    pop(g, "x0")
    emit(g, "bl pk_rt_list_insert")
    return "void"
  }
  if name == "remove_at" and len(a) == 1 and is_list(t) and t != "[]" {   # takes item i out and gives it back
    push(g)
    if gen_expr(g, a[0]) != "int" { nope(e, "remove_at() of anything but an int") }
    emit(g, "mov x1, x0")
    pop(g, "x0")
    emit(g, "bl pk_rt_list_take")
    return item_type(e, t)
  }
  if (name == "reverse" or name == "reversed") and len(a) == 0 and is_list(t) {
    if name == "reversed" {
      emit(g, "mov x1, #0")
      emit(g, "ldr x2, =4611686018427387904")
      emit(g, "bl pk_rt_list_slice")
    }
    push(g)
    emit(g, "bl pk_rt_list_reverse")
    pop(g, "x0")
    if name == "reversed" { return t }
    return "void"
  }
  if name == "sum" and len(a) == 0 and (t == "[int]" or t == "[float]") {   # left to right from zero, as plank.py adds
    if t == "[int]" { emit(g, "bl pk_rt_list_sum_int") } else { emit(g, "bl pk_rt_list_sum_float") }
    return item_type(e, t)
  }
  if name == "index_of" and len(a) == 1 and is_list(t) and t != "[]" {   # where the first equal item is, or nil
    let item = item_type(e, t)
    push(g)
    if not fits(gen_expr(g, a[0]), item) { nope(e, "index_of() of another type") }
    emit(g, "mov x1, x0")
    pop(g, "x0")
    lit(g, "x2", item)
    emit(g, "bl pk_rt_list_index")
    let none_ = fresh(g)
    let done = fresh(g)
    emit(g, "tbnz x0, #63, " + none_)
    emit(g, "bl pk_rt_box")
    emit(g, "b " + done)
    place(g, none_)
    emit(g, "mov x0, #0")
    place(g, done)
    return "int?"
  }
  if (name == "first" or name == "last") and len(a) == 0 and is_list(t) and t != "[]" {   # the item, or nil when empty
    let item = item_type(e, t)
    let none_ = fresh(g)
    let done = fresh(g)
    emit(g, "ldr x1, [x0]")
    emit(g, "cbz x1, " + none_)
    if name == "last" { emit(g, "sub x1, x1, #1") } else { emit(g, "mov x1, #0") }
    emit(g, "ldr x0, [x0, #16]")
    emit(g, "ldr x0, [x0, x1, lsl #3]")
    if boxed(item + "?") { emit(g, "bl pk_rt_box") }
    emit(g, "b " + done)
    place(g, none_)
    emit(g, "mov x0, #0")
    place(g, done)
    return item + "?"
  }
  if is_dict(t) and name == "remove" and len(a) == 1 {
    push(g)
    if gen_expr(g, a[0]) != dict_parts(t)[0] { nope(e, "remove of a key of another type") }
    emit(g, "mov x1, x0")
    pop(g, "x0")
    emit(g, "bl pk_rt_dict_remove")
    return "void"
  }
  if (name == "min" or name == "max") and len(a) == 0 and is_list(t) and t != "[]" {   # the item, or nil when empty
    let item = item_type(e, t)
    var kind = 0
    if item == "float" { kind = 1 } else if item == "str" { kind = 2 } else if item != "int" { nope(e, name + "() of a " + t) }
    push(g)
    emit(g, "mov x1, #" + str(kind))
    if name == "max" { emit(g, "mov x2, #1") } else { emit(g, "mov x2, #0") }
    emit(g, "bl pk_rt_list_pick")
    let none_ = fresh(g)
    let done = fresh(g)
    pop(g, "x1")
    emit(g, "tbnz x0, #63, " + none_)
    emit(g, "ldr x1, [x1, #16]")
    emit(g, "ldr x0, [x1, x0, lsl #3]")
    if boxed(item + "?") { emit(g, "bl pk_rt_box") }
    emit(g, "b " + done)
    place(g, none_)
    emit(g, "mov x0, #0")
    place(g, done)
    return item + "?"
  }
  if t == "[str]" and name == "join" and len(a) == 1 {
    push(g)
    gen_expr(g, a[0])
    emit(g, "mov x1, x0")
    pop(g, "x0")
    emit(g, "bl pk_rt_join")
    return "str"
  }
  if not is_list(t) { nope(e, "the method \(name) on \(t)") }
  if name == "append" and len(a) == 1 {
    push(g)
    let v = gen_expr(g, a[0])
    if t != "[]" and v != item_type(e, t) { nope(e, "appending a \(v) to a \(t)") }
    emit(g, "mov x1, x0")
    pop(g, "x0")
    emit(g, "bl pk_rt_list_push")
    return "void"
  }
  if (name == "map" or name == "filter") and len(a) == 1 {
    let item = item_type(e, t)
    push(g)
    if name == "map" { g.expect = "fn(" + item + ") -> " } else { g.expect = "fn(" + item + ") -> bool" }
    let ft = gen_expr(g, a[0])
    g.expect = ""
    emit(g, "mov x1, x0")
    pop(g, "x0")
    if name == "filter" {
      emit(g, "bl pk_rt_filter")
      return t
    }
    emit(g, "bl pk_rt_map")
    return "[" + fn_ret(ft) + "]"
  }
  if name == "reduce" and len(a) == 2 {
    let item = item_type(e, t)
    push(g)
    let at = gen_expr(g, a[0])
    push(g)
    g.expect = "fn(" + at + ", " + item + ") -> " + at
    gen_expr(g, a[1])
    g.expect = ""
    emit(g, "mov x2, x0")
    pop(g, "x1")
    pop(g, "x0")
    emit(g, "bl pk_rt_reduce")
    return at
  }
  if (name == "sorted" or name == "sort") and len(a) <= 1 {
    let item = item_type(e, t)
    push(g)
    if len(a) == 1 {
      if e.kids[3].kids[0].kind != "S" or e.kids[3].kids[0].text != "by" { nope(e, name + " with anything but by:") }
      g.expect = "fn(" + item + ", " + item + ") -> bool"
      gen_expr(g, a[0])
      g.expect = ""
    } else if item == "int" {
      emit(g, "bl pk_rt_int_before")   # the closure that orders ints, from rt.pk
    } else if item == "str" {
      emit(g, "bl pk_rt_str_before")
    } else {
      nope(e, name + "() of a [" + item + "] without by:")
    }
    emit(g, "mov x1, x0")
    pop(g, "x0")
    if name == "sort" {   # in place
      emit(g, "bl pk_rt_sort")
      return "void"
    }
    emit(g, "bl pk_rt_sorted")
    return t
  }
  if name == "pop" and len(a) == 0 {
    emit(g, "bl pk_rt_list_pop")
    return item_type(e, t)
  }
  nope(e, "the list method " + name)
  return ""
}

# A string with \( ) in it: each part made a string and joined on, left to right.
fn interp(g: G, e: N) -> str {
  let parts = e.kids[0].kids
  gen_expr(g, parts[0])
  for i in 1..len(parts) {
    push(g)
    to_str(g, parts[i], gen_expr(g, parts[i]))
    emit(g, "mov x1, x0")
    pop(g, "x0")
    emit(g, "bl pk_rt_concat")
  }
  return "str"
}

# The built-ins: len and str for programs, and the ones rt.pk is written with (plank.py does not have those).
# ---------------------------------------------------------------- floats (6.76.0)
# A float is its 64 bits in x0, like every other value; it moves to d0 and d1 only for an instruction that needs them.
fn fop(g: G, ins: str, two: bool) {
  emit(g, "fmov d0, x0")
  if two { emit(g, "fmov d1, x1") }
  emit(g, ins)
  emit(g, "fmov x0, d0")
}

# x0 op x1, both floats. Compares are ordered, as plank.py's: anything with nan is false, != too.
fn float_op(g: G, e: N, op: str) -> str {
  let ins = ["+": "fadd", "-": "fsub", "*": "fmul", "/": "fdiv"]
  if op in ins {
    fop(g, ins[op] + " d0, d0, d1", true)
    return "float"
  }
  let conds = ["<": "mi", "<=": "ls", ">": "gt", ">=": "ge", "==": "eq"]
  emit(g, "fmov d0, x0")
  emit(g, "fmov d1, x1")
  emit(g, "fcmp d0, d1")
  if op in conds {
    emit(g, "cset x0, " + conds[op])
    return "bool"
  }
  if op == "!=" {   # less or greater: an unordered pair is neither
    emit(g, "cset x0, mi")
    emit(g, "cset x1, gt")
    emit(g, "add x0, x0, x1")
    return "bool"
  }
  nope(e, "\(op) on floats")
  return ""
}

# A float literal, exactly as IEEE rounds it: its digits as an int, scaled by one multiply or divide by an exact power
# of ten (Clinger's fast path). Both are exact up to 15 digits and 10^22, so one rounding gives the nearest double, the
# same in every build of plankc; anything past that stops here.
fn float_lit(g: G, e: N, text: str) -> str {
  if "_" in text { nope(e, "the float " + text) }
  var mant = text
  var exp = 0
  let at = mant.find("e") ?? (mant.find("E") ?? -1)
  if at >= 0 {
    var es = mant[at + 1..]
    if es.starts_with("+") { es = es[1..] }
    exp = int(es)
    mant = mant[..at]
  }
  let dot = mant.find(".") ?? -1
  if dot >= 0 {
    exp -= len(mant) - dot - 1
    mant = mant[..dot] + mant[dot + 1..]
  }
  while len(mant) > 1 and mant.starts_with("0") { mant = mant[1..] }
  while len(mant) > 1 and mant.ends_with("0") {
    mant = mant[..len(mant) - 1]
    exp += 1
  }
  if mant == "0" { exp = 0 }
  if len(mant) > 15 or exp > 22 or exp < -22 { nope(e, "the float " + text) }
  emit(g, "ldr x0, =" + mant)
  emit(g, "scvtf d0, x0")
  if exp != 0 {
    var k = exp
    if k < 0 { k = 0 - k }
    var p = 1
    var rest = 0
    for i in 0..k {
      if i < 18 { p = p * 10 } else { rest += 1 }
    }
    emit(g, "ldr x1, =" + str(p))
    emit(g, "scvtf d1, x1")
    if rest > 0 {   # 10^19 to 10^22 pass an int: 10^18 then 10^rest, still exact
      var q = 1
      for i in 0..rest { q = q * 10 }
      emit(g, "ldr x2, =" + str(q))
      emit(g, "scvtf d2, x2")
      emit(g, "fmul d1, d1, d2")
    }
    if exp > 0 { emit(g, "fmul d0, d0, d1") } else { emit(g, "fdiv d0, d0, d1") }
  }
  emit(g, "fmov x0, d0")
  return "float"
}

fn builtin(g: G, e: N, name: str, a: [N]) -> str {
  if name == "len" and len(a) == 1 {
    let t = gen_expr(g, a[0])
    if t == "str" and g.bytes {
      emit(g, "ldur x0, [x0, #-8]")
    } else if t == "str" {   # characters, as Plank counts them (6.78.0)
      emit(g, "bl pk_rt_clen")
    } else if is_list(t) {
      emit(g, "ldr x0, [x0]")
    } else if is_dict(t) {
      emit(g, "ldr x0, [x0]")
      emit(g, "ldr x0, [x0]")
    } else {
      nope(e, "len of a " + t)
    }
    return "int"
  }
  if name == "str" and len(a) == 1 {
    to_str(g, e, gen_expr(g, a[0]))
    return "str"
  }
  if name == "int" and len(a) == 1 {
    let t = gen_expr(g, a[0])
    if t == "str" {
      emit(g, "bl pk_rt_parse_int")
    } else if t == "float" {
      emit(g, "fmov d0, x0")
      emit(g, "fcvtzs x0, d0")
    } else if t != "int" {
      nope(e, "int() of a " + t)
    }
    return "int"
  }
  if name == "float" and len(a) == 1 {
    let t = gen_expr(g, a[0])
    if t == "int" {
      emit(g, "scvtf d0, x0")
      emit(g, "fmov x0, d0")
    } else if t == "str" {
      emit(g, "bl pk_rt_parse_float")
    } else if t != "float" {
      nope(e, "float() of a " + t)
    }
    return "float"
  }
  if name == "pow" and len(a) == 2 {   # floats; an exponent that is a whole number (6.77.0)
    if gen_expr(g, a[0]) != "float" { nope(e, "pow() of anything but floats") }
    push(g)
    if gen_expr(g, a[1]) != "float" { nope(e, "pow() of anything but floats") }
    emit(g, "mov x1, x0")
    pop(g, "x0")
    emit(g, "bl pk_rt_pow")
    return "float"
  }
  if name == "fixed" and len(a) == 2 {   # x with exactly that many digits after the point (6.77.0)
    if gen_expr(g, a[0]) != "float" { nope(e, "fixed() of anything but a float") }
    push(g)
    if gen_expr(g, a[1]) != "int" { nope(e, "fixed() with digits that are not an int") }
    emit(g, "mov x1, x0")
    pop(g, "x0")
    emit(g, "bl pk_rt_fixed")
    return "str"
  }
  let fn1 = ["sqrt": 1, "floor": 1, "ceil": 1, "round": 1]
  if name in fn1 and len(a) == 1 {
    if gen_expr(g, a[0]) != "float" { nope(e, name + "() of anything but a float") }
    let ops = ["sqrt": "fsqrt", "floor": "frintm", "ceil": "frintp", "round": "frinta"]   # round: half away from zero, as C's
    fop(g, ops[name] + " d0, d0", false)
    return "float"
  }
  if name == "abs" and len(a) == 1 {
    let t = gen_expr(g, a[0])
    if t == "float" {
      fop(g, "fabs d0, d0", false)
    } else if t == "int" {
      emit(g, "cmp x0, #0")
      emit(g, "cneg x0, x0, lt")
    } else {
      nope(e, "abs() of a " + t)
    }
    return t
  }
  if (name == "min" or name == "max") and len(a) == 2 {   # x < y ? x : y, as plank.py picks (a tie or a nan gives y)
    let t = gen_expr(g, a[0])
    push(g)
    if gen_expr(g, a[1]) != t or (t != "int" and t != "float") { nope(e, name + "() of two that are not one number type") }
    emit(g, "mov x1, x0")
    pop(g, "x0")
    var c = "lt"
    if name == "max" { c = "gt" }
    if t == "float" {
      emit(g, "fmov d0, x0")
      emit(g, "fmov d1, x1")
      emit(g, "fcmp d0, d1")
      if name == "min" { c = "mi" }
    } else {
      emit(g, "cmp x0, x1")
    }
    emit(g, "csel x0, x0, x1, " + c)
    return t
  }
  if name == "args" and len(a) == 0 {
    emit(g, "bl pk_rt_args")
    return "[str]"
  }
  if name == "read_file" and len(a) == 1 {
    if gen_expr(g, a[0]) != "str" { nope(e, "read_file of anything but a path") }
    emit(g, "bl pk_rt_read_file")
    return "str?"
  }
  if name == "write_file" and len(a) == 2 {
    gen_expr(g, a[0])
    push(g)
    if gen_expr(g, a[1]) != "str" { nope(e, "write_file of anything but a string") }
    emit(g, "mov x1, x0")
    pop(g, "x0")
    emit(g, "bl pk_rt_write_file")
    return "bool"
  }
  if name == "exit" and len(a) == 1 {
    gen_expr(g, a[0])
    emit(g, "mov x1, x0")
    emit(g, "mov x0, #1")   # JT_SYS_EXIT
    emit(g, "mov x8, x0")
    emit(g, "mov x0, x1")
    emit(g, "svc #0")
    return "void"
  }
  if not (name in g.rt) { nope(e, "calling \(name)") }
  if name == "global" {
    if len(a) != 1 or a[0].kind != "Num" { nope(e, "global() of anything but a number") }
    emit(g, "adrp x0, pk_globals")
    emit(g, "add x0, x0, :lo12:pk_globals")
    emit(g, "add x0, x0, #" + str(int(a[0].kids[0].text) * 8))
    return "int"
  }
  for x in a {
    gen_expr(g, x)
    push(g)
  }
  var i = len(a) - 1
  while i >= 0 {
    pop(g, "x" + str(i))
    i -= 1
  }
  if name == "stack_pointer" {
    emit(g, "mov x0, sp")
    return "int"
  }
  if name == "syscall" {
    emit(g, "mov x8, x0")
    emit(g, "mov x0, x1")
    emit(g, "mov x1, x2")
    emit(g, "mov x2, x3")
    emit(g, "svc #0")
    return "int"
  }
  if name == "peek" { emit(g, "ldr x0, [x0]") }
  if name == "peek8" { emit(g, "ldrb w0, [x0]") }
  if name == "poke" { emit(g, "str x1, [x0]") }
  if name == "poke8" { emit(g, "strb w1, [x0]") }
  if name == "as_str" { return "str" }
  if name == "as_float" { return "float" }
  if name == "fma" {   # a * b + c, rounded once: rt.pk's exact digits read a product's rounding error from it
    emit(g, "fmov d0, x0")
    emit(g, "fmov d1, x1")
    emit(g, "fmov d2, x2")
    emit(g, "fmadd d0, d0, d1, d2")
    emit(g, "fmov x0, d0")
    return "float"
  }
  return "int"
}

# x0 (or r) gets the address of a string literal's bytes.
fn lit(g: G, r: str, s: str) {
  let l = str_label(g, s)
  emit(g, "adrp \(r), " + l)
  emit(g, "add \(r), \(r), :lo12:" + l)
}

# The label of a string literal, added to .rodata the first time it is used.
fn str_label(g: G, s: str) -> str {
  for i in 0..len(g.strs) {
    if g.strs[i] == s { return ".Ls" + str(i) }
  }
  g.strs.append(s)
  return ".Ls" + str(len(g.strs) - 1)
}

# ---------------------------------------------------------------- statements
fn gen_block(g: G, b: N) {
  let mark = len(g.locals)
  for s in b.kids { gen_stmt(g, s) }
  while len(g.locals) > mark { g.locals.pop() }
}

fn gen_stmt(g: G, s: N) {
  if s.kind == "Let" {
    var t = gen_expr(g, s.kids[2])
    if s.kids[1].kind != "_" {
      let said = int_type(s, s.kids[1].text)
      if not fits(t, said) { nope(s, "a \(t) where \(said) was written") }
      coerce(g, t, said)
      t = said
    }
    if t == "[]" or t == "nil" { nope(s, "a \(t) with no type: write let x: T = ...") }
    store(g, new_local(g, s.kids[0].text, int_type(s, t)))
  } else if s.kind == "Assign" and s.kids[0].kind == "Index" and is_dict(type_of(g, s.kids[0].kids[0])) {
    let target = s.kids[0]
    gen_expr(g, target.kids[0])
    push(g)
    gen_expr(g, target.kids[1])
    push(g)
    gen_expr(g, s.kids[1])
    emit(g, "mov x2, x0")
    pop(g, "x1")
    pop(g, "x0")
    emit(g, "bl " + dict_setter(dict_parts(type_of(g, target.kids[0]))[0]))
  } else if s.kind == "Assign" and s.kids[0].kind == "Index" {
    let target = s.kids[0]
    gen_expr(g, target.kids[0])
    push(g)
    gen_expr(g, target.kids[1])
    emit(g, "mov x1, x0")
    pop(g, "x0")
    emit(g, "bl pk_rt_list_at")
    push(g)
    gen_expr(g, s.kids[1])
    pop(g, "x1")
    emit(g, "str x0, [x1]")
  } else if s.kind == "LetTuple" {   # let (q, r) = divmod(17, 5)
    let t = gen_expr(g, s.kids[1])
    if not t.starts_with("(") { nope(s, "taking apart a " + t) }
    let parts = tuple_parts(t)
    let names = s.kids[0].kids
    if len(names) != len(parts) { nope(s, "\(len(names)) names for \(len(parts)) parts") }
    let tmp = new_local(g, " tuple", t)
    store(g, tmp)
    for i in 0..len(names) {
      load(g, tmp)
      emit(g, "ldr x0, [x0, #" + str(i * 8) + "]")
      store(g, new_local(g, names[i].text, parts[i]))
    }
  } else if s.kind == "Assign" and s.kids[0].kind == "Field" {
    let target = s.kids[0]
    let f = field(g, s, gen_expr(g, target.kids[0]), target.kids[1].text)
    push(g)
    gen_expr(g, s.kids[1])
    pop(g, "x1")
    emit(g, "str x0, [x1, #\(f.off)]")
  } else if s.kind == "Assign" {
    if s.kids[0].kind != "Name" { nope(s, "assigning to " + s.kids[0].kind) }
    gen_expr(g, s.kids[1])
    store(g, find(g, s.kids[0].kids[0].text))
  } else if s.kind == "ExprStmt" {
    gen_expr(g, s.kids[0])
  } else if s.kind == "Return" {
    if s.kids[0].kind != "_" {
      let t = gen_expr(g, s.kids[0])
      if g.ret_type == "" { g.ret_type = t }   # a lambda with no -> takes its first return's type
      if g.ret_type != "void" and not fits(t, g.ret_type) { nope(s, "returning a \(t) from a function that gives \(g.ret_type)") }
      coerce(g, t, g.ret_type)
    }
    leave_tries(g, 0)
    emit(g, "b " + g.ret)
  } else if s.kind == "If" {
    let other = fresh(g)
    let done = fresh(g)
    gen_expr(g, s.kids[0])
    emit(g, "cbz x0, " + other)
    gen_block(g, s.kids[1])
    emit(g, "b " + done)
    place(g, other)
    gen_block(g, s.kids[2])
    place(g, done)
  } else if s.kind == "Match" {
    gen_match(g, s, false)
  } else if s.kind == "IfLet" {
    let other = fresh(g)
    let done = fresh(g)
    let t = gen_expr(g, s.kids[1])
    if not is_opt(t) { nope(s, "if let on a \(t), which is never nil") }
    emit(g, "cbz x0, " + other)
    if boxed(t) { emit(g, "ldr x0, [x0]") }
    let mark = len(g.locals)
    store(g, new_local(g, s.kids[0].text, t[..len(t) - 1]))
    gen_block(g, s.kids[2])
    while len(g.locals) > mark { g.locals.pop() }
    emit(g, "b " + done)
    place(g, other)
    gen_block(g, s.kids[3])
    place(g, done)
  } else if s.kind == "WhileLet" {   # while let x = e: the body while e is not nil, x its value (6.77.0)
    let top = fresh(g)
    let done = fresh(g)
    place(g, top)
    let t = gen_expr(g, s.kids[1])
    if not is_opt(t) { nope(s, "while let on a \(t), which is never nil") }
    emit(g, "cbz x0, " + done)
    if boxed(t) { emit(g, "ldr x0, [x0]") }
    let mark = len(g.locals)
    store(g, new_local(g, s.kids[0].text, t[..len(t) - 1]))
    g.loops.append(done)
    g.loops.append(top)
    g.loop_tries.append(len(g.tries))
    gen_block(g, s.kids[2])
    g.loops.pop()
    g.loops.pop()
    g.loop_tries.pop()
    while len(g.locals) > mark { g.locals.pop() }
    emit(g, "b " + top)
    place(g, done)
  } else if s.kind == "While" {
    let top = fresh(g)
    let done = fresh(g)
    place(g, top)
    gen_expr(g, s.kids[0])
    emit(g, "cbz x0, " + done)
    g.loops.append(done)
    g.loops.append(top)
    g.loop_tries.append(len(g.tries))
    gen_block(g, s.kids[1])
    g.loops.pop()
    g.loops.pop()
    g.loop_tries.pop()
    emit(g, "b " + top)
    place(g, done)
  } else if s.kind == "For" {
    let mark = len(g.locals)
    gen_expr(g, s.kids[1])
    let i = new_local(g, s.kids[0].text, "int")
    store(g, i)
    gen_expr(g, s.kids[2])
    let stop = new_local(g, " stop", "int")
    store(g, stop)
    let top = fresh(g)
    let step = fresh(g)
    let done = fresh(g)
    place(g, top)
    load(g, i)
    slot(g, "ldr", "x1", stop.off)
    emit(g, "cmp x0, x1")
    emit(g, "b.ge " + done)
    g.loops.append(done)
    g.loops.append(step)
    g.loop_tries.append(len(g.tries))
    gen_block(g, s.kids[3])
    g.loops.pop()
    g.loops.pop()
    g.loop_tries.pop()
    place(g, step)
    load(g, i)
    emit(g, "add x0, x0, #1")
    store(g, i)
    emit(g, "b " + top)
    place(g, done)
    while len(g.locals) > mark { g.locals.pop() }
  } else if s.kind == "ForIn" {
    # for x in xs, or for i, x in xs: the list and a count in hidden locals.
    let mark = len(g.locals)
    var t = gen_expr(g, s.kids[1])
    if t == "str" {   # a string's characters (6.77.0)
      emit(g, "bl pk_rt_chars")
      t = "[str]"
    }
    if is_dict(t) and s.kids[3].kind != "_" {   # for k, v in d: each key with its value, in order (6.77.0)
      let d = new_local(g, " d", t)
      store(g, d)
      let i = new_local(g, " i", "int")
      emit(g, "mov x0, #0")
      store(g, i)
      let k = new_local(g, s.kids[0].text, "str")
      let v = new_local(g, s.kids[3].text, dict_parts(t)[1])
      let top = fresh(g)
      let step = fresh(g)
      let done = fresh(g)
      place(g, top)
      load(g, d)
      emit(g, "ldr x0, [x0]")
      emit(g, "ldr x1, [x0]")
      load(g, i)
      emit(g, "cmp x0, x1")
      emit(g, "b.ge " + done)
      for pair in [(0, k), (8, v)] {
        load(g, d)
        emit(g, "ldr x0, [x0, #" + str(pair.0) + "]")
        emit(g, "ldr x1, [x0, #16]")
        load(g, i)
        emit(g, "ldr x0, [x1, x0, lsl #3]")
        store(g, pair.1)
      }
      g.loops.append(done)
      g.loops.append(step)
      g.loop_tries.append(len(g.tries))
      gen_block(g, s.kids[2])
      g.loops.pop()
      g.loops.pop()
      g.loop_tries.pop()
      place(g, step)
      load(g, i)
      emit(g, "add x0, x0, #1")
      store(g, i)
      emit(g, "b " + top)
      place(g, done)
      emit(g, "mov x0, #0")
      store(g, d)
      store(g, k)
      store(g, v)
      while len(g.locals) > mark { g.locals.pop() }
      return
    }
    if is_dict(t) {   # a dict's keys, in order
      emit(g, "ldr x0, [x0]")
      t = "[" + dict_parts(t)[0] + "]"
    }
    let item = item_type(s, t)
    let xs = new_local(g, " xs", t)
    store(g, xs)
    var idx = new_local(g, " i", "int")
    var name = s.kids[0].text
    if s.kids[3].kind != "_" {
      idx = new_local(g, s.kids[0].text, "int")
      name = s.kids[3].text
    }
    emit(g, "mov x0, #0")
    store(g, idx)
    let x = new_local(g, name, item)
    let top = fresh(g)
    let step = fresh(g)
    let done = fresh(g)
    place(g, top)
    load(g, xs)
    emit(g, "ldr x1, [x0]")
    load(g, idx)
    emit(g, "cmp x0, x1")
    emit(g, "b.ge " + done)
    load(g, xs)
    emit(g, "ldr x1, [x0, #16]")
    load(g, idx)
    emit(g, "ldr x0, [x1, x0, lsl #3]")
    store(g, x)
    g.loops.append(done)
    g.loops.append(step)
    g.loop_tries.append(len(g.tries))
    gen_block(g, s.kids[2])
    g.loops.pop()
    g.loops.pop()
    g.loop_tries.pop()
    place(g, step)
    load(g, idx)
    emit(g, "add x0, x0, #1")
    store(g, idx)
    emit(g, "b " + top)
    place(g, done)
    emit(g, "mov x0, #0")   # the loop is over: its hidden list and its item no longer hold anything for the collector
    store(g, xs)
    store(g, x)
    while len(g.locals) > mark { g.locals.pop() }
  } else if s.kind == "Try" {
    let landing = fresh(g)
    let done = fresh(g)
    let base = open_try(g, landing)
    g.tries.append(base)
    gen_block(g, s.kids[0])
    g.tries.pop()
    pop_try(g, base)
    emit(g, "b " + done)
    place(g, landing)   # throw lands here with x29 and sp back, and the message in x0
    pop_try(g, base)
    let mark = len(g.locals)
    store(g, new_local(g, s.kids[1].text, "str"))
    gen_block(g, s.kids[2])
    while len(g.locals) > mark { g.locals.pop() }
    place(g, done)
  } else if s.kind == "Throw" {
    if gen_expr(g, s.kids[0]) != "str" { nope(s, "throwing anything but a string") }
    let caught = fresh(g)
    emit(g, "adrp x1, pk_globals")
    emit(g, "add x1, x1, :lo12:pk_globals")
    emit(g, "ldr x1, [x1, #16]")
    emit(g, "cbnz x1, " + caught)
    if g.bytes { emit(g, "mov x1, #0") } else { emit(g, "ldr x1, =\(s.line)") }   # rt.pk's own: just the message (6.80.0)
    emit(g, "bl pk_rt_uncaught")
    place(g, caught)
    emit(g, "ldr x29, [x1, #8]")
    emit(g, "ldr x2, [x1, #16]")
    emit(g, "mov sp, x2")
    emit(g, "ldr x2, [x1, #24]")
    emit(g, "br x2")
  } else if s.kind == "Break" or s.kind == "Continue" {
    if len(g.loops) == 0 { throw "\(s.line): \(s.kind) outside a loop" }
    leave_tries(g, g.loop_tries[-1])
    if s.kind == "Break" { emit(g, "b " + g.loops[-2]) } else { emit(g, "b " + g.loops[-1]) }
  } else {
    nope(s, "the statement " + s.kind)
  }
}

# Every local a function makes, so its frame can be sized before its code is written.
fn count_locals(n: N) -> int {
  var c = 0
  if n.kind == "Let" { c = 1 }
  if n.kind == "LetTuple" { c = 1 + len(n.kids[0].kids) }
  if n.kind == "For" { c = 2 }
  if n.kind == "ForIn" { c = 4 }
  if n.kind == "IfLet" or n.kind == "WhileLet" or n.kind == "IfLetExpr" { c = 1 }
  if n.kind == "Try" { c = 5 }
  if n.kind == "Call" and n.kids[0].text == "attempt" { c = 5 }   # its try's record and its result (6.80.0)
  if n.kind == "Match" { c = 1 + 8 * len(n.kids[1].kids) }   # the subject and each arm's bindings, generously
  for k in n.kids { c += count_locals(k) }
  return c
}

fn function(g: G, f: N) {
  let name = f.kids[0].text
  let params = f.kids[1].kids
  g.ret_type = f.kids[2].text
  g.bytes = name.starts_with("rt_")
  if len(params) > 8 { nope(f, "more than eight parameters") }
  if len(f.kids[5].kids) > 0 { nope(f, "type parameters") }
  g.locals = []
  g.tries = []
  g.next_off = 0
  g.ret = fresh(g)
  g.boxed_names = captured_names(f.kids[3])
  let frame = (len(params) + count_locals(f.kids[3])) * 8
  g.out.append("")
  g.out.append("  .globl pk_" + sym(name))
  g.out.append("  .p2align 2")
  place(g, "pk_" + sym(name))
  emit(g, "stp x29, x30, [sp, #-16]!")
  emit(g, "mov x29, sp")
  emit(g, "sub sp, sp, #" + str((frame + 15) / 16 * 16))
  let ps: [Local] = []
  for i in 0..len(params) {
    let l = raw_local(g, params[i].kids[0].text, int_type(f, params[i].kids[1].text))
    slot(g, "str", "x" + str(i), l.off)
    ps.append(l)
  }
  box_params(g, ps)
  gen_block(g, f.kids[3])
  emit(g, "mov x0, #0")   # falling off the end returns 0, which is what main hands back
  place(g, g.ret)
  emit(g, "mov sp, x29")
  emit(g, "ldp x29, x30, [sp], #16")
  emit(g, "ret")
  emit(g, ".ltorg")
}

# The type of e, worked out by writing its code into a scratch buffer that is then dropped.
fn type_of(g: G, e: N) -> str {
  let mark = len(g.out)
  let t = gen_expr(g, e)
  while len(g.out) > mark { g.out.pop() }
  return t
}

# ---------------------------------------------------------------- closures (6.75.0)
# A closure is the address of {its code, its environment}; the environment holds the cells of the locals it captured.
# A lambda is written as a function of its own, taking the environment first; a named function used as a value gets a
# trampoline that drops the environment and jumps to it.

fn fn_parts(ty: str) -> [str] {   # fn(int, str) -> bool as ["int", "str"], its parameters
  let close = ty.find(") -> ") ?? (len(ty) - 1)
  if close == 3 { return [] }
  return tuple_parts(ty[2..close + 1])
}

fn fn_ret(ty: str) -> str {
  let at = ty.find(") -> ") ?? 0
  return ty[at + 5..]
}

# Every name a lambda in body refers to that it does not declare itself: those locals get cells.
fn captured_names(body: N) -> [str: int] {
  let out: [str: int] = [:]
  find_lambdas(body, out)
  return out
}

fn find_lambdas(n: N, out: [str: int]) {
  if n.kind == "Lambda" {
    let declared: [str: int] = [:]
    for p in n.kids[0].kids { declared[p.kids[0].text] = 1 }
    declarations(n.kids[2], declared)
    let used: [str: int] = [:]
    names_in(n.kids[2], used)
    for k in used {
      if not (k in declared) { out[k] = 1 }
    }
  }
  for k in n.kids { find_lambdas(k, out) }
}

fn declarations(n: N, out: [str: int]) {
  if n.kind == "Let" or n.kind == "For" or n.kind == "ForIn" or n.kind == "IfLet" or n.kind == "WhileLet" { out[n.kids[0].text] = 1 }
  if n.kind == "ForIn" and n.kids[3].kind == "S" { out[n.kids[3].text] = 1 }
  if n.kind == "Try" { out[n.kids[1].text] = 1 }
  if n.kind == "LetTuple" {
    for k in n.kids[0].kids { out[k.text] = 1 }
  }
  if n.kind == "Lambda" { return }   # a nested lambda's own names are its business
  for k in n.kids { declarations(k, out) }
}

fn names_in(n: N, out: [str: int]) {
  if n.kind == "Name" or n.kind == "Call" { out[n.kids[0].text] = 1 }
  for k in n.kids { names_in(k, out) }
}

# Parameters a closure captures get their cells after the prologue has stored them.
fn box_params(g: G, ps: [Local]) {
  for l in ps {
    if l.boxed {
      slot(g, "ldr", "x0", l.off)
      emit(g, "bl pk_rt_box")
      slot(g, "str", "x0", l.off)
    }
  }
}

fn gen_lambda(g: G, e: N) -> str {
  let expect = g.expect
  g.expect = ""
  let params = e.kids[0].kids
  let want = fn_parts(expect)
  let ptypes: [str] = []
  for i in 0..len(params) {
    if params[i].kids[1].kind == "S" {
      ptypes.append(int_type(e, params[i].kids[1].text))
    } else if i < len(want) {
      ptypes.append(want[i])
    } else {
      nope(e, "a lambda parameter with no type and nowhere to learn it")
    }
  }
  # what it captures: free names that are locals here (their cells go in the environment)
  let declared: [str: int] = [:]
  for p in params { declared[p.kids[0].text] = 1 }
  declarations(e.kids[2], declared)
  let used: [str: int] = [:]
  names_in(e.kids[2], used)
  let caps: [Local] = []
  for k in used {
    if not (k in declared) and has_local(g, k) {
      let l = find(g, k)
      if not l.boxed { nope(e, "capturing \(k), which has no cell") }
      caps.append(l)
    }
  }
  emit(g, "mov x0, #" + str(len(caps) * 8 + 8))
  emit(g, "bl pk_rt_alloc")
  push(g)
  for i in 0..len(caps) {
    slot(g, "ldr", "x0", caps[i].off)   # the cell itself, not what it holds
    emit(g, "ldr x1, [sp]")
    emit(g, "str x0, [x1, #" + str(i * 8) + "]")
  }
  # the lambda's own function, written now into its own buffer
  g.lambda_n += 1
  let label = "pk_lambda_" + str(g.lambda_n)
  let saved_out = g.out
  let saved_locals = g.locals
  let saved_tries = g.tries
  let saved_loops = g.loops
  let saved_lt = g.loop_tries
  let saved_off = g.next_off
  let saved_ret = g.ret
  let saved_rt = g.ret_type
  let saved_boxed = g.boxed_names
  g.out = []
  g.locals = []
  g.tries = []
  g.loops = []
  g.loop_tries = []
  g.next_off = 0
  g.ret = fresh(g)
  g.ret_type = ""
  if e.kids[1].kind == "S" { g.ret_type = int_type(e, e.kids[1].text) }
  g.boxed_names = captured_names(e.kids[2])
  let frame = (1 + len(params) + len(caps) + count_locals(e.kids[2])) * 8
  g.out.append("")
  g.out.append("  .p2align 2")
  place(g, label)
  emit(g, "stp x29, x30, [sp, #-16]!")
  emit(g, "mov x29, sp")
  emit(g, "sub sp, sp, #" + str((frame + 15) / 16 * 16))
  let env = raw_local(g, " env", "int")
  slot(g, "str", "x0", env.off)
  let ps: [Local] = []
  for i in 0..len(params) {
    let l = raw_local(g, params[i].kids[0].text, ptypes[i])
    slot(g, "str", "x" + str(i + 1), l.off)
    ps.append(l)
  }
  box_params(g, ps)
  for i in 0..len(caps) {   # the captured cells, from the environment into boxed locals of their own
    g.next_off += 8
    let l = Local(caps[i].name, g.next_off, caps[i].ty, true)
    g.locals.append(l)
    slot(g, "ldr", "x0", env.off)
    emit(g, "ldr x0, [x0, #" + str(i * 8) + "]")
    slot(g, "str", "x0", l.off)
  }
  gen_block(g, e.kids[2])
  emit(g, "mov x0, #0")
  place(g, g.ret)
  emit(g, "mov sp, x29")
  emit(g, "ldp x29, x30, [sp], #16")
  emit(g, "ret")
  var ret = g.ret_type
  if ret == "" { ret = "void" }
  for l in g.out { g.lambda_code.append(l) }
  g.out = saved_out
  g.locals = saved_locals
  g.tries = saved_tries
  g.loops = saved_loops
  g.loop_tries = saved_lt
  g.next_off = saved_off
  g.ret = saved_ret
  g.ret_type = saved_rt
  g.boxed_names = saved_boxed
  # the closure: {code, env}
  emit(g, "mov x0, #24")
  emit(g, "bl pk_rt_alloc")
  pop(g, "x1")
  emit(g, "str x1, [x0, #8]")
  emit(g, "adr x1, " + label)
  emit(g, "str x1, [x0]")
  return "fn(" + ptypes.join(", ") + ") -> " + ret
}

# A named function as a value: a closure whose code is a trampoline that drops the environment and jumps to it.
fn fn_value(g: G, e: N, name: str) -> str {
  let f = g.fn_nodes[name]
  let params = f.kids[1].kids
  if not (name in g.tramps) {
    g.tramps[name] = 1
    g.lambda_code.append("")
    g.lambda_code.append("  .p2align 2")
    g.lambda_code.append("pk_" + sym(name) + "__fn:")
    for i in 0..len(params) { g.lambda_code.append("mov x" + str(i) + ", x" + str(i + 1)) }
    g.lambda_code.append("b pk_" + sym(name))
  }
  let ps: [str] = []
  for p in params { ps.append(int_type(e, p.kids[1].text)) }
  emit(g, "mov x0, #24")
  emit(g, "bl pk_rt_alloc")
  emit(g, "adr x1, pk_" + sym(name) + "__fn")
  emit(g, "str x1, [x0]")
  emit(g, "str xzr, [x0, #8]")
  return "fn(" + ps.join(", ") + ") -> " + f.kids[2].text
}

# Calling a closure: its environment first, then the arguments; blr to its code.
fn call_value(g: G, e: N, target: N, a: [N]) -> str {
  let t = gen_expr(g, target)
  if not t.starts_with("fn(") { nope(e, "calling a " + t) }
  let ps = fn_parts(t)
  if len(a) != len(ps) { nope(e, "\(len(a)) arguments for \(len(ps))") }
  if len(a) > 7 { nope(e, "more than seven arguments to a closure") }
  push(g)
  for i in 0..len(a) {
    if ps[i].starts_with("fn(") { g.expect = ps[i] }
    let at = gen_expr(g, a[i])
    g.expect = ""
    if not fits(at, ps[i]) { nope(e, "a \(at) for a \(ps[i])") }
    coerce(g, at, ps[i])
    push(g)
  }
  var i = len(a)
  while i >= 1 {
    pop(g, "x" + str(i))
    i -= 1
  }
  pop(g, "x9")
  emit(g, "ldr x0, [x9, #8]")
  emit(g, "ldr x10, [x9]")
  emit(g, "blr x10")
  return fn_ret(t)
}

# ---------------------------------------------------------------- enums (6.73.0)
# An enum value is the address of {its case's number, then that case's fields}, 8 bytes each.
fn enum_name(g: G, e: N) -> str {
  if e.kind == "Name" and e.kids[0].text in g.enums and not has_local(g, e.kids[0].text) { return e.kids[0].text }
  return ""
}

fn has_local(g: G, name: str) -> bool {
  for l in g.locals {
    if l.name == name { return true }
  }
  return false
}

fn case_of(g: G, e: N, en: str, name: str) -> int {
  let cases = g.enums[en].kids[1].kids
  for i in 0..len(cases) {
    if cases[i].kids[0].text == name { return i }
  }
  throw "\(e.line): \(en) has no case \(name)"
}

fn construct_case(g: G, e: N, en: str, name: str, a: [N], labels: [N]) -> str {
  let i = case_of(g, e, en, name)
  let fields = g.enums[en].kids[1].kids[i].kids[1].kids
  if len(a) != len(fields) { nope(e, "\(en).\(name) with \(len(a)) values for \(len(fields)) fields") }
  emit(g, "mov x0, #" + str(len(fields) * 8 + 8))
  emit(g, "bl pk_rt_alloc")
  emit(g, "mov x1, #" + str(i))
  emit(g, "str x1, [x0]")
  push(g)
  for k in 0..len(fields) {
    var v = a[k]
    for j in 0..len(a) {
      if labels[j].kind == "S" and labels[j].text == fields[k].kids[0].text { v = a[j] }
    }
    let t = gen_expr(g, v)
    let want = int_type(e, fields[k].kids[1].text)
    if not fits(t, want) { nope(e, "a \(t) for \(fields[k].kids[0].text), a \(want)") }
    coerce(g, t, want)
    emit(g, "ldr x1, [sp]")
    emit(g, "str x0, [x1, #" + str(k * 8 + 8) + "]")
  }
  pop(g, "x0")
  return en
}

# match, as a statement or (value) as the arms' one expression each. Patterns are an enum's cases, with names for their
# fields, or values compared with ==. The first arm that fits runs; else runs when none does.
fn gen_match(g: G, m: N, value: bool) -> str {
  let t = gen_expr(g, m.kids[0])
  let mark = len(g.locals)
  let subj = new_local(g, " match", t)
  store(g, subj)
  let done = fresh(g)
  var vt = ""
  for arm in m.kids[1].kids {
    let next = fresh(g)
    let body = fresh(g)
    var binds: [N] = []
    var case_i = -1
    for p in arm.kids[0].kids {
      if p.kind == "T" {
        if t.starts_with("Result<") { result_enum(g, t) }
        if not (t in g.enums) { nope(m, "a case pattern on a \(t)") }
        case_i = case_of(g, m, t, p.kids[0].text)
        binds = p.kids[1].kids
        load(g, subj)
        emit(g, "ldr x0, [x0]")
        emit(g, "cmp x0, #" + str(case_i))
        emit(g, "b.eq " + body)
      } else {
        let pt = gen_expr(g, p)
        if pt != t { nope(p, "a \(pt) pattern for a \(t)") }
        emit(g, "mov x1, x0")
        load(g, subj)
        if t == "str" {
          emit(g, "bl pk_rt_str_eq")
          emit(g, "cbnz x0, " + body)
        } else {
          emit(g, "cmp x0, x1")
          emit(g, "b.eq " + body)
        }
      }
    }
    emit(g, "b " + next)
    place(g, body)
    let inner = len(g.locals)
    if len(binds) > 0 {
      let fields = g.enums[t].kids[1].kids[case_i].kids[1].kids
      for k in 0..len(binds) {
        load(g, subj)
        emit(g, "ldr x0, [x0, #" + str(k * 8 + 8) + "]")
        store(g, new_local(g, binds[k].text, int_type(m, fields[k].kids[1].text)))
      }
    }
    vt = arm_body(g, arm.kids[1], value, vt)
    while len(g.locals) > inner { g.locals.pop() }
    emit(g, "b " + done)
    place(g, next)
  }
  if m.kids[2].kind != "_" { vt = arm_body(g, m.kids[2], value, vt) }
  place(g, done)
  while len(g.locals) > mark { g.locals.pop() }
  if value { return vt }
  return "void"
}

# An arm's body: a block, or (as a value) the parser's [return expr], whose value lands in x0.
fn arm_body(g: G, b: N, value: bool, vt: str) -> str {
  if not value {
    gen_block(g, b)
    return vt
  }
  let t = gen_expr(g, b.kids[0].kids[0])
  if vt != "" and t != vt { nope(b.kids[0], "a match whose arms give a \(vt) and a \(t)") }
  return t
}

# ---------------------------------------------------------------- calls
# A call to a function of the program: each parameter from its argument, by place or by label, else its default, coerced
# to the parameter's type (an int going where an int? is wants its box). For a method, self is already pushed.
fn call_fn(g: G, e: N, name: str, a: [N], labels: [N], method: bool) -> str {
  let f = g.fn_nodes[name]
  let params = f.kids[1].kids
  let defaults = f.kids[4].kids
  var first = 0
  if method { first = 1 }
  if len(params) > 8 { nope(e, "more than eight parameters") }
  if len(a) > len(params) - first { nope(e, "more arguments than \(name) takes") }
  for i in first..len(params) {
    let pname = params[i].kids[0].text
    var v = none()
    for j in 0..len(a) {
      if (labels[j].kind == "_" and j + first == i) or (labels[j].kind == "S" and labels[j].text == pname) { v = a[j] }
    }
    if v.kind == "_" {
      var k = 0
      while k < len(defaults) {
        if defaults[k].text == pname { v = defaults[k + 1] }
        k += 2
      }
    }
    if v.kind == "_" { throw "\(e.line): \(name) needs \(pname)" }
    let want = int_type(e, params[i].kids[1].text)
    if want.starts_with("fn(") { g.expect = want }
    let t = gen_expr(g, v)
    g.expect = ""
    if not fits(t, want) { nope(e, "a \(t) for \(pname), a \(want)") }
    coerce(g, t, want)
    push(g)
  }
  var i = len(params) - 1
  while i >= 0 {
    pop(g, "x" + str(i))
    i -= 1
  }
  emit(g, "bl pk_" + sym(name))
  return g.fns[name]
}

# ---------------------------------------------------------------- try
# The try whose record sits at x29 - base is done: the one before it is innermost again.
fn pop_try(g: G, base: int) {
  emit(g, "sub x3, x29, #\(base)")
  emit(g, "ldr x2, [x3]")
  emit(g, "adrp x1, pk_globals")
  emit(g, "add x1, x1, :lo12:pk_globals")
  emit(g, "str x2, [x1, #16]")
}

# A try's record in four new locals, made the innermost: a throw lands at landing. Gives where the record starts.
fn open_try(g: G, landing: str) -> int {
  let rec = [new_local(g, " try3", "int"), new_local(g, " try2", "int"), new_local(g, " try1", "int"), new_local(g, " try0", "int")]
  let base = rec[3].off   # the record runs up from x29 - base: prev, x29, sp, catch
  emit(g, "adrp x1, pk_globals")
  emit(g, "add x1, x1, :lo12:pk_globals")
  emit(g, "ldr x2, [x1, #16]")
  emit(g, "sub x3, x29, #\(base)")
  emit(g, "str x2, [x3]")
  emit(g, "str x29, [x3, #8]")
  emit(g, "mov x2, sp")
  emit(g, "str x2, [x3, #16]")
  emit(g, "adr x2, " + landing)
  emit(g, "str x2, [x3, #24]")
  emit(g, "str x3, [x1, #16]")
  return base
}

# ---------------------------------------------------------------- generics (6.81.0)
# The type of an if's value from its two sides: the same, one fitting the other, or optional when one side is nil.
fn join_types(e: N, at: str, bt: str) -> str {
  if at == "nil" { return opt_type(bt) }
  if bt == "nil" { return opt_type(at) }
  if fits(at, bt) { return bt }
  if not fits(bt, at) { nope(e, "an if with a \(at) on one side and a \(bt) on the other") }
  return at
}

# ---------------------------------------------------------------- generic structs (6.82.0)
# Stack<int> is a struct of its own, made from struct Stack<T> the first time a type names it, its methods queued like
# generic functions' copies. Its name stays Stack<int>, as Plank prints it; sym() makes a label of it.
fn struct_inst(g: G, ty: str) -> bool {
  if ty in g.structs { return true }
  let lt = ty.find("<") ?? 0
  if lt == 0 or not ty.ends_with(">") or not (ty[..lt] in g.gstructs) { return false }
  let st = g.gstructs[ty[..lt]]
  let tps: [str] = []
  for p in st.kids[4].kids { tps.append(p.text) }
  let args = type_arg_list(ty)
  if len(args) != len(tps) { throw "\(st.line): \(ty) gives \(len(args)) types for \(len(tps))" }
  let copy = with_types(st, tps, args)
  copy.kids[0] = sv(ty)
  copy.kids[4] = lv([])
  g.structs[ty] = copy
  for m in copy.kids[3].kids {
    let params = [tv([sv("self"), sv(ty)])]
    for p in m.kids[1].kids { params.append(p) }
    let f = node("Fn", m.line, [sv(ty + "." + m.kids[0].text), lv(params), m.kids[2], m.kids[3], m.kids[4], m.kids[5], m.kids[6], m.kids[7], m.kids[8]])
    let ret = f.kids[2].text
    if ret != "void" { int_type(f, ret) }
    g.fns[f.kids[0].text] = ret
    g.fn_nodes[f.kids[0].text] = f
    g.pending.append(f)
  }
  return true
}

# Stack(items: ["a"]): the copy its arguments' types name, Stack<str>.
fn struct_from_args(g: G, e: N, name: str, a: [N]) -> str {
  let st = g.gstructs[name]
  let tps: [str] = []
  for p in st.kids[4].kids { tps.append(p.text) }
  let fields = st.kids[1].kids
  let labels = e.kids[2].kids
  let bound: [str: str] = [:]
  for j in 0..len(a) {
    if a[j].kind == "Lambda" { continue }
    for i in 0..len(fields) {
      if (labels[j].kind == "_" and j == i) or (labels[j].kind == "S" and labels[j].text == fields[i].kids[0].text) {
        unify(fields[i].kids[1].text, type_of(g, a[j]), tps, bound)
      }
    }
  }
  let types: [str] = []
  for p in tps {
    if not (p in bound) { nope(e, "telling \(name)'s \(p) from its fields: write \(name)<...>()") }
    types.append(bound[p])
  }
  let ty = name + "<" + types.join(", ") + ">"
  struct_inst(g, ty)
  return ty
}

# Pair<int, [str]> as ["int", "[str]"]: the commas at its top level split it.
fn type_arg_list(ty: str) -> [str] {
  let lt = ty.find("<") ?? 0
  let out: [str] = []
  let cs = ty.chars()
  var depth = 0
  var at = lt + 1
  for i in lt + 1..len(cs) - 1 {
    let c = cs[i]
    if c == "(" or c == "[" or c == "<" { depth += 1 }
    if c == ")" or c == "]" or (c == ">" and cs[i - 1] != "-") { depth -= 1 }
    if c == "," and depth == 0 {
      out.append(ty[at..i])
      at = i + 2
    }
  }
  out.append(ty[at..len(ty) - 1])
  return out
}

# A function's name as an assembler label: Stack<int>.push is Stack_Lint_G.push.
fn sym(name: str) -> str {
  if not ("<" in name or "[" in name or "?" in name or "(" in name or " " in name) { return name }
  var out = ""
  for c in name.chars() {
    if c == "<" { out = out + "_L" } else if c == ">" { out = out + "_G" } else if c == "," { out = out + "_C" } else if c == "[" { out = out + "_S" } else if c == "]" { out = out + "_E" } else if c == "?" { out = out + "_Q" } else if c == "(" { out = out + "_P" } else if c == ")" { out = out + "_R" } else if c == ":" { out = out + "_K" } else if c == "-" { out = out + "_M" } else if c != " " { out = out + c }
  }
  return out
}

fn opt_type(ty: str) -> str {
  if is_opt(ty) { return ty }
  return ty + "?"
}

# The copy of generic function name for the types its arguments give, made and queued the first time: first([1]) is
# first<int>, written as first__0 with every T in its types read as int. A lambda argument takes its types from the copy.
fn instance(g: G, e: N, name: str, a: [N]) -> str {
  let f = g.generics[name]
  let tps: [str] = []
  for p in f.kids[5].kids { tps.append(p.text) }
  let params = f.kids[1].kids
  if len(a) != len(params) { nope(e, "\(len(a)) arguments to \(name), which takes \(len(params))") }
  let bound: [str: str] = [:]
  for i in 0..len(a) {
    if a[i].kind != "Lambda" { unify(params[i].kids[1].text, type_of(g, a[i]), tps, bound) }
  }
  let types: [str] = []
  for p in tps {
    if not (p in bound) { nope(e, "telling \(name)'s \(p) from its arguments") }
    types.append(bound[p])
  }
  let key = name + "<" + types.join(", ") + ">"
  if key in g.instances { return g.instances[key] }
  let inst = name + "__" + str(len(g.instances))
  g.instances[key] = inst
  let copy = with_types(f, tps, types)
  copy.kids[0] = sv(inst)
  copy.kids[5] = lv([])
  let ret = copy.kids[2].text
  if ret != "void" { int_type(copy, ret) }
  g.fns[inst] = ret
  g.fn_nodes[inst] = copy
  g.pending.append(copy)
  return inst
}

# Binds the type parameters in pattern p to the parts of t that sit where they do: [T] and [int] bind T to int.
fn unify(p: str, t: str, tps: [str], bound: [str: str]) {
  if p in tps {
    if not (p in bound) and t != "nil" and t != "[]" and t != "[:]" { bound[p] = t }
    return
  }
  if is_opt(p) {
    if is_opt(t) { unify(p[..len(p) - 1], t[..len(t) - 1], tps, bound) } else { unify(p[..len(p) - 1], t, tps, bound) }
    return
  }
  if is_list(p) and is_list(t) and t != "[]" { unify(p[1..len(p) - 1], t[1..len(t) - 1], tps, bound) }
  if p.starts_with("(") and t.starts_with("(") {   # (A, B) and (str, int)
    let ps = tuple_parts(p)
    let ts = tuple_parts(t)
    if len(ps) == len(ts) {
      for i in 0..len(ps) { unify(ps[i], ts[i], tps, bound) }
    }
  }
}

# A copy of n with each type parameter, as a whole word, read as its type. ponytail: every name in the tree is read,
# not only types, but string literals are left alone; a variable named like a type parameter would be renamed too.
fn with_types(n: N, tps: [str], types: [str]) -> N {
  var text = n.text
  if n.kind == "S" { text = swap_words(text, tps, types) }
  let kids: [N] = []
  for k in n.kids {
    if n.kind == "Str" { kids.append(k) } else { kids.append(with_types(k, tps, types)) }
  }
  return N(n.kind, n.line, text, kids)
}

fn swap_words(s: str, tps: [str], types: [str]) -> str {
  var out = ""
  var i = 0
  while i < len(s) {
    var j = i
    while j < len(s) and word_char(s[j]) { j += 1 }
    if j == i {
      out = out + s[i]
      i += 1
    } else {
      let w = s[i..j]
      let k = tps.index_of(w)
      if k == nil { out = out + w } else { out = out + types[k!] }
      i = j
    }
  }
  return out
}

fn word_char(c: str) -> bool {
  return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_"
}

# ---------------------------------------------------------------- Result<T> (6.80.0)
# An enum gen.pk writes for each T the first time it meets Result<T>: ok(value: T) or err(message: str), so match, print
# and == treat it as any enum. rt_layout is written after every function, so each one met has its layout.
fn result_enum(g: G, ty: str) -> str {
  if not (ty in g.enums) {
    let ok = node("Case", 0, [sv("ok"), lv([tv([sv("value"), sv(ty[7..len(ty) - 1])])])])
    let err = node("Case", 0, [sv("err"), lv([tv([sv("message"), sv("str")])])])
    g.enums[ty] = node("Enum", 0, [sv(ty), lv([ok, err]), lv([]), lv([])])
  }
  return ty
}

# Result.ok(v) takes v's type; Result.err(m) the function's, unless written Result<T>.err(m).
fn construct_result(g: G, e: N) -> str {
  var ty = e.kids[0].kids[0].text
  let name = e.kids[1].text
  let a = e.kids[2].kids
  if ty == "Result" {
    if name == "ok" and len(a) == 1 {
      ty = "Result<" + type_of(g, a[0]) + ">"
    } else if g.ret_type.starts_with("Result<") {
      ty = g.ret_type
    } else {
      nope(e, "Result.\(name) with no type to take: write Result<T>.\(name)")
    }
  }
  int_type(e, ty)
  return construct_case(g, e, result_enum(g, ty), name, a, e.kids[3].kids)
}

fn result_method(g: G, e: N, t: str, name: str, a: [N]) -> str {
  let vt = t[7..len(t) - 1]
  if name == "is_ok" and len(a) == 0 {
    emit(g, "ldr x0, [x0]")
    emit(g, "cmp x0, #0")
    emit(g, "cset x0, eq")
    return "bool"
  }
  if name == "value" and len(a) == 0 {   # an err's message is thrown
    emit(g, "bl pk_rt_result_value")
    return vt
  }
  if name == "error" and len(a) == 0 {
    emit(g, "bl pk_rt_result_error")
    return "str?"
  }
  if name == "or_else" and len(a) == 1 {
    push(g)
    let d = gen_expr(g, a[0])
    if not fits(d, vt) { nope(e, "or_else with a \(d) on a \(t)") }
    coerce(g, d, vt)
    emit(g, "mov x1, x0")
    pop(g, "x0")
    emit(g, "bl pk_rt_result_or")
    return vt
  }
  nope(e, "the Result method " + name)
  return ""
}

# attempt(f) calls f inside a try: ok with what f gives, or err with what it threw, a runtime error's message included.
fn attempt_call(g: G, e: N, f: N) -> str {
  let res = new_local(g, " attempt", "int")
  let landing = fresh(g)
  let done = fresh(g)
  let base = open_try(g, landing)
  g.tries.append(base)
  let t = call_value(g, e, f, [])
  g.tries.pop()
  if t == "void" { nope(e, "attempt of a function that gives nothing") }
  pop_try(g, base)
  emit(g, "mov x1, x0")
  emit(g, "mov x0, #0")
  emit(g, "bl pk_rt_result_new")
  store(g, res)
  emit(g, "b " + done)
  place(g, landing)   # x29 and sp back, the message in x0
  pop_try(g, base)
  emit(g, "mov x1, x0")
  emit(g, "mov x0, #1")
  emit(g, "bl pk_rt_result_new")
  store(g, res)
  place(g, done)
  load(g, res)
  return result_enum(g, "Result<" + t + ">")
}

# Leaving through return, break or continue: every try opened since the keep-th is closed on the way out.
fn leave_tries(g: G, keep: int) {
  if len(g.tries) > keep { pop_try(g, g.tries[keep]) }
}

# ---------------------------------------------------------------- structs
# A struct is the address of its fields, 8 bytes each, in the order written.
fn field(g: G, e: N, t: str, name: str) -> Local {
  struct_inst(g, t)
  if not (t in g.structs) { nope(e, "a field of a " + t) }
  let fields = g.structs[t].kids[1].kids
  for i in 0..len(fields) {
    if fields[i].kids[0].text == name { return Local(name, i * 8, int_type(e, fields[i].kids[1].text)) }
  }
  throw "\(e.line): \(t) has no field \(name)"
}

# Name(a, b) or Name(b: 2, a: 1): each field from its argument, by place or by label, else from its default.
fn construct(g: G, e: N, st: N) -> str {
  let fields = st.kids[1].kids
  let defaults = st.kids[2].kids
  let a = e.kids[1].kids
  let labels = e.kids[2].kids
  if len(a) > len(fields) { nope(e, "more arguments than \(st.kids[0].text) has fields") }
  emit(g, "mov x0, #" + str(len(fields) * 8 + 8))
  emit(g, "bl pk_rt_alloc")
  push(g)
  for i in 0..len(fields) {
    let fname = fields[i].kids[0].text
    var v = none()
    for j in 0..len(a) {
      if (labels[j].kind == "_" and j == i) or (labels[j].kind == "S" and labels[j].text == fname) { v = a[j] }
    }
    if v.kind == "_" {
      var k = 0
      while k < len(defaults) {
        if defaults[k].text == fname { v = defaults[k + 1] }
        k += 2
      }
    }
    if v.kind == "_" { throw "\(e.line): \(st.kids[0].text) needs \(fname)" }
    let t = gen_expr(g, v)
    let want = int_type(e, fields[i].kids[1].text)
    if not fits(t, want) { nope(e, "a \(t) for \(fname), a \(want)") }
    coerce(g, t, want)
    emit(g, "ldr x1, [sp]")
    emit(g, "str x0, [x1, #" + str(i * 8) + "]")
  }
  pop(g, "x0")
  return st.kids[0].text
}

# rt_layout(name), written as a tree like any parsed function: each struct's "field:type;field:type", for rt_show.
fn layout_fn(g: G) -> N {
  let body: [N] = []
  for name in g.structs {
    let parts: [str] = []
    for f in g.structs[name].kids[1].kids { parts.append(f.kids[0].text + ":" + f.kids[1].text) }
    let test = node("Binary", 0, [sv("=="), node("Name", 0, [sv("name")]), node("Str", 0, [sv(name)])])
    body.append(node("If", 0, [test, lv([node("Return", 0, [node("Str", 0, [sv(parts.join(";"))])])]), lv([])]))
  }
  for name in g.enums {   # #case|case(field:type;field:type)|...
    let cases: [str] = []
    for c in g.enums[name].kids[1].kids {
      let fs: [str] = []
      for f in c.kids[1].kids { fs.append(f.kids[0].text + ":" + f.kids[1].text) }
      if len(fs) == 0 { cases.append(c.kids[0].text) } else { cases.append(c.kids[0].text + "(" + fs.join(";") + ")") }
    }
    let test = node("Binary", 0, [sv("=="), node("Name", 0, [sv("name")]), node("Str", 0, [sv(name)])])
    body.append(node("If", 0, [test, lv([node("Return", 0, [node("Str", 0, [sv("#" + cases.join("|"))])])]), lv([])]))
  }
  body.append(node("Return", 0, [node("Str", 0, [sv("")])]))
  return node("Fn", 0, [sv("rt_layout"), lv([tv([sv("name"), sv("str")])]), sv("str"), lv(body), N("D", 0, "", []), lv([]), bv(false), bv(false), sv("")])
}

fn asm(prog: N, runtime: N, gc_every: int) -> str {
  return asm_lines(prog, runtime, gc_every).join("\n") + "\n"
}

# The program's assembly, a line a string: for asm's text, or enc.pk's image.
fn asm_lines(prog: N, runtime: N, gc_every: int) -> [str] {
  let g = G([], 0, [], [], [], [], [:], [:], [:], ["syscall": 1, "peek": 1, "poke": 1, "peek8": 1, "poke8": 1, "global": 1, "addr": 1, "as_str": 1, "as_float": 1, "fma": 1, "stack_pointer": 1], [], 0, "", gc_every, [:], "", [:], [], 0, "", [:], false, [:], [:], [], [:])
  for f in runtime.kids { prog.kids.append(f) }
  let fns: [N] = []
  for f in prog.kids {
    if f.kind == "Enum" {
      if len(f.kids[3].kids) > 0 { nope(f, "an enum's type parameters") }
      g.enums[f.kids[0].text] = f
      for m in f.kids[2].kids {   # a method, as for structs: Enum.name with self first
        let params = [tv([sv("self"), sv(f.kids[0].text)])]
        for p in m.kids[1].kids { params.append(p) }
        fns.append(node("Fn", m.line, [sv(f.kids[0].text + "." + m.kids[0].text), lv(params), m.kids[2], m.kids[3], m.kids[4], m.kids[5], m.kids[6], m.kids[7], m.kids[8]]))
      }
    } else if f.kind == "Struct" and len(f.kids[4].kids) > 0 {   # struct Name<T>: made for each set of types (struct_inst)
      g.gstructs[f.kids[0].text] = f
    } else if f.kind == "Struct" {
      g.structs[f.kids[0].text] = f
      for m in f.kids[3].kids {   # a method is a function named Struct.name whose first parameter is self
        let params = [tv([sv("self"), sv(f.kids[0].text)])]
        for p in m.kids[1].kids { params.append(p) }
        fns.append(node("Fn", m.line, [sv(f.kids[0].text + "." + m.kids[0].text), lv(params), m.kids[2], m.kids[3], m.kids[4], m.kids[5], m.kids[6], m.kids[7], m.kids[8]]))
      }
    } else {
      fns.append(f)
    }
  }
  fns.append(layout_fn(g))
  prog.kids = fns
  for f in prog.kids {
    if f.kind != "Fn" { nope(f, "a top-level " + f.kind) }
    if f.kids[6].text == "true" or f.kids[7].text == "true" { nope(f, "extern and tool fns") }
    if len(f.kids[5].kids) > 0 {   # fn name<T>: a copy for each set of types it is called with (instance)
      if f.kids[0].text in g.generics { throw "\(f.line): function '\(f.kids[0].text)' defined twice" }
      g.generics[f.kids[0].text] = f
      continue
    }
    let ret = f.kids[2].text
    if ret != "void" { int_type(f, ret) }
    if f.kids[0].text in g.fns { throw "\(f.line): function '\(f.kids[0].text)' defined twice" }
    g.fns[f.kids[0].text] = ret
    g.fn_nodes[f.kids[0].text] = f
  }
  if not ("main" in g.fns) { throw "no fn main" }
  g.out.append("  .text")
  for f in prog.kids {
    if f.kids[0].text != "rt_layout" and not (f.kids[0].text in g.generics) { function(g, f) }
  }
  while len(g.pending) > 0 { function(g, g.pending.pop()) }   # generic copies, which may call for more
  function(g, layout_fn(g))   # last, so each Result<T> the functions met has its layout (6.80.0)
  for l in g.lambda_code { g.out.append(l) }   # the lambdas and trampolines the functions made
  # The trees are done with. Letting go of them here lets the collector merge their room into the one block the join at
  # the end needs (half a megabyte for plankc's own source).
  prog.kids = []
  runtime.kids = []
  g.structs = [:]
  g.fn_nodes = [:]   # it holds every function's tree too
  g.enums = [:]
  while len(fns) > 0 { fns.pop() }
  # pklibc's _start calls main(argc, argv); the program's main takes nothing.
  g.out.append("")
  g.out.append("  .globl main")
  g.out.append("  .p2align 2")
  place(g, "main")
  emit(g, "stp x29, x30, [sp, #-16]!")
  emit(g, "mov x29, sp")
  emit(g, "adrp x10, pk_globals")
  emit(g, "add x10, x10, :lo12:pk_globals")
  emit(g, "mov x9, sp")
  emit(g, "str x9, [x10, #32]")   # global(4): where the collector's stack scan stops
  emit(g, "ldr x9, =" + str(gc_every))
  emit(g, "str x9, [x10, #72]")   # global(9): collect every this many bytes, or 0
  emit(g, "bl pk_main")
  emit(g, "mov x0, #0")
  emit(g, "ldp x29, x30, [sp], #16")
  emit(g, "ret")
  g.out.append("")
  g.out.append("  .data")   # rt.pk's cells (global(i)); .data like libjt's JT_DATA
  g.out.append("  .p2align 4")
  place(g, "pk_globals")
  emit(g, ".zero 256")   # 32 cells
  g.out.append("  .section .rodata")
  for i in 0..len(g.strs) {   # each literal: its characters (6.78.0), its byte length, worked out by the assembler, then its bytes and a zero
    emit(g, ".p2align 3")
    emit(g, ".quad " + str(len(g.strs[i])))
    emit(g, ".quad .Le" + str(i) + " - .Ls" + str(i))
    g.out.append(".Ls" + str(i) + ":")
    emit(g, ".ascii " + quote(g.strs[i]))
    g.out.append(".Le" + str(i) + ":")
    emit(g, ".byte 0")
  }
  return g.out
}
