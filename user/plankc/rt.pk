# plankc's runtime, written in Plank and built only by plankc (step 4 of the true bootstrap). plankc compiles it with every
# program, so an app needs nothing from LLVM or Plank's C runtime. It uses plankc's built-ins, which plank.py does not
# have: syscall(n, a, b, c) is the kernel's svc #0; peek and poke read and write 8 bytes, peek8 and poke8 one;
# global(i) is the address of the i-th 8-byte cell of plankc's data; addr(s) is a string's address and as_str(p) the
# string at p. A string is the address of its bytes, which end in a zero, with its length in bytes in the 8 before them
# and, in the 8 before those, its length in characters, or -1 until rt_clen counts it (6.78.0).
# Cells: global(0) is the heap's next free byte, global(1) the heap's top; the collector's, below.

fn rt_copy(dst: int, src: int, n: int) {
  for i in 0..n {
    poke8(dst + i, peek8(src + i))
  }
}

# A new string of n bytes, its length set and its zero placed; the caller fills the bytes.
fn rt_str(n: int) -> int {
  let p = rt_alloc(n + 17)
  poke(p, -1)
  poke(p + 8, n)
  poke8(p + 16 + n, 0)
  return p + 16
}

# Plank counts a string in characters (6.78.0). In rt.pk's own functions len is bytes (gen.pk writes those with g.bytes).
# The count is kept in the string, so asking twice costs nothing, and a string whose count is its bytes is all ASCII,
# where a character's index is its byte's.
fn rt_clen(s: str) -> int {
  let at = addr(s) - 16
  if peek(at) >= 0 { return peek(at) }
  var n = 0
  for i in 0..len(s) {
    if peek8(addr(s) + i) / 64 != 2 { n += 1 }   # every byte but a UTF-8 continuation, 10xxxxxx, starts a character
  }
  poke(at, n)
  return n
}

# The byte where character c starts (c up to rt_clen(s), which gives len(s)). ponytail: a walk from the start when the
# string is not ASCII, so indexing such a string in a loop is quadratic; keep the last place per string if that bites.
fn rt_coff(s: str, c: int) -> int {
  if rt_clen(s) == len(s) { return c }
  var i = 0
  var k = 0
  while k < c and i < len(s) {
    i += 1
    while i < len(s) and peek8(addr(s) + i) / 64 == 2 { i += 1 }
    k += 1
  }
  return i
}

# The one-byte string for byte c. global(3) holds the table of 256.
fn rt_byte_str(c: int) -> str {
  var table = peek(global(3))
  if table == 0 {
    table = rt_alloc(256 * 8)
    for i in 0..256 {
      let p = rt_str(1)
      poke8(p, i)
      poke(table + i * 8, p)
    }
    poke(global(3), table)
  }
  return as_str(peek(table + c * 8))
}

# n zero bytes as a string, for a buffer filled in place (plankc's encoder writes app images into one).
fn rt_zstr(n: int) -> str {
  let p = rt_str(n)
  var i = 0
  while i < n {
    poke8(p + i, 0)
    i += 1
  }
  return as_str(p)
}

fn rt_concat(a: str, b: str) -> str {
  let la = len(a)
  let lb = len(b)
  let p = rt_str(la + lb)
  rt_copy(p, addr(a), la)
  rt_copy(p + la, addr(b), lb)
  return as_str(p)
}

fn rt_str_eq(a: str, b: str) -> bool {
  if len(a) != len(b) { return false }
  for i in 0..len(a) {
    if peek8(addr(a) + i) != peek8(addr(b) + i) { return false }
  }
  return true
}

fn rt_int_str(n: int) -> str {
  if n == 0 { return "0" }
  let buf = rt_alloc(32)
  var i = 32
  var m = n
  while m != 0 {
    var d = m % 10
    if d < 0 { d = 0 - d }   # % keeps the sign; working on the negative side reaches the smallest int too
    i -= 1
    poke8(buf + i, 48 + d)
    m = m / 10
  }
  if n < 0 {
    i -= 1
    poke8(buf + i, 45)
  }
  let p = rt_str(32 - i)
  rt_copy(p, buf + i, 32 - i)
  return as_str(p)
}

# ---- floats (6.76.0): print's %.15g, ported line for line from pklibc.c's fmt_double, whose output already matches
# plank.py's on Plank's examples. as_float(n) is n's 64 bits read as a float, a plankc built-in that writes no code.
# 10^e as pklibc's p10 has it: powers up to 10^22 are exact, built by multiplying tens.
fn rt_p10(e: int) -> float {
  var r = 1.0
  var k = e
  if k < 0 {
    while k < -22 {
      r = r / rt_p10(22)
      k += 22
    }
    return r / rt_p10(0 - k)
  }
  while k > 22 {
    r = r * rt_p10(22)
    k -= 22
  }
  var t = 1.0
  for i in 0..k { t = t * 10.0 }
  return r * t
}

# x * 10^k (x >= 0) rounded to the nearest int, a tie to even, decided on the exact value; -1 past what that can do
# (|k| over 22, or a result past 2^53). 10^|k| is exact there, so fma gives the product's rounding error exactly (or
# the quotient's remainder); only its sign is read, since the true value is hi plus less than half of hi's last bit.
fn rt_scaled(x: float, k: int) -> int {
  if k > 22 or k < -22 { return -1 }
  var hi = 0.0
  var lo = 0.0
  if k >= 0 {
    hi = x * rt_p10(k)
    lo = fma(x, rt_p10(k), -hi)
  } else {
    hi = x / rt_p10(0 - k)
    lo = fma(-hi, rt_p10(0 - k), x)
  }
  if hi >= float(9007199254740992) { return -1 }   # 2^53
  let whole = floor(hi)
  let f = hi - whole
  var n = int(whole)
  if f > 0.5 or (f == 0.5 and (lo > 0.0 or (lo == 0.0 and n % 2 == 1))) { n += 1 }
  return n
}

# v > 0 and finite: its first sig significant digits, rounded to nearest (a tie to even, as printf), as an int, and the
# power of ten of the first one. A guess at that power first, as pklibc's has it; then v * 10^k (or v / 10^k) with k up
# to 22, where 10^k is exact, so fma gives the product's rounding error exactly and the rounding is decided on the true
# value. Scaling and adding a half, as pklibc does, rounds 1.41421356237309492 * 10^14 up to ...309.5 and prints ...31.
# ponytail: past 10^22 either way (below 1e-8, from 1e37) it falls back to scaling, which can miss the last digit;
# exact digits there need a bignum.
fn rt_digits(x: float, sig: int) -> (int, int) {
  var v = x
  var e = 0
  while v >= 1e16 {
    v = v / 1e16
    e += 16
  }
  while v < 1.0 {
    v = v * 1e16
    e -= 16
  }
  while v >= 10.0 {
    v = v / 10.0
    e += 1
  }
  let top = int(rt_p10(sig))
  for tries in 0..3 {
    let n = rt_scaled(x, sig - 1 - e)
    if n < 0 { break }
    if n >= top {
      e += 1
    } else if n < top / 10 {
      e -= 1
    } else {
      return (n, e)
    }
  }
  var m = int(v * rt_p10(sig - 1) + 0.5)
  if m >= top {
    m = m / 10
    e += 1
  }
  return (m, e)
}

fn rt_float_str(x: float) -> str {
  var v = x
  if not (v == v) { return "nan" }
  var out = ""
  if v < 0.0 or (v == 0.0 and 1.0 / v < 0.0) {
    out = "-"
    v = -v
  }
  if v != 0.0 and v + v == v { return out + "inf" }
  var d = "000000000000000"
  var e = 0
  if v != 0.0 {
    let (n, ex) = rt_digits(v, 15)
    d = rt_int_str(n)
    e = ex
  }
  var last = 15
  while last > 1 and d[last - 1] == "0" { last -= 1 }   # %g drops trailing zeros
  if e >= -4 and e < 15 {
    if e < 0 {
      out = out + "0."
      for i in 0..(-1 - e) { out = out + "0" }
      return out + d[..last]
    }
    out = out + d[..e + 1]
    if last > e + 1 { out = out + "." + d[e + 1..last] }
    return out
  }
  out = out + d[0]
  if last > 1 { out = out + "." + d[1..last] }
  if e < 0 {
    out = out + "e-"
    e = 0 - e
  } else {
    out = out + "e+"
  }
  if e < 10 { out = out + "0" }
  return out + rt_int_str(e)
}

fn rt_write(s: str) {
  syscall(4, 1, addr(s), len(s))   # JT_SYS_WRITE to the Terminal
}

fn rt_print_str(s: str) {
  rt_write(s)
  rt_write("\n")
}

fn rt_print_int(n: int) {
  rt_print_str(rt_int_str(n))
}

fn rt_fail(msg: str) {
  rt_print_str(msg)
  syscall(1, 1, 0, 0)
}

# ---- lists (6.64.0): the address of {length, room, the address of the items}, 8 bytes an item.
fn rt_list_new() -> int {
  let l = rt_alloc(24)
  poke(l, 0)
  poke(l + 8, 0)
  poke(l + 16, 0)
  return l
}

fn rt_list_push(l: int, v: int) {
  let n = peek(l)
  if n == peek(l + 8) {
    var room = n * 2
    if room < 4 { room = 4 }
    let items = rt_alloc(room * 8)
    rt_copy(items, peek(l + 16), n * 8)
    poke(l + 16, items)
    poke(l + 8, room)
  }
  poke(peek(l + 16) + n * 8, v)
  poke(l, n + 1)
}

# Where item i lives; a negative i counts from the end, like Plank's.
fn rt_list_at(l: int, i: int) -> int {
  var j = i
  if j < 0 { j += peek(l) }
  if j < 0 or j >= peek(l) { rt_fail("index \(i) out of range for a list of \(peek(l))") }
  return peek(l + 16) + j * 8
}

fn rt_list_pop(l: int) -> int {
  let n = peek(l)
  if n == 0 { rt_fail("pop from an empty list") }
  poke(l, n - 1)
  let v = peek(peek(l + 16) + (n - 1) * 8)
  poke(peek(l + 16) + (n - 1) * 8, 0)   # the collector scans a list's whole room, so nothing stale stays in it
  return v
}

# s[a..b] in bytes. One byte comes from a table, made once, so chars() and s[i] cost no heap per character.
fn rt_sub(s: str, a: int, b: int) -> str {
  if b - a == 1 { return rt_byte_str(peek8(addr(s) + a)) }
  let p = rt_str(b - a)
  rt_copy(p, addr(s) + a, b - a)
  return as_str(p)
}

# A string the way a list shows it: in quotes, nothing escaped (Plank's own print does the same).
fn rt_quote(s: str) -> str {
  return rt_concat(rt_concat("\"", s), "\"")
}

# Any value as print shows it, from its type written out ("int", "[str]", "[[int]]"); inside a list, strings get quotes.
fn rt_show(v: int, ty: str, inner: bool) -> str {
  if peek8(addr(ty) + len(ty) - 1) == 63 {   # T?: nil, or the value (an int or bool one out of its box)
    if v == 0 { return "nil" }
    let base = rt_sub(ty, 0, len(ty) - 1)
    if rt_str_eq(base, "int") or rt_str_eq(base, "bool") or rt_str_eq(base, "float") { return rt_show(peek(v), base, inner) }
    return rt_show(v, base, inner)
  }
  if ty == "int" { return rt_int_str(v) }
  if ty == "float" { return rt_float_str(as_float(v)) }
  if ty == "bool" {
    if v != 0 { return "true" }
    return "false"
  }
  if ty == "str" {
    if inner { return rt_quote(as_str(v)) }
    return as_str(v)
  }
  if peek8(addr(ty)) == 40 { return rt_show_tuple(v, ty) }   # (
  if peek8(addr(ty)) != 91 { return rt_show_struct(v, ty) }   # not [: a struct
  if rt_dict_like(ty) { return rt_show_dict(v, ty) }
  let item = rt_sub(ty, 1, len(ty) - 1)
  var out = "["
  for i in 0..peek(v) {
    if i > 0 { out = out + ", " }
    out = out + rt_show(peek(peek(v + 16) + i * 8), item, true)
  }
  return out + "]"
}

# Where byte c first is in s at or after from, or len(s).
fn rt_find_byte(s: str, c: int, from: int) -> int {
  var i = from
  while i < len(s) and peek8(addr(s) + i) != c { i += 1 }
  return i
}

# ---- structs (6.65.0): the address of their fields, 8 bytes each, in order. rt_layout(name), which plankc writes for each
# program, gives "field:type;field:type", so a struct prints as Plank's does: P(x: 1, name: "p").
fn rt_show_struct(v: int, ty: str) -> str {
  let layout = rt_layout(ty)
  if len(layout) == 0 { rt_fail("plankc cannot show a " + ty) }
  if peek8(addr(layout)) == 35 { return rt_show_enum(v, layout) }   # #: an enum
  var out = ty + "("
  var at = 0
  var i = 0
  while at < len(layout) {
    let end = rt_find_byte(layout, 59, at)        # ;
    let colon = rt_find_byte(layout, 58, at)      # :
    if i > 0 { out = out + ", " }
    out = out + rt_sub(layout, at, colon) + ": " + rt_show(peek(v + i * 8), rt_sub(layout, colon + 1, end), true)
    at = end + 1
    i += 1
  }
  return out + ")"
}

# ---- strings, more (6.66.0). The indexes a program sees count characters (6.78.0): rt_clen and rt_coff turn them into
# bytes.
fn rt_clamp(i: int, n: int) -> int {
  var j = i
  if j < 0 { j += n }
  if j < 0 { j = 0 }
  if j > n { j = n }
  return j
}

fn rt_str_slice(s: str, a: int, b: int) -> str {
  let n = rt_clen(s)
  let i = rt_clamp(a, n)
  let j = rt_clamp(b, n)
  if j <= i { return "" }
  return rt_sub(s, rt_coff(s, i), rt_coff(s, j))
}

fn rt_char_at(s: str, i: int) -> str {
  let n = rt_clen(s)
  var j = i
  if j < 0 { j += n }
  if j < 0 or j >= n { rt_fail("index \(i) out of range for a string of \(n)") }
  return rt_sub(s, rt_coff(s, j), rt_coff(s, j + 1))
}

fn rt_list_slice(l: int, a: int, b: int) -> int {
  let i = rt_clamp(a, peek(l))
  let j = rt_clamp(b, peek(l))
  let out = rt_list_new()
  for k in i..j {
    rt_list_push(out, peek(peek(l + 16) + k * 8))
  }
  return out
}

# Where p first is in s, or -1.
fn rt_find(s: str, p: str) -> int {
  for i in 0..len(s) - len(p) + 1 {
    var k = 0
    while k < len(p) and peek8(addr(s) + i + k) == peek8(addr(p) + k) { k += 1 }
    if k == len(p) { return i }
  }
  return -1
}

# Where p first is in s, in characters, or -1: s.find(p).
fn rt_cfind(s: str, p: str) -> int {
  let b = rt_find(s, p)
  if b < 0 or rt_clen(s) == len(s) { return b }
  var n = 0
  for i in 0..b {
    if peek8(addr(s) + i) / 64 != 2 { n += 1 }
  }
  return n
}

fn rt_starts(s: str, p: str) -> bool {
  return len(p) <= len(s) and rt_str_eq(rt_sub(s, 0, len(p)), p)
}

fn rt_ends(s: str, p: str) -> bool {
  return len(p) <= len(s) and rt_str_eq(rt_sub(s, len(s) - len(p), len(s)), p)
}

fn rt_trim(s: str) -> str {
  var a = 0
  var b = len(s)
  while a < b and rt_space(peek8(addr(s) + a)) { a += 1 }
  while b > a and rt_space(peek8(addr(s) + b - 1)) { b -= 1 }
  return rt_sub(s, a, b)
}

fn rt_space(c: int) -> bool {
  return c == 32 or c == 9 or c == 10 or c == 13
}

# One string a character: a UTF-8 lead byte says how many bytes follow it.
fn rt_chars(s: str) -> int {
  let out = rt_list_new()
  var i = 0
  while i < len(s) {
    let c = peek8(addr(s) + i)
    var n = 1
    if c >= 240 { n = 4 } else if c >= 224 { n = 3 } else if c >= 192 { n = 2 }
    rt_list_push(out, addr(rt_sub(s, i, i + n)))
    i += n
  }
  return out
}

# The whole length first, then one copy: joining plankc's own assembly, a megabyte of lines, stays linear.
fn rt_join(l: int, sep: str) -> str {
  let n = peek(l)
  var total = 0
  for i in 0..n {
    total += len(as_str(peek(peek(l + 16) + i * 8)))
  }
  if n > 1 { total += (n - 1) * len(sep) }
  let p = rt_str(total)
  var at = 0
  for i in 0..n {
    if i > 0 {
      rt_copy(p + at, addr(sep), len(sep))
      at += len(sep)
    }
    let part = as_str(peek(peek(l + 16) + i * 8))
    rt_copy(p + at, addr(part), len(part))
    at += len(part)
  }
  return as_str(p)
}

fn rt_split(s: str, sep: str) -> int {
  let out = rt_list_new()
  var at = 0
  var i = 0
  while i + len(sep) <= len(s) and len(sep) > 0 {
    if rt_str_eq(rt_sub(s, i, i + len(sep)), sep) {
      rt_list_push(out, addr(rt_sub(s, at, i)))
      i += len(sep)
      at = i
    } else {
      i += 1
    }
  }
  rt_list_push(out, addr(rt_sub(s, at, len(s))))
  return out
}

fn rt_parse_int(s: str) -> int {
  let t = rt_trim(s)
  var i = 0
  var neg = false
  if len(t) > 0 and peek8(addr(t)) == 45 {
    neg = true
    i = 1
  }
  if i >= len(t) { rt_fail("int() of \"\(s)\"") }
  var n = 0
  while i < len(t) {
    let c = peek8(addr(t) + i)
    if c < 48 or c > 57 { rt_fail("int() of \"\(s)\"") }
    n = n * 10 - (c - 48)   # on the negative side, so the smallest int parses too
    i += 1
  }
  if neg { return n }
  return 0 - n
}

# An int or bool that may be missing lives in a box of its own: 0 is nil.
fn rt_box(v: int) -> int {
  let p = rt_alloc(8)
  poke(p, v)
  return p
}

# ---- dicts (6.67.0): the address of {keys, values, 1 if its keys are ints}, two lists in the order keys arrived.
# 6.79.0: int keys too. The first int key in marks the dict (rt_dict_set_int); until a key is in there is nothing to
# compare, so an empty dict needs no mark. An int key is stored as itself, a string key as its address.
# ponytail: a lookup walks the keys; hash them when a program's dicts grow past a few hundred.
fn rt_dict_new() -> int {
  let d = rt_alloc(24)
  poke(d, rt_list_new())
  poke(d + 8, rt_list_new())
  poke(d + 16, 0)
  return d
}

fn rt_dict_find(d: int, k: str) -> int {
  let keys = peek(d)
  let ints = peek(d + 16) == 1
  for i in 0..peek(keys) {
    let at = peek(peek(keys + 16) + i * 8)
    if ints and at == addr(k) { return i }
    if not ints and rt_str_eq(as_str(at), k) { return i }
  }
  return -1
}

# -1, 0 or 1 as a sorts before, with or after b, byte by byte.
fn rt_str_cmp(a: str, b: str) -> int {
  var i = 0
  while i < len(a) and i < len(b) {
    let x = peek8(addr(a) + i)
    let y = peek8(addr(b) + i)
    if x < y { return -1 }
    if x > y { return 1 }
    i += 1
  }
  if len(a) < len(b) { return -1 }
  if len(a) > len(b) { return 1 }
  return 0
}

fn rt_dict_has(d: int, k: str) -> bool {
  return rt_dict_find(d, k) >= 0
}

fn rt_dict_get(d: int, k: str) -> int {
  let i = rt_dict_find(d, k)
  if i < 0 and peek(d + 16) == 1 { rt_fail("no key \(addr(k)) in the dict") }
  if i < 0 { rt_fail("no key \"\(k)\" in the dict") }
  return peek(peek(peek(d + 8) + 16) + i * 8)
}

fn rt_dict_set(d: int, k: str, v: int) {
  let i = rt_dict_find(d, k)
  if i >= 0 {
    poke(peek(peek(d + 8) + 16) + i * 8, v)
  } else {
    rt_list_push(peek(d), addr(k))
    rt_list_push(peek(d + 8), v)
  }
}

# x in xs (6.79.0): an item equal to x, as == compares items of type ty.
fn rt_list_has(l: int, x: int, ty: str) -> bool {
  for i in 0..peek(l) {
    if rt_equal(peek(peek(l + 16) + i * 8), x, ty) { return true }
  }
  return false
}

fn rt_dict_set_int(d: int, k: str, v: int) {
  poke(d + 16, 1)
  rt_dict_set(d, k, v)
}

# Is ty a dict, [K: V], rather than a list of them? Its ": " sits at depth one.
fn rt_dict_like(ty: str) -> bool {
  var depth = 0
  for i in 0..len(ty) - 1 {
    let c = peek8(addr(ty) + i)
    if c == 91 or c == 40 { depth += 1 }
    if c == 93 or c == 41 { depth -= 1 }
    if c == 58 and depth == 1 { return true }
  }
  return false
}

fn rt_show_dict(d: int, ty: str) -> str {
  let keys = peek(d)
  if peek(keys) == 0 { return "[:]" }
  let colon = rt_find(ty, ": ")
  let kt = rt_sub(ty, 1, colon)
  let vt = rt_sub(ty, colon + 2, len(ty) - 1)
  var out = "["
  for i in 0..peek(keys) {
    if i > 0 { out = out + ", " }
    out = out + rt_show(peek(peek(keys + 16) + i * 8), kt, true) + ": " + rt_show(peek(peek(peek(d + 8) + 16) + i * 8), vt, true)
  }
  return out + "]"
}

# ---- try and throw (6.68.0). global(2) is the innermost try's record: {the try before it, x29, sp, the catch's address},
# 8 bytes each, kept in its function's frame; plankc writes the code that fills it, throw restores x29 and sp and jumps.
fn rt_uncaught(msg: str, line: int) {
  rt_print_str("\(line): \(msg)")
  syscall(1, 1, 0, 0)
}

# ---- files and arguments (6.69.0): JT_SYS_READFILE, JT_SYS_WRITEFILE and JT_SYS_ARGS.
# A file is read into one buffer kept for every read (global(10), a root of the collector), then copied into a string
# of its exact size.
fn rt_read_file(path: str) -> int {
  let cap = 262144   # ponytail: 256 KB, past plankc's biggest source eight times over; READAT in chunks for bigger
  if peek(global(10)) == 0 { poke(global(10), rt_alloc(cap)) }
  let n = syscall(401, addr(path), peek(global(10)), cap)
  if n < 0 { return 0 }
  let p = rt_str(n)
  rt_copy(p, peek(global(10)), n)
  return p
}

fn rt_write_file(path: str, s: str) -> bool {
  return syscall(405, addr(path), addr(s), len(s)) >= 0
}

# The words after userrun NAME, split on spaces.
fn rt_args() -> int {
  let buf = rt_alloc(256)
  var n = syscall(404, buf, 256, 0)
  if n < 0 { n = 0 }
  let out = rt_list_new()
  var at = 0
  for i in 0..n + 1 {
    if i == n or peek8(buf + i) == 32 {
      if i > at {
        let w = rt_str(i - at)
        rt_copy(w, buf + at, i - at)
        rt_list_push(out, w)
      }
      at = i + 1
    }
  }
  return out
}

# ---- the collector (6.70.0): conservative, non-moving mark and sweep, so a program can make far more than an app's 27 MiB
# over its life as long as what it keeps fits. Every object starts with a header word, its size in bytes (header included,
# a multiple of 16) with bit 0 for marked and bit 1 for free; rt_alloc hands out the word after it. A bitmap, one bit per
# 16 bytes, marks where objects start, so a pointer into the middle of one (a string's bytes, xs[i]'s slot) still finds it.
# Roots: the stack from the collector's own frame up to where main started (global(4)), and the cells the runtime keeps
# (global(3), the one-byte strings; global(10), the read buffer). That is enough only because plankc's code never keeps a
# heap address in a register alone across a call: every callee stores its arguments in its frame first (gen.pk says so).
# The heap is taken whole at the start and split in two. Objects of 64 KB and more (file buffers, big lists' items, a
# program's whole output) live in the top LARGE bytes, on their own first-fit list, so the small objects that come and go
# by the thousand can never break up the room a big one needs; that is what let plankc write its own half-megabyte output.
# Small free blocks go on 64 lists by size (16 to 1024 bytes) and one for bigger. Every sweep rebuilds the lists from
# scratch and merges neighbouring dead blocks. It collects when a request does not fit, or every global(9) bytes when a
# program asks (plankc --gc=N asm, for testing).
# Cells: global(5) the heap's first object, global(6) the bitmap, global(7) the small lists (65 words), global(8) bytes
# handed out since the last collection, global(11) the powers of two the bitmap's arithmetic reads, global(12) the bytes
# live at the last collection, global(16) the large list, global(17) where the large space starts, global(18) the heap's
# end, global(19) bytes handed out since the last yield, global(20) to global(22) a number's digits on the way out,
# global(23) collections in a row that found the heap nearly full (rt_starved).

fn rt_large() -> int { return 2621440 }   # 2.5 MiB for large objects; calibrate against the biggest program's output

fn rt_gc_init() {
  let base = syscall(397, 0, 0, 0)               # where the heap ends now
  let bitmap_bytes = 262144                       # 32 MiB of heap, a bit per 16 bytes: the most the kernel gives
  let lists = base + bitmap_bytes
  let first = (lists + 65 * 8 + 8 + 15) / 16 * 16   # the lists, then eight bytes of powers of two
  var top = base + 33554432                       # all the kernel will give (27 MiB): ask big, step down to its limit
  while top > first and syscall(397, top, 0, 0) < top { top -= 65536 }
  if top - first < rt_large() * 2 { rt_oom(rt_large() * 2) }
  var i = base
  while i < first {
    poke(i, 0)
    i += 8
  }
  var p = 1
  for k in 0..8 {
    poke8(lists + 65 * 8 + k, p)
    p = p * 2
  }
  poke(global(11), lists + 65 * 8)
  poke(global(6), base)
  poke(global(7), lists)
  poke(global(5), first)
  poke(global(0), first)
  poke(global(18), top)
  let lo = top - rt_large()
  poke(global(17), lo)
  poke(global(16), 0)
  rt_free_large(lo, top - lo)   # the large space starts as one free block
}

fn rt_oom(size: int) {
  rt_write("out of memory for ")
  rt_write_num(size)
  rt_write(" bytes, ")   # literals and a buffer in the cells: nothing on this path may allocate
  rt_write_num(peek(global(12)))
  rt_write(" bytes live at the last collection\n")
  syscall(1, 1, 0, 0)
}

# n in decimal, through global(20) to global(22) as a buffer, so it works when the heap is full.
fn rt_write_num(n: int) {
  let buf = global(20)
  var i = 23
  var m = n
  poke8(buf + i, 48 + m % 10)
  m = m / 10
  while m > 0 {
    i -= 1
    poke8(buf + i, 48 + m % 10)
    m = m / 10
  }
  syscall(4, 1, buf + i, 24 - i)
}

# Plank has no bitwise operators, so the bitmap's bits and the header's flags are plain arithmetic.
fn rt_pow2(k: int) -> int { return peek8(peek(global(11)) + k) }   # from the table rt_gc_init makes: 1, 2, 4 ... 128
fn rt_bit_get(start: int) -> bool {
  let b = (start - peek(global(5))) / 16
  return peek8(peek(global(6)) + b / 8) / rt_pow2(b % 8) % 2 == 1
}
fn rt_bit_set(start: int) {
  let b = (start - peek(global(5))) / 16
  let at = peek(global(6)) + b / 8
  if not rt_bit_get(start) { poke8(at, peek8(at) + rt_pow2(b % 8)) }
}
fn rt_bit_clear(start: int) {
  let b = (start - peek(global(5))) / 16
  let at = peek(global(6)) + b / 8
  if rt_bit_get(start) { poke8(at, peek8(at) - rt_pow2(b % 8)) }
}
fn rt_size(h: int) -> int { return h - h % 4 }   # a header's size, its two flag bits dropped

fn rt_class(size: int) -> int {
  if size <= 1024 { return size / 16 }
  return 0
}

fn rt_alloc(n: int) -> int {
  if peek(global(6)) == 0 { rt_gc_init() }
  let size = (n + 8 + 15) / 16 * 16
  if peek(global(9)) > 0 and peek(global(8)) > peek(global(9)) { rt_gc() }
  var p = rt_room(size)
  if p == 0 {
    rt_starved(size)
    rt_gc()
    p = rt_room(size)
    if p == 0 and size < 65536 { p = rt_take_large(size) }   # either space before giving up: the other may hold the room
    if p == 0 and size >= 65536 {
      p = rt_take(size)
      if p == 0 { p = rt_bump(size) }
    }
    if p == 0 { rt_oom(size) }
  }
  poke(global(8), peek(global(8)) + size)
  poke(global(19), peek(global(19)) + size)
  if peek(global(19)) > 262144 { rt_yield() }
  return p + 8
}

# 6.76.3: a collection that follows less than a sixteenth of the heap handed out finds little to free. Eight of those in
# a row and the program is thrashing on a full heap, so it stops with the out-of-memory line instead of crawling (plankc
# compiling itself sat 30 minutes that way on 11 MiB). global(23) counts them. Not under --gc=N, which collects on purpose.
fn rt_starved(size: int) {
  if peek(global(9)) > 0 { return }
  if peek(global(8)) * 16 < peek(global(18)) - peek(global(5)) {
    poke(global(23), peek(global(23)) + 1)
    if peek(global(23)) >= 8 { rt_oom(size) }
  } else {
    poke(global(23), 0)
  }
}

# A long job lets the desktop run now and then (JT_SYS_SCHED_YIELD): every 256 KB it allocates and around each
# collection. An app that holds the processor for 3 s is taken for frozen and stopped, and the desktop would stall.
fn rt_yield() {
  poke(global(19), 0)
  syscall(158, 0, 0, 0)
}

# Room for an object of size bytes, header included, or 0: a large one from the large space, a small one from its lists
# or the small space's end.
fn rt_room(size: int) -> int {
  if size >= 65536 { return rt_take_large(size) }
  let p = rt_take(size)
  if p != 0 { return p }
  return rt_bump(size)
}

# A block from the small lists, or 0: its own size class first, then the smallest bigger class, then the first bigger
# block that fits. Whatever is left over goes back on a list, so the runs the sweep merges feed small requests too.
fn rt_take(size: int) -> int {
  let lists = peek(global(7))
  var c = rt_class(size)
  if c > 0 {
    let head = peek(lists + c * 8)
    if head != 0 {
      poke(lists + c * 8, peek(head + 8))
      poke(head, size)
      return head
    }
    c += 1
    while c <= 64 {
      let b = peek(lists + c * 8)
      if b != 0 {
        poke(lists + c * 8, peek(b + 8))
        return rt_cut(b, c * 16, size, false)
      }
      c += 1
    }
  }
  var prev = 0
  var b = peek(lists)
  while b != 0 {
    let bs = rt_size(peek(b))
    if bs >= size {
      if prev == 0 { poke(lists, peek(b + 8)) } else { poke(prev + 8, peek(b + 8)) }
      return rt_cut(b, bs, size, false)
    }
    prev = b
    b = peek(b + 8)
  }
  return 0
}

# The first block in the large space that fits, or 0.
fn rt_take_large(size: int) -> int {
  var prev = 0
  var b = peek(global(16))
  while b != 0 {
    let bs = rt_size(peek(b))
    if bs >= size {
      if prev == 0 { poke(global(16), peek(b + 8)) } else { poke(prev + 8, peek(b + 8)) }
      return rt_cut(b, bs, size, true)
    }
    prev = b
    b = peek(b + 8)
  }
  return 0
}

# Block b of bs bytes, off every list, cut to size; a tail of 16 bytes or more is freed again, in the space it is in.
fn rt_cut(b: int, bs: int, size: int, large: bool) -> int {
  if bs - size >= 16 {
    if large { rt_free_large(b + size, bs - size) } else { rt_free_block(b + size, bs - size) }
    poke(b, size)
  } else {
    poke(b, bs)   # the block keeps its whole size, so the sweep's walk stays on headers
  }
  return b
}

# Fresh room at the small space's end, or 0 where the large space begins.
fn rt_bump(size: int) -> int {
  let top = peek(global(0))
  if top + size > peek(global(17)) { return 0 }
  poke(global(0), top + size)
  poke(top, size)
  rt_bit_set(top)
  return top
}

fn rt_free_block(b: int, size: int) {
  poke(b, size + 2)
  rt_bit_set(b)
  let slot = peek(global(7)) + rt_class(size) * 8
  poke(b + 8, peek(slot))
  poke(slot, b)
}

fn rt_free_large(b: int, size: int) {
  poke(b, size + 2)
  rt_bit_set(b)
  poke(b + 8, peek(global(16)))
  poke(global(16), b)
}

# The object v points into, marked and scanned, if it is one.
fn rt_mark(v: int) {
  let base = peek(global(5))
  if v < base or v >= peek(global(18)) or (v >= peek(global(0)) and v < peek(global(17))) { return }
  var s = (v - base) / 16 * 16 + base
  while s > base and not rt_bit_get(s) { s -= 16 }
  if not rt_bit_get(s) { return }
  let h = peek(s)
  if h % 4 != 0 or v >= s + h { return }   # marked already, free, or past its end
  poke(s, h + 1)
  var w = s + 8
  while w < s + h {
    rt_mark(peek(w))
    w += 8
  }
}

fn rt_gc() {
  rt_yield()
  # mark
  var w = stack_pointer()
  while w < peek(global(4)) {
    rt_mark(peek(w))
    w += 8
  }
  rt_mark(peek(global(3)))
  rt_mark(peek(global(10)))
  # sweep both spaces: every dead or free run becomes one free block, the lists made anew; global(12) counts what lived
  poke(global(12), 0)
  let lists = peek(global(7))
  for i in 0..65 {
    poke(lists + i * 8, 0)
  }
  poke(global(16), 0)
  rt_sweep(peek(global(5)), peek(global(0)), false)
  rt_sweep(peek(global(17)), peek(global(18)), true)
  poke(global(8), 0)
  rt_yield()
}

fn rt_sweep(from: int, end: int, large: bool) {
  var s = from
  while s < end {
    let h = peek(s)
    let size = rt_size(h)
    if h % 2 == 1 {
      poke(s, size)
      poke(global(12), peek(global(12)) + size)
      s += size
    } else {
      var run = size
      while s + run < end and peek(s + run) % 2 == 0 {
        rt_bit_clear(s + run)
        run += rt_size(peek(s + run))
      }
      if large {
        rt_free_large(s, run)
      } else if s + run == end {
        rt_bit_clear(s)
        poke(global(0), s)   # dead up to the small space's end: give it back to the bump
      } else {
        rt_free_block(s, run)
      }
      s += run
    }
  }
}

# ---- enums (6.73.0): the address of {the case's number, its fields}. The layout is "#case|case(field:type;...)|...";
# a value shows as its case, and its fields as a struct's do: circle(r: 1), dot.
fn rt_show_enum(v: int, layout: str) -> str {
  var at = 1
  for i in 0..peek(v) {
    at = rt_find_byte(layout, 124, at) + 1   # past the tag-th |
  }
  let end = rt_find_byte(layout, 124, at)
  let open = rt_find_byte(layout, 40, at)
  if open >= end { return rt_sub(layout, at, end) }
  var out = rt_sub(layout, at, open) + "("
  var f = open + 1
  var i = 0
  while f < end - 1 {
    let stop = rt_min(rt_find_byte(layout, 59, f), end - 1)
    let colon = rt_find_byte(layout, 58, f)
    if i > 0 { out = out + ", " }
    out = out + rt_sub(layout, f, colon) + ": " + rt_show(peek(v + 8 + i * 8), rt_sub(layout, colon + 1, stop), true)
    f = stop + 1
    i += 1
  }
  return out + ")"
}

fn rt_min(a: int, b: int) -> int {
  if a < b { return a }
  return b
}

# The same case with equal fields. ponytail: equal as printed, which is structural for every payload plankc has; compare
# field by field if enums get big enough for the printing to cost.
fn rt_enum_eq(a: int, b: int, ty: str) -> bool {
  if peek(a) != peek(b) { return false }
  return rt_str_eq(rt_show(a, ty, true), rt_show(b, ty, true))
}

# ---- tuples (6.74.0): the address of their parts, 8 bytes each, shown as ("ada", 36).
fn rt_show_tuple(v: int, ty: str) -> str {
  var out = "("
  var depth = 0
  var at = 1
  var i = 0
  for k in 1..len(ty) {
    let c = peek8(addr(ty) + k)
    if c == 40 or c == 91 { depth += 1 }
    if (c == 41 or c == 93) and depth > 0 { depth -= 1 }
    if (c == 44 and depth == 0) or k == len(ty) - 1 {
      if i > 0 { out = out + ", " }
      out = out + rt_show(peek(v + i * 8), rt_sub(ty, at, k), true)
      at = k + 2
      i += 1
    }
  }
  return out + ")"
}

# ---- closures' list methods (6.75.0). A value is a word to the runtime, so one map, filter, reduce and sort serve every
# element type; the closures that order ints and strings by default are made here too.
fn rt_map(l: int, f: fn(int) -> int) -> int {
  let out = rt_list_new()
  for i in 0..peek(l) {
    rt_list_push(out, f(peek(peek(l + 16) + i * 8)))
  }
  return out
}

fn rt_filter(l: int, f: fn(int) -> bool) -> int {
  let out = rt_list_new()
  for i in 0..peek(l) {
    let v = peek(peek(l + 16) + i * 8)
    if f(v) { rt_list_push(out, v) }
  }
  return out
}

fn rt_reduce(l: int, init: int, f: fn(int, int) -> int) -> int {
  var acc = init
  for i in 0..peek(l) {
    acc = f(acc, peek(peek(l + 16) + i * 8))
  }
  return acc
}

fn rt_int_before() -> fn(int, int) -> bool {
  return fn(a: int, b: int) => a < b
}

fn rt_str_before() -> fn(int, int) -> bool {
  return fn(a: int, b: int) => rt_str_cmp(as_str(a), as_str(b)) < 0
}

# A sorted copy, stable: merge sort, taking from the right half only when it truly comes first.
fn rt_sorted(l: int, before: fn(int, int) -> bool) -> int {
  let n = peek(l)
  let out = rt_list_slice(l, 0, n)
  let tmp = rt_list_slice(l, 0, n)
  rt_msort(out, tmp, 0, n, before)
  return out
}

fn rt_sort(l: int, before: fn(int, int) -> bool) {
  let s = rt_sorted(l, before)
  for i in 0..peek(l) {
    poke(peek(l + 16) + i * 8, peek(peek(s + 16) + i * 8))
  }
}

fn rt_msort(a: int, t: int, lo: int, hi: int, before: fn(int, int) -> bool) {
  if hi - lo < 2 { return }
  let mid = (lo + hi) / 2
  rt_msort(a, t, lo, mid, before)
  rt_msort(a, t, mid, hi, before)
  let ai = peek(a + 16)
  let ti = peek(t + 16)
  var i = lo
  var j = mid
  var k = lo
  while i < mid and j < hi {
    if before(peek(ai + j * 8), peek(ai + i * 8)) {
      poke(ti + k * 8, peek(ai + j * 8))
      j += 1
    } else {
      poke(ti + k * 8, peek(ai + i * 8))
      i += 1
    }
    k += 1
  }
  while i < mid {
    poke(ti + k * 8, peek(ai + i * 8))
    i += 1
    k += 1
  }
  while j < hi {
    poke(ti + k * 8, peek(ai + j * 8))
    j += 1
    k += 1
  }
  for m in lo..hi {
    poke(ai + m * 8, peek(ti + m * 8))
  }
}

# ---- 6.77.0: the built-ins Plank's examples reach for next ----
# fixed(x, digits): x with exactly that many digits after the point, as printf's %.*f, the last one rounded exactly.
fn rt_fixed(x: float, digits: int) -> str {
  var d = digits
  if d < 0 { d = 0 }
  if d > 15 { d = 15 }
  var v = x
  var out = ""
  if v < 0.0 or (v == 0.0 and 1.0 / v < 0.0) {
    out = "-"
    v = -v
  }
  if not (v == v) { return "nan" }
  if v != 0.0 and v + v == v { return out + "inf" }
  var n = rt_scaled(v, d)
  if n < 0 { n = int(v * rt_p10(d) + 0.5) }   # ponytail: past 2^53 it scales; exact needs a bignum
  var t = rt_int_str(n)
  while len(t) <= d { t = "0" + t }
  if d == 0 { return out + t }
  return out + rt_sub(t, 0, len(t) - d) + "." + rt_sub(t, len(t) - d, len(t))
}

# float(s): Plank's strtod over plain decimal text, spaces around allowed. Its digits and power of ten are exact up to 15
# digits and 10^22, so one multiply or divide rounds it to the nearest double, as strtod does.
fn rt_parse_float(s: str) -> float {
  let t = rt_trim(s)
  var i = 0
  var neg = false
  if i < len(t) and (peek8(addr(t)) == 45 or peek8(addr(t)) == 43) {
    neg = peek8(addr(t)) == 45
    i = 1
  }
  var m = 0
  var nd = 0       # significant digits kept
  var exp = 0
  var any = false
  var dot = false
  while i < len(t) {
    let c = peek8(addr(t) + i)
    if c == 46 and not dot {
      dot = true
    } else if c >= 48 and c <= 57 {
      any = true
      if nd < 18 {
        if m > 0 or c != 48 { nd += 1 }
        m = m * 10 + c - 48
        if dot { exp -= 1 }
      } else if not dot {
        exp += 1   # past 18 digits: the rest only scale
      }
    } else {
      break
    }
    i += 1
  }
  if i < len(t) and (peek8(addr(t) + i) == 101 or peek8(addr(t) + i) == 69) {
    i += 1
    var eneg = false
    if i < len(t) and (peek8(addr(t) + i) == 45 or peek8(addr(t) + i) == 43) {
      eneg = peek8(addr(t) + i) == 45
      i += 1
    }
    var e = 0
    let start = i
    while i < len(t) and peek8(addr(t) + i) >= 48 and peek8(addr(t) + i) <= 57 {
      e = e * 10 + peek8(addr(t) + i) - 48
      i += 1
    }
    if i == start { any = false }
    if eneg { e = 0 - e }
    exp += e
  }
  if not any or i != len(t) { rt_fail("float() of \"\(s)\": not a number") }
  var v = float(m)
  if nd <= 15 and exp >= -22 and exp <= 22 {   # exact: one rounding
    if exp >= 0 { v = v * rt_p10(exp) } else { v = v / rt_p10(0 - exp) }
  } else {
    v = v * rt_p10(exp)   # ponytail: long or far-out text rounds twice; exact needs a bignum
  }
  if neg { return -v }
  return v
}

fn rt_list_remove_at(l: int, i: int) {
  let items = peek(l + 16)
  for k in i..peek(l) - 1 { poke(items + k * 8, peek(items + k * 8 + 8)) }
  poke(items + (peek(l) - 1) * 8, 0)
  poke(l, peek(l) - 1)
}

fn rt_dict_remove(d: int, k: str) {
  let i = rt_dict_find(d, k)
  if i < 0 {
    rt_fail("key \"\(k)\" is not in this dict")
    return
  }
  rt_list_remove_at(peek(d), i)
  rt_list_remove_at(peek(d + 8), i)
}

# xs.min() and xs.max(): where the smallest (the first of equals) or the largest (the last of equals) is, as Plank's
# sorted().first and .last pick, or -1 for an empty list. kind: 0 int, 1 float, 2 str.
fn rt_list_pick(l: int, kind: int, most: bool) -> int {
  if peek(l) == 0 { return -1 }
  let items = peek(l + 16)
  var at = 0
  for i in 1..peek(l) {
    let a = peek(items + i * 8)
    let b = peek(items + at * 8)
    var less = false   # a before b
    var same = false
    if kind == 0 {
      less = a < b
      same = a == b
    } else if kind == 1 {
      less = as_float(a) < as_float(b)
      same = as_float(a) == as_float(b)
    } else {
      let c = rt_str_cmp(as_str(a), as_str(b))
      less = c < 0
      same = c == 0
    }
    if most and not less { at = i }
    if not most and less { at = i }
  }
  return at
}

# The whitespace split: runs of spaces, tabs and newlines between words, none at either end.
fn rt_split_space(s: str) -> int {
  let out = rt_list_new()
  var i = 0
  while i < len(s) {
    while i < len(s) and rt_space(peek8(addr(s) + i)) { i += 1 }
    let at = i
    while i < len(s) and not rt_space(peek8(addr(s) + i)) { i += 1 }
    if i > at { rt_list_push(out, addr(rt_sub(s, at, i))) }
  }
  return out
}

# a == b, part by part, from their type written out, as plank.py's eq functions: lists in order, dicts by key whatever
# their order, tuples and structs field by field, optionals nil or the same inside, enums by case and fields.
fn rt_equal(a: int, b: int, ty: str) -> bool {
  if ty == "int" or ty == "bool" { return a == b }
  if ty == "float" { return as_float(a) == as_float(b) }
  if ty == "str" { return rt_str_eq(as_str(a), as_str(b)) }
  if rt_starts(ty, "fn(") { return a == b }
  if peek8(addr(ty) + len(ty) - 1) == 63 {   # T?
    if a == 0 or b == 0 { return a == b }
    let base = rt_sub(ty, 0, len(ty) - 1)
    if rt_str_eq(base, "int") or rt_str_eq(base, "bool") or rt_str_eq(base, "float") { return rt_equal(peek(a), peek(b), base) }
    return rt_equal(a, b, base)
  }
  if peek8(addr(ty)) == 40 {   # (a tuple
    var depth = 0
    var at = 1
    var i = 0
    for k in 1..len(ty) {
      let c = peek8(addr(ty) + k)
      if c == 40 or c == 91 { depth += 1 }
      if (c == 41 or c == 93) and depth > 0 { depth -= 1 }
      if (c == 44 and depth == 0) or k == len(ty) - 1 {
        if not rt_equal(peek(a + i * 8), peek(b + i * 8), rt_sub(ty, at, k)) { return false }
        at = k + 2
        i += 1
      }
    }
    return true
  }
  if peek8(addr(ty)) == 91 and rt_dict_like(ty) {   # [str: V]
    let colon = rt_find(ty, ": ")
    let vt = rt_sub(ty, colon + 2, len(ty) - 1)
    let ka = peek(a)
    if peek(ka) != peek(peek(b)) { return false }
    for i in 0..peek(ka) {
      let j = rt_dict_find(b, as_str(peek(peek(ka + 16) + i * 8)))
      if j < 0 { return false }
      if not rt_equal(peek(peek(peek(a + 8) + 16) + i * 8), peek(peek(peek(b + 8) + 16) + j * 8), vt) { return false }
    }
    return true
  }
  if peek8(addr(ty)) == 91 {   # [T]
    if peek(a) != peek(b) { return false }
    let item = rt_sub(ty, 1, len(ty) - 1)
    for i in 0..peek(a) {
      if not rt_equal(peek(peek(a + 16) + i * 8), peek(peek(b + 16) + i * 8), item) { return false }
    }
    return true
  }
  let layout = rt_layout(ty)
  if peek8(addr(layout)) == 35 { return rt_enum_eq(a, b, ty) }
  var at = 0
  var i = 0
  while at < len(layout) {   # a struct, field by field
    let end = rt_find_byte(layout, 59, at)
    let colon = rt_find_byte(layout, 58, at)
    if not rt_equal(peek(a + i * 8), peek(b + i * 8), rt_sub(layout, colon + 1, end)) { return false }
    at = end + 1
    i += 1
  }
  return true
}

# pow(x, y) for a whole-number y, by squaring. ponytail: a fractional y needs exp and log; it stops for now.
fn rt_pow(x: float, y: float) -> float {
  if not (floor(y) == y) or y > 1024.0 or y < -1024.0 { rt_fail("pow() with a fractional exponent is not in plankc yet") }
  var n = int(y)
  var neg = n < 0
  if neg { n = 0 - n }
  var r = 1.0
  var b = x
  while n > 0 {
    if n % 2 == 1 { r = r * b }
    b = b * b
    n = n / 2
  }
  if neg { return 1.0 / r }
  return r
}

# upper (up) or lower case, ASCII letters only, as Plank's.
fn rt_case(s: str, up: bool) -> str {
  let p = rt_str(len(s))
  for i in 0..len(s) {
    var c = peek8(addr(s) + i)
    if up and c >= 97 and c <= 122 { c -= 32 }
    if not up and c >= 65 and c <= 90 { c += 32 }
    poke8(p + i, c)
  }
  return as_str(p)
}

# Every a in s, left to right and not overlapping, as b.
fn rt_replace(s: str, a: str, b: str) -> str {
  if len(a) == 0 { return s }
  return rt_join(rt_split(s, a), b)
}

# Where the first item equal to v (part by part) is, or -1.
fn rt_list_index(l: int, v: int, ty: str) -> int {
  for i in 0..peek(l) {
    if rt_equal(peek(peek(l + 16) + i * 8), v, ty) { return i }
  }
  return -1
}

# The items added left to right from zero, as plank.py adds them.
fn rt_list_sum_int(l: int) -> int {
  var n = 0
  for i in 0..peek(l) { n += peek(peek(l + 16) + i * 8) }
  return n
}

fn rt_list_sum_float(l: int) -> float {
  var f = 0.0
  for i in 0..peek(l) { f = f + as_float(peek(peek(l + 16) + i * 8)) }
  return f
}

fn rt_list_insert(l: int, at: int, v: int) {
  var i = at
  if i < 0 { i += peek(l) }
  if i < 0 or i > peek(l) { rt_fail("insert at \(at) in a list of \(peek(l))") }
  rt_list_push(l, 0)
  let items = peek(l + 16)
  var k = peek(l) - 1
  while k > i {
    poke(items + k * 8, peek(items + k * 8 - 8))
    k -= 1
  }
  poke(items + i * 8, v)
}

fn rt_list_take(l: int, at: int) -> int {
  var i = at
  if i < 0 { i += peek(l) }
  if i < 0 or i >= peek(l) { rt_fail("remove_at \(at) in a list of \(peek(l))") }
  let v = peek(peek(l + 16) + i * 8)
  rt_list_remove_at(l, i)
  return v
}

fn rt_list_reverse(l: int) {
  let items = peek(l + 16)
  var a = 0
  var b = peek(l) - 1
  while a < b {
    let t = peek(items + a * 8)
    poke(items + a * 8, peek(items + b * 8))
    poke(items + b * 8, t)
    a += 1
    b -= 1
  }
}
