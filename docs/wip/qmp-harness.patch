+"""Shared QMP harness for tools/checks/*.py headless pixel checks.
+
+Every check used to hand-roll its own copy of: boot QEMU with -display
+none, connect to QMP, wait for the desktop, move/click/drag/key/type
+helpers, a pmemsave-based framebuffer dump, and the dock's pixel geometry
+(icon size, gap, slot-0 x, icon row y). ~40 checks copy-pasted this, and
+the copies drifted: one check sent keys 0.35s apart (measured safe, see
+search-check.py) while another used a faster gap and dropped scancodes;
+two checks hardcoded dock/window coordinates that went stale when the
+dock or a window's layout changed; some checks used a fixed sleep where
+waiting for an on-screen condition was the real fix (apptop-check.py's
+Apps-folder open/close waits, needed on a slower CI runner).
+
+This module is that harness, factored out once, so a fix (a longer key
+gap, a geometry change, a smarter wait) lands in one place. It is a
+helper module, not a check itself: suite-coverage-check.py's ALLOW set
+excludes it, and dockslots-check.py's drift guard already special-cases
+it by name.
+
+Usage:
+
+    from jtqmp import Machine
+
+    with Machine(4501, "jt-mycheck", rtc="base=2026-08-15T12:00:00") as m:
+        m.move(*m.dock_centre("Calendar"))
+        m.click()
+        m.wait_until(lambda: m.dump() is not None, timeout=2)
+        img = m.dump()
+        img.save("/tmp/jt-mycheck.png")
+        print(m.px(img, 100, 100))
+    print(m.serial())
+
+Dock geometry (`Machine.dock_centre`, `Machine.DOCK`, `Machine.SLOT0_X`,
+etc.) is derived from `kernel/kernel.c`'s own `GUI_LABELS`/
+`GUI_DOCK_DEFAULT`, the same way `tools/qa_demo_drive.py` and
+`tools/checks/dockslots-check.py` do it, so it can never itself go stale
+independently of the kernel.
+"""
+import json
+import os
+import re
+import socket
+import subprocess
+import time
+
+try:
+    from PIL import Image
+except ImportError:  # pragma: no cover - PIL is a documented dependency
+    Image = None
+
+REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
+
+# Logical/physical framebuffer geometry: 960x540 logical GUI, scaled 2x to
+# a real 1920x1080 physical framebuffer (gui_run's window_open_scaled).
+LOGICAL_W, LOGICAL_H, SCALE = 960, 540, 2
+FB_ADDR, FB_W, FB_H = 0xfd000000, 1920, 1080
+
+# Default key gap: measured real minimum, see search-check.py and
+# apptop-check.py's own comments. Sending keys faster drops scancodes.
+DEFAULT_KEY_GAP = 0.35
+
+QCODE = {
+    " ": "spc", ".": "dot", "-": "minus", "/": "slash", ",": "comma",
+    "@": "shift-2", "]": "bracket_right", "+": "shift-equal",
+    "\n": "ret", "\b": "backspace",
+}
+
+
+def _dock_geometry():
+    """Dock order + pixel geometry, derived from kernel/kernel.c, the way
+    tools/qa_demo_drive.py and tools/checks/dockslots-check.py do it, so
+    this module can never itself hold a stale copy."""
+    k = open(os.path.join(REPO_ROOT, "kernel", "kernel.c")).read()
+    labels = re.findall(r'"([^"]+)"', re.search(r"GUI_LABELS\[GUI_APP_COUNT\] = \{(.*?)\};", k, re.S).group(1))
+    sym = {"GUI_APPS_FOLDER": labels.index("Apps"), "GUI_TRASH": labels.index("Trash")}
+    order = [labels[sym[t] if t in sym else int(t)]
+             for t in re.search(r"GUI_DOCK_DEFAULT\[GUI_ICON_COUNT\] = \{(.*?)\};", k).group(1).replace(" ", "").split(",")]
+    dock_icon, dock_gap, dock_pad = 37, 6, 10
+    slot0_x = (LOGICAL_W - (len(order) * dock_icon + (len(order) - 1) * dock_gap + 2 * dock_pad)) // 2 + dock_pad
+    return order, dock_icon, dock_gap, slot0_x
+
+
+class Machine:
+    """A single headless QEMU instance, driven over QMP.
+
+    Context-manager: `with Machine(port, name) as m:` boots kernel.elf,
+    waits for the QMP socket, sends qmp_capabilities, and waits for the
+    desktop to come up; on exit it asks QEMU to quit and, failing that,
+    kills the process by PID (never pkill: other checks may have their
+    own QEMU running concurrently).
+    """
+
+    DOCK, DOCK_ICON, DOCK_GAP, SLOT0_X = _dock_geometry()
+    DOCK_PITCH = DOCK_ICON + DOCK_GAP
+    ICON_ROW_Y = 487
+
+    def __init__(self, port, name, extra_args=None, rtc=None, kernel="kernel.elf",
+                 log=None, boot_wait=5.0):
+        self.port = port
+        self.name = name
+        self.kernel = kernel
+        self.log = log or f"/tmp/jt-{name}-serial.log"
+        self.dump_path = f"/tmp/jt-{name}.raw"
+        self.boot_wait = boot_wait
+        self._proc = None
+        self._sock = None
+        self._f = None
+        args = ["qemu-system-i386", "-kernel", self.kernel, "-display", "none", "-vga", "std",
+                "-name", self.name, "-qmp", f"tcp:127.0.0.1:{self.port},server,nowait",
+                "-serial", "file:" + self.log]
+        if rtc:
+            args += ["-rtc", rtc]
+        if extra_args:
+            args += list(extra_args)
+        self._args = args
+
+    # -- lifecycle ---------------------------------------------------
+    def __enter__(self):
+        os.chdir(REPO_ROOT)
+        for p in (self.log, self.dump_path):
+            try:
+                os.remove(p)
+            except FileNotFoundError:
+                pass
+        self._proc = subprocess.Popen(self._args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        s = None
+        for _ in range(50):
+            time.sleep(0.2)
+            try:
+                s = socket.create_connection(("127.0.0.1", self.port))
+                break
+            except OSError:
+                pass
+        if s is None:
+            self._kill()
+            raise SystemExit("FAIL: QEMU's QMP socket never came up")
+        self._sock = s
+        self._f = s.makefile("rw")
+        self._f.readline()  # greeting
+        self._cmd({"execute": "qmp_capabilities"})
+        time.sleep(self.boot_wait)  # desktop up
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        try:
+            self._cmd({"execute": "quit"})
+        except (ConnectionResetError, BrokenPipeError, OSError, json.JSONDecodeError):
+            pass
+        self._kill()
+        return False
+
+    def _kill(self):
+        if self._proc is None:
+            return
+        try:
+            self._proc.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            self._proc.kill()  # by PID only, never pkill: another check's QEMU may be running
+
+    # -- QMP plumbing --------------------------------------------------
+    def _cmd(self, obj):
+        self._f.write(json.dumps(obj) + "\n")
+        self._f.flush()
+        while True:
+            r = json.loads(self._f.readline())
+            if "return" in r or "error" in r:
+                return r
+
+    # -- input -----------------------------------------------------
+    def move(self, x, y):
+        self._cmd({"execute": "input-send-event", "arguments": {"events": [
+            {"type": "abs", "data": {"axis": "x", "value": int(x * 32768 / LOGICAL_W)}},
+            {"type": "abs", "data": {"axis": "y", "value": int(y * 32768 / LOGICAL_H)}}]}})
+
+    def button(self, down):
+        self._cmd({"execute": "input-send-event", "arguments": {
+            "events": [{"type": "btn", "data": {"down": down, "button": "left"}}]}})
+
+    def click(self, settle=0.1):
+        self.button(True)
+        time.sleep(settle)
+        self.button(False)
+
+    def click_at(self, x, y, settle=1.2, move_settle=0.3):
+        self.move(x, y)
+        time.sleep(move_settle)
+        self.click()
+        time.sleep(settle)
+
+    def drag(self, sx, sy, tx, ty, steps=8, step_delay=0.05):
+        self.move(sx, sy)
+        time.sleep(0.2)
+        self.button(True)
+        time.sleep(0.1)
+        for i in range(1, steps + 1):
+            self.move(sx + (tx - sx) * i // steps, sy + (ty - sy) * i // steps)
+            time.sleep(step_delay)
+        time.sleep(0.1)
+        self.button(False)
+
+    def key(self, qcode, gap=DEFAULT_KEY_GAP):
+        self._cmd({"execute": "send-key", "arguments": {"keys": [{"type": "qcode", "data": qcode}]}})
+        time.sleep(gap)
+
+    def type(self, text, gap=DEFAULT_KEY_GAP):
+        for ch in text:
+            if ch.isupper():
+                self._cmd({"execute": "send-key", "arguments": {"keys": [
+                    {"type": "qcode", "data": "shift"}, {"type": "qcode", "data": ch.lower()}]}})
+                time.sleep(gap)
+            else:
+                self.key(QCODE.get(ch, ch), gap=gap)
+
+    # -- framebuffer -------------------------------------------------
+    def dump(self):
+        self._cmd({"execute": "pmemsave", "arguments": {"val": FB_ADDR, "size": FB_W * FB_H * 4, "filename": self.dump_path}})
+        return Image.frombytes("RGBA", (FB_W, FB_H), open(self.dump_path, "rb").read(), "raw", "BGRA").convert("RGB")
+
+    @staticmethod
+    def px(img, x, y):
+        """Physical pixel at a logical (x, y) coordinate."""
+        return img.getpixel((x * SCALE, y * SCALE))
+
+    # -- waiting -------------------------------------------------------
+    def wait_until(self, predicate, timeout=8, interval=0.5):
+        """Poll predicate() (no args) until it's true or timeout elapses.
+        Returns the last value of predicate(). Prefer this over a fixed
+        sleep for any on-screen condition (apptop-check.py's Apps-folder
+        open/close waits are the pattern this generalizes)."""
+        deadline = time.time() + timeout
+        result = predicate()
+        while not result and time.time() < deadline:
+            time.sleep(interval)
+            result = predicate()
+        return result
+
+    def serial(self):
+        if not os.path.exists(self.log):
+            return ""
+        return open(self.log, errors="replace").read()
+
+    # -- dock geometry -------------------------------------------------
+    @classmethod
+    def dock_centre(cls, name):
+        """Logical (x, y) of the dock icon labelled `name`, or raises
+        ValueError if it's not in the current dock order."""
+        slot = cls.DOCK.index(name)
+        return (cls.SLOT0_X + slot * cls.DOCK_PITCH + cls.DOCK_ICON // 2, cls.ICON_ROW_Y)
+
+    @classmethod
+    def dock_slot(cls, name):
+        return cls.DOCK.index(name)
