+    if (domv < 1 || domv > 31) domv = 1;
+    char daybuf[3]; int n = 0;
+    if (domv >= 10) daybuf[n++] = (char)('0' + domv / 10);
+    daybuf[n++] = (char)('0' + domv % 10);
